{ Training program for the AOT cache of a68j-backend.jar (backend/build.sh):
  compiled and run once with -XX:AOTCacheOutput, so that the classes of the
  compiler and of the runtime that typical programs use are loaded, linked
  and profiled in the cache.  The output is not checked. }
begin
    mode Point = struct (int x, int y);
    mode Shape = union (Point, real, string);
    mode Node = struct (int value, ref Node next);

    op + = (Point a, b) Point: (x of a + x of b, y of a + y of b);
    prio MAX = 9;
    op MAX = (int a, b) int: (a > b | a | b);

    proc show = (string s) void: puts (s + "'n");
    proc fib = (int n) int: (n < 2 | n | fib (n - 1) + fib (n - 2));
    proc describe = (Shape s) string:
        case s
        in (Point p): "point " + whole (x of p, 0) + "," + whole (y of p, 0),
           (real r): "real " + fixed (r, 0, 3),
           (string t): "string " + t
        esac;

    { Rows, slices and loops. }
    [1 : 100] int sieve;
    for i to UPB sieve do sieve[i] := i od;
    for i from 2 to UPB sieve do
        if sieve[i] /= 0 then
            for j from i + i by i to UPB sieve do sieve[j] := 0 od
        fi
    od;
    int count := 0;
    for i from 2 to UPB sieve do (sieve[i] /= 0 | count +:= 1) od;
    show ("primes: " + whole (count, 0));
    [] int d = (3, 1, 4, 1, 5, 9, 2, 6);
    [UPB d] int s := d;
    for i to UPB s - 1 do
        for j from i + 1 to UPB s do
            if s[j] < s[i] then int t = s[i]; s[i] := s[j]; s[j] := t fi
        od
    od;
    string line := "";
    for i to UPB s do line +:= whole (s[i], 0) + " " od;
    show (line + whole (s[2 : 4][1], 0));
    [3, 3] real m;
    for i to 3 do for j to 3 do m[i, j] := (i = j | 1.0 | 0.5) od od;
    show (fixed (m[2, 2] + m[1, 3], 0, 2) + " " + float (sqrt (2.0), 12, 6, 2));

    { Structures, unions, references. }
    Point p := (1, 2);
    p := p + Point (3, 4);
    show (describe (p) + "; " + describe (3.25) + "; " + describe ("abc"));
    ref Node list := nil;
    for i to 5 do list := heap Node := (i, list) od;
    int sum := 0;
    ref Node q := list;
    while ref Node (q) isnt nil do sum +:= value of q; q := next of q od;
    show ("sum " + whole (sum, 0) + " max " + whole (7 MAX 3, 0));

    { Integers, reals, bits, chars, strings. }
    long int big := LENG 1;
    for i to 20 do big *:= LENG i od;
    show (whole (big, 0) + " " + whole (fib (20), 0) + " " + whole (17 MOD 5, 0) + " " + whole (-17 OVER 5, 0));
    real x := 0.0;
    for i to 100 do x +:= sin (i) * cos (i) + exp (-i) + ln (i) od;
    show (fixed (x, 0, 4) + " " + whole (ENTIER x, 0) + " " + whole (ROUND x, 0));
    bits b := 16rff;
    show (whole (ABS (b SHL 4 AND 16rf0f), 0) + " " + (BIN 5 = 2r101 | "yes" | "no"));
    string w := "Hello, world";
    int vowels := 0;
    for i to UPB w do
        char c = w[i];
        if c = "a" OR c = "e" OR c = "i" OR c = "o" OR c = "u" then vowels +:= 1 fi
    od;
    show (w[1 : 5] + " " + whole (vowels, 0) + " " + REPR (ABS "A" + 1) + " " + whole (UPB w, 0));
    real r = random;
    show ((r >= 0.0 AND r < 1.0 | "random ok" | "random bad"))
end
