    pub op < = (int a, Bigint b) bool: j_int_compare (a, b) < 0;
    pub op < = (Bigint a, long int b) bool: j_compare_long_int (a, b) < 0;
    pub op < = (long int a, Bigint b) bool: j_long_int_compare (a, b) < 0;
    pub op < = (Bigint a, long long int b) bool: j_compare_long_long_int (a, b) < 0;
    pub op < = (long long int a, Bigint b) bool: j_long_long_int_compare (a, b) < 0;
    pub op <= = (Bigint a, b) bool: j_compare (a, b) <= 0;
    pub op <= = (Bigint a, int b) bool: j_compare_int (a, b) <= 0;
    pub op <= = (int a, Bigint b) bool: j_int_compare (a, b) <= 0;
    pub op <= = (Bigint a, long int b) bool: j_compare_long_int (a, b) <= 0;
    pub op <= = (long int a, Bigint b) bool: j_long_int_compare (a, b) <= 0;
