    pub op EQ = (Bigint a, b) bool: j_compare (a, b) = 0;
    pub op EQ = (Bigint a, int b) bool: j_compare_int (a, b) = 0;
    pub op EQ = (int a, Bigint b) bool: j_int_compare (a, b) = 0;
