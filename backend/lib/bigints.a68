    proc (Bigint, long int) Bigint j_mod_long_int = nest Java "a68j.jlib.BigInt.mod";
    proc (long int, Bigint) Bigint j_long_int_mod = nest Java "a68j.jlib.BigInt.mod";
    proc (Bigint, long long int) Bigint j_mod_long_long_int = nest Java "a68j.jlib.BigInt.mod";
    proc (long long int, Bigint) Bigint j_long_long_int_mod = nest Java "a68j.jlib.BigInt.mod";
    proc (Bigint, Bigint) int j_compare = nest Java "a68j.jlib.BigInt.compare";
    proc (Bigint, int) int j_compare_int = nest Java "a68j.jlib.BigInt.compare";
    proc (int, Bigint) int j_int_compare = nest Java "a68j.jlib.BigInt.compare";
    proc (Bigint, long int) int j_compare_long_int = nest Java "a68j.jlib.BigInt.compare";
    proc (long int, Bigint) int j_long_int_compare = nest Java "a68j.jlib.BigInt.compare";
    proc (Bigint, long long int) int j_compare_long_long_int = nest Java "a68j.jlib.BigInt.compare";
    proc (long long int, Bigint) int j_long_long_int_compare = nest Java "a68j.jlib.BigInt.compare";

    { Conversions and output. }

    pub op BIG = (int n) Bigint: j_of_int (n);
    pub op BIG = (long int n) Bigint: j_of_long_int (n);
    pub op BIG = (long long int n) Bigint: j_of_long_long_int (n);
    pub op BIG = (string s) Bigint: j_parse (s);
    pub op BIG = (char c) Bigint: j_parse (c);
    pub op TOINT = (Bigint a) int: j_to_int (a);
    pub op TOLONGINT = (Bigint a) long int: j_to_long_int (a);
    pub proc big_whole = (Bigint a, int width) string: j_whole (a, width);
    pub proc big_text = (Bigint a, int radix) string: j_text (a, radix);
    pub proc big_from_text = (string s, int radix) Bigint: j_parse_radix (s, radix);

    { Monadic operators. }

    pub op - = (Bigint a) Bigint: j_negate (a);
    pub op + = (Bigint a) Bigint: a;
    pub op ABS = (Bigint a) Bigint: j_abs (a);
    pub op SIGN = (Bigint a) int: j_sign (a);
    pub op ODD = (Bigint a) bool: j_odd (a);

    { Dyadic operators: two Bigints, or a Bigint and an int, long int or
      long long int on either side. }

    pub op + = (Bigint a, b) Bigint: j_add (a, b);
    pub op + = (Bigint a, int b) Bigint: j_add_int (a, b);
    pub op + = (int a, Bigint b) Bigint: j_int_add (a, b);
    pub op + = (Bigint a, long int b) Bigint: j_add_long_int (a, b);
    pub op + = (long int a, Bigint b) Bigint: j_long_int_add (a, b);
    pub op + = (Bigint a, long long int b) Bigint: j_add_long_long_int (a, b);
    pub op + = (long long int a, Bigint b) Bigint: j_long_long_int_add (a, b);
    pub op - = (Bigint a, b) Bigint: j_subtract (a, b);
    pub op - = (Bigint a, int b) Bigint: j_subtract_int (a, b);
    pub op - = (int a, Bigint b) Bigint: j_int_subtract (a, b);
    pub op - = (Bigint a, long int b) Bigint: j_subtract_long_int (a, b);
    pub op - = (long int a, Bigint b) Bigint: j_long_int_subtract (a, b);
    pub op - = (Bigint a, long long int b) Bigint: j_subtract_long_long_int (a, b);
    pub op - = (long long int a, Bigint b) Bigint: j_long_long_int_subtract (a, b);
    pub op * = (Bigint a, b) Bigint: j_multiply (a, b);
    pub op * = (Bigint a, int b) Bigint: j_multiply_int (a, b);
    pub op * = (int a, Bigint b) Bigint: j_int_multiply (a, b);
    pub op * = (Bigint a, long int b) Bigint: j_multiply_long_int (a, b);
    pub op * = (long int a, Bigint b) Bigint: j_long_int_multiply (a, b);
    pub op * = (Bigint a, long long int b) Bigint: j_multiply_long_long_int (a, b);
    pub op * = (long long int a, Bigint b) Bigint: j_long_long_int_multiply (a, b);
    pub op % = (Bigint a, b) Bigint: j_divide (a, b);
    pub op % = (Bigint a, int b) Bigint: j_divide_int (a, b);
    pub op % = (int a, Bigint b) Bigint: j_int_divide (a, b);
    pub op % = (Bigint a, long int b) Bigint: j_divide_long_int (a, b);
    pub op % = (long int a, Bigint b) Bigint: j_long_int_divide (a, b);
    pub op % = (Bigint a, long long int b) Bigint: j_divide_long_long_int (a, b);
    pub op % = (long long int a, Bigint b) Bigint: j_long_long_int_divide (a, b);
    pub op OVER = (Bigint a, b) Bigint: j_divide (a, b);
    pub op OVER = (Bigint a, int b) Bigint: j_divide_int (a, b);
    pub op OVER = (int a, Bigint b) Bigint: j_int_divide (a, b);
    pub op OVER = (Bigint a, long int b) Bigint: j_divide_long_int (a, b);
    pub op OVER = (long int a, Bigint b) Bigint: j_long_int_divide (a, b);
    pub op OVER = (Bigint a, long long int b) Bigint: j_divide_long_long_int (a, b);
    pub op OVER = (long long int a, Bigint b) Bigint: j_long_long_int_divide (a, b);
    pub op MOD = (Bigint a, b) Bigint: j_mod (a, b);
    pub op MOD = (Bigint a, int b) Bigint: j_mod_int (a, b);
    pub op MOD = (int a, Bigint b) Bigint: j_int_mod (a, b);
    pub op MOD = (Bigint a, long int b) Bigint: j_mod_long_int (a, b);
    pub op MOD = (long int a, Bigint b) Bigint: j_long_int_mod (a, b);
    pub op MOD = (Bigint a, long long int b) Bigint: j_mod_long_long_int (a, b);
    pub op MOD = (long long int a, Bigint b) Bigint: j_long_long_int_mod (a, b);
    pub op %* = (Bigint a, b) Bigint: j_mod (a, b);
    pub op %* = (Bigint a, int b) Bigint: j_mod_int (a, b);
    pub op %* = (int a, Bigint b) Bigint: j_int_mod (a, b);
    pub op %* = (Bigint a, long int b) Bigint: j_mod_long_int (a, b);
    pub op %* = (long int a, Bigint b) Bigint: j_long_int_mod (a, b);
    pub op %* = (Bigint a, long long int b) Bigint: j_mod_long_long_int (a, b);
    pub op %* = (long long int a, Bigint b) Bigint: j_long_long_int_mod (a, b);
    pub op ** = (Bigint a, int e) Bigint: j_pow (a, e);
    pub op UP = (Bigint a, int e) Bigint: j_pow (a, e);
    pub op ^ = (Bigint a, int e) Bigint: j_pow (a, e);

    { Comparisons. }

    pub op = = (Bigint a, b) bool: j_compare (a, b) = 0;
    pub op = = (Bigint a, int b) bool: j_compare_int (a, b) = 0;
    pub op = = (int a, Bigint b) bool: j_int_compare (a, b) = 0;
    pub op = = (Bigint a, long int b) bool: j_compare_long_int (a, b) = 0;
    pub op = = (long int a, Bigint b) bool: j_long_int_compare (a, b) = 0;
    pub op = = (Bigint a, long long int b) bool: j_compare_long_long_int (a, b) = 0;
    pub op = = (long long int a, Bigint b) bool: j_long_long_int_compare (a, b) = 0;
    pub op /= = (Bigint a, b) bool: j_compare (a, b) /= 0;
    pub op /= = (Bigint a, int b) bool: j_compare_int (a, b) /= 0;
    pub op /= = (int a, Bigint b) bool: j_int_compare (a, b) /= 0;
    pub op /= = (Bigint a, long int b) bool: j_compare_long_int (a, b) /= 0;
    pub op /= = (long int a, Bigint b) bool: j_long_int_compare (a, b) /= 0;
    pub op /= = (Bigint a, long long int b) bool: j_compare_long_long_int (a, b) /= 0;
    pub op /= = (long long int a, Bigint b) bool: j_long_long_int_compare (a, b) /= 0;
    pub op < = (Bigint a, b) bool: j_compare (a, b) < 0;
