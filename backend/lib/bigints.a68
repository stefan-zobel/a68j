    pub op GE = (Bigint a, long int b) bool: j_compare_long_int (a, b) >= 0;
    pub op GE = (long int a, Bigint b) bool: j_long_int_compare (a, b) >= 0;
    pub op GE = (Bigint a, long long int b) bool: j_compare_long_long_int (a, b) >= 0;
    pub op GE = (long long int a, Bigint b) bool: j_long_long_int_compare (a, b) >= 0;

    { Assigning operators: they yield the variable. }

    pub op +:= = (ref Bigint x, Bigint b) ref Bigint: x := j_add (x, b);
    pub op +:= = (ref Bigint x, int b) ref Bigint: x := j_add_int (x, b);
    pub op +:= = (ref Bigint x, long int b) ref Bigint: x := j_add_long_int (x, b);
