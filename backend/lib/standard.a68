    { 10.2.3.8.l L bitspack. }

    pub proc short_short_bits_pack = ([]bool a) short short bits:
       if int n = UPB a[@1];
          n <= short_short_bits_width
       then short short bits c := short short 16r0;
            for i to short_short_bits_width
            do if i > short_short_bits_width - n
                  andth a[@1][i - short_short_bits_width + n]
               then c := c OR (short short 2r1 SHL (short_short_bits_width - i)) fi
            od;
            c
       fi;
    pub proc short_bits_pack = ([]bool a) short bits:
       if int n = UPB a[@1];
          n <= short_bits_width
       then short bits c := short 16r0;
            for i to short_bits_width
            do if i > short_bits_width - n
                  andth a[@1][i - short_bits_width + n]
               then c := c OR (short 2r1 SHL (short_bits_width - i)) fi
            od;
            c
       fi;
    pub proc bits_pack = ([]bool a)  bits:
       if int n = UPB a[@1];
          n <= bits_width
       then  bits c :=  16r0;
            for i to bits_width
            do if i > bits_width - n
                  andth a[@1][i - bits_width + n]
               then c := c OR ( 2r1 SHL (bits_width - i)) fi
            od;
            c
       fi;
    pub proc long_bits_pack = ([]bool a) long bits:
       if int n = UPB a[@1];
          n <= long_bits_width
       then long bits c := long 16r0;
            for i to long_bits_width
            do if i > long_bits_width - n
                  andth a[@1][i - long_bits_width + n]
               then c := c OR (long 2r1 SHL (long_bits_width - i)) fi
            od;
            c
       fi;
    pub proc long_long_bits_pack = ([]bool a) long long bits:
       if int n = UPB a[@1];
          n <= long_long_bits_width
       then long long bits c := long long 16r0;
            for i to long_long_bits_width
            do if i > long_long_bits_width - n
                  andth a[@1][i - long_long_bits_width + n]
               then c := c OR (long long 2r1 SHL (long_long_bits_width - i)) fi
            od;
            c
       fi;

    { 10.3.2.1. Conversion routines. }

    mode Number = union (
                     short short int,
                     short int,
                      int,
                     long int,
                     long long int
                     ,
                      real,
                     long real,
                     long long real
                  );

    { The definition of mode Integer used by both the RR subwhole and this one.  }

    mode Integer = union (
                      long long int,
                      long int,
                      int,
                      short int,
                      short short int
                   );

    { The whole_powers_of_10 row is used to look up the appropriate power of 10 for
      each integer division required to select the leading in the conversion
      process, for each integer multiplication to eliminate the leading digit,
      and in the lookup operator WHOLEDIGITS to determine the number of digits in
      the integer to be converted.  }

    int whole_max_entry := 1;
    long long int whole_p10 := long long 1;
    long long int whole_stop_after = long_long_max_int % long long 10;
    while whole_p10 < whole_stop_after
    do
       whole_p10 *:= long long 10;
       whole_max_entry +:= 1
    od;
    heap [1:whole_max_entry]long long int whole_powers_of_10;
    while whole_max_entry > 0
    do
       whole_powers_of_10[whole_max_entry] := whole_p10;
       whole_p10 %:= long long 10;
       whole_max_entry -:= 1
    od;

    { The WHOLEDIGITS operator is used to determine the number of decimal digits in a
      number.  We convert the operand to long long and make it negative if
      necessary, to allow for twos-complement minimum (negative) integer.  }

    op WHOLEDIGITS = (Integer number) int:
    begin
          long long int work =
             case number in
                (long long int x):
                   (x > long long  0 | -x | x),
                (long int x):
                   LENG (x > long  0 | -x | x),
                (int x):
                   LENG LENG (x >  0 | -x | x),
                (short int x):
                   LENG LENG LENG (x > short  0 | -x | x),
                (short short int x):
                   LENG LENG LENG LENG (x > short short  0 | -x | x)
             esac;
          int num_digits := 1;
          for i from (LWB whole_powers_of_10) + 1 to UPB whole_powers_of_10
              while work <= -whole_powers_of_10[i]
          do num_digits +:= 1 od;
          num_digits
    end { WHOLEDIGITS };

    { proc whole checks for a too-small width, returning a string of the error
      character if so; it left-pads the result with blanks as necessary and the
      sign as necessary; and it relies on subwhole to do the actual digit
      conversion.  The [] result returned is either exactly the number of chars
      needed (width = 0) to hold the converted integer and negative sign if < 0
      or width characters (width ≠ 0).  }


    pub proc whole = (Number v, int width) string:
       case v in
          (long long int x):
             if int digits_required = WHOLEDIGITS x;
                bool negative = x < long long 0;
                int signs_required = (negative OR width > 0 | 1 | 0);
                int chars_required = signs_required + digits_required;
                int chars_available = (width = 0 | chars_required | ABS width);
                chars_available < chars_required
             then chars_available * "*"
             else [1:chars_available]char buffer;
                  int spaces_required = chars_available - chars_required;
                  int buf_ch := 1;
                  while buf_ch <= spaces_required
                  do buffer[buf_ch] := " ";
                     buf_ch +:= 1
                  od;
                  if signs_required > 0
                  then buffer[buf_ch] := (negative | "-" | "+");
                       buf_ch +:= 1
                  fi;
                  subwhole(x, buffer, buf_ch);
                  buffer
             fi,
          (long int x):
             if int digits_required = WHOLEDIGITS x;
                bool negative = x < long 0;
                int signs_required = (negative OR width > 0 | 1 | 0);
                int chars_required = signs_required + digits_required;
                int chars_available = (width = 0 | chars_required | ABS width);
                chars_available < chars_required
             then chars_available * "*"
             else [1:chars_available]char buffer;
                  int spaces_required = chars_available - chars_required;
                  int buf_ch := 1;
                  while buf_ch <= spaces_required
                  do buffer[buf_ch] := " ";
                     buf_ch +:= 1
                  od;
                  if signs_required > 0
                  then buffer[buf_ch] := (negative | "-" | "+");
                       buf_ch +:= 1
                  fi;
                  subwhole(x, buffer, buf_ch);
                  buffer
             fi,
          (int x):
             if int digits_required = WHOLEDIGITS x;
                bool negative = x < 0;
                int signs_required = (negative OR width > 0 | 1 | 0);
                int chars_required = signs_required + digits_required;
                int chars_available = (width = 0 | chars_required | ABS width);
                chars_available < chars_required
             then chars_available * "*"
             else [1:chars_available]char buffer;
                  int spaces_required = chars_available - chars_required;
                  int buf_ch := 1;
                  while buf_ch <= spaces_required
                  do buffer[buf_ch] := " ";
                     buf_ch +:= 1
                  od;
                  if signs_required > 0
                  then buffer[buf_ch] := (negative | "-" | "+");
                       buf_ch +:= 1
                  fi;
                  subwhole(x, buffer, buf_ch);
                  buffer
             fi,
          (short int x):
             if int digits_required = WHOLEDIGITS x;
                bool negative = x < short 0;
                int signs_required = (negative OR width > 0 | 1 | 0);
                int chars_required = signs_required + digits_required;
                int chars_available = (width = 0 | chars_required | ABS width);
                chars_available < chars_required
             then chars_available * "*"
             else [1:chars_available]char buffer;
                  int spaces_required = chars_available - chars_required;
                  int buf_ch := 1;
                  while buf_ch <= spaces_required
                  do buffer[buf_ch] := " ";
                     buf_ch +:= 1
                  od;
                  if signs_required > 0
                  then buffer[buf_ch] := (negative | "-" | "+");
                       buf_ch +:= 1
                  fi;
                  subwhole(x, buffer, buf_ch);
                  buffer
             fi,
          (short short int x):
             if int digits_required = WHOLEDIGITS x;
                bool negative = x < short short 0;
                int signs_required = (negative OR width > 0 | 1 | 0);
                int chars_required = signs_required + digits_required;
                int chars_available = (width = 0 | chars_required | ABS width);
                chars_available < chars_required
             then chars_available * "*"
             else [1:chars_available]char buffer;
                  int spaces_required = chars_available - chars_required;
                  int buf_ch := 1;
                  while buf_ch <= spaces_required
                  do buffer[buf_ch] := " ";
                     buf_ch +:= 1
                  od;
                  if signs_required > 0
                  then buffer[buf_ch] := (negative | "-" | "+");
                       buf_ch +:= 1
                  fi;
                  subwhole(x, buffer, buf_ch);
                  buffer
             fi
       out
          fixed(v, width, 0)
       esac { whole };


    { a68j: fixed yields errorchars for an infinite value or a NaN, and
      with width 0 it compares with a real power of ten (10.0 ** length):
      in libga68 the integer power overflows, and the loop does not end
      for large values (docs/ga68-bug-reports.md, entry 3).

      a68j: fixed converts a real as a long real, which it represents
      exactly: in real arithmetic, the rounding term and the scaling by a
      power of ten are inexact, and libga68 gives wrong digits from about
      the seventh one on (entry 4).  }
    pub proc fixed = (Number v, int width, after) string:
       case v in
          ( real x): fixed (LENG x, width, after),
          ( int x): fixed ( real (x), width, after),
          (long real x):
             if int length := ABS width - (x < long 0 OR width > 0 | 1 | 0);
                after >= 0 AND (length > after OR width = 0) AND ABS x <= long_max_real
             then long real y = ABS x;
                  if width = 0
                  then length := (after = 0 | 1 | 0);
                       while y + long .5 * long .1 ** after >= long 10.0 ** length
                       do length +:= 1 od;
                       length +:= (after = 0 | 0 | after + 1)
                  fi;
                  string s := subfixed (y, length, after);
                  if ~char_in_string (errorchar, loc int, s)
                  then (length > UPB s AND y < long 1.0 | "0" +=: s);
                       (x < long 0 | "-" |: width > 0 | "+" | "") +=: s;
                       (width /= 0 | (ABS width - UPB s) * " " +=: s);
                       s
                  elif after > 0
                  then fixed (v, width, after - 1)
                  else ABS width * errorchar
                  fi
             else { XXX undefined } skip; ABS width * errorchar
             fi,
          (long int x): fixed (long real (x), width, after),
          (long long real x):
             if int length := ABS width - (x < long long 0 OR width > 0 | 1 | 0);
                after >= 0 AND (length > after OR width = 0) AND ABS x <= long_long_max_real
             then long long real y = ABS x;
                  if width = 0
                  then length := (after = 0 | 1 | 0);
                       while y + long long .5 * long long .1 ** after >= long long 10.0 ** length
                       do length +:= 1 od;
                       length +:= (after = 0 | 0 | after + 1)
                  fi;
                  string s := subfixed (y, length, after);
                  if ~char_in_string (errorchar, loc int, s)
                  then (length > UPB s AND y < long long 1.0 | "0" +=: s);
                       (x < long long 0 | "-" |: width > 0 | "+" | "") +=: s;
                       (width /= 0 | (ABS width - UPB s) * " " +=: s);
                       s
                  elif after > 0
                  then fixed (v, width, after - 1)
                  else ABS width * errorchar
                  fi
             else { XXX undefined } skip; ABS width * errorchar
             fi,
          (long long int x): fixed (long long real (x), width, after)
       esac;

    { a68j: float yields errorchars for an infinite value or a NaN, for
      which standardize does not end in libga68 (docs/ga68-bug-reports.md,
      entry 3).

      a68j: float converts a real as a long real, as fixed does (entry 4).  }
    pub proc float = (Number v, int width, after, exp) string:
        case v in
           ( real x): float (LENG x, width, after, exp),
           (long real x):
              if int before = ABS width - ABS exp - (after /= 0 | after+1 | 0) - 2;
                 SIGN before + SIGN after > 0 AND ABS x <= long_max_real
              then string s, long real y := ABS x, int p := 0;
                   long_standardize (y, before, after, p);
                   s := fixed (LENG SIGN x * y, SIGN width * (ABS width - ABS exp - 1),
                               after) + "e" + whole (p, exp);
                   if exp = 0 OR char_in_string (errorchar, loc int, s)
                   then float (x, width, (after /= 0 | after-1 | 0),
                               (exp > 0 | exp+1 | exp-1))
                   else s
                   fi
              else { XXX undefined } skip; ABS width * errorchar
              fi,
           (long long real x):
              if int before = ABS width - ABS exp - (after /= 0 | after+1 | 0) - 2;
                 SIGN before + SIGN after > 0 AND ABS x <= long_long_max_real
              then string s, long long real y := ABS x, int p := 0;
                   long_long_standardize (y, before, after, p);
                   s := fixed (LENG LENG SIGN x * y, SIGN width * (ABS width - ABS exp - 1),
                               after) + "e" + whole (p, exp);
                   if exp = 0 OR char_in_string (errorchar, loc int, s)
                   then float (x, width, (after /= 0 | after-1 | 0),
                               (exp > 0 | exp+1 | exp-1))
                   else s
                   fi
              else { XXX undefined } skip; ABS width * errorchar
              fi
           ,
           (short short int x): float (short short real (LENG LENG x), width, after, exp),
           (short int x): float (short real (LENG x), width, after, exp),
           ( int x): float ( real ( x), width, after, exp),
           (long int x): float (long real ( x), width, after, exp),
           (long long int x): float (long long real ( x), width, after, exp)
        esac;

    { The RR proc subwhole looks like

      proc ℵ₀ subwhole = (number v, int width) string: { implementation };

      We deviate from that design below.  This means that, should someone copy
      proc putf from the RR, they must recognize that the subwhole mentioned
      there is no longer defined here, and make adjustments.

      I considered calling this subwhole something else (whole_do_conv for example)
      but that would mean anyone else calling subwhole hoping to get the new
      version would silently get the old subwhole instead.

      This subwhole converts digit by digit from left to right.  It relies on the
      caller having padded out the buffer with spaces and sign as required and
      begins filling digits starting at the value passed in buf_ch.  The final
      []char array and final value of buf_ch are returned.  }

    proc subwhole = (Integer v, ref []char buffer, ref int buf_ch) void:
       case int char_zero = ABS "0"; v in
          (long long int number_to_convert):
          begin long long int work := number_to_convert;
                while buf_ch <= UPB buffer
                do int digit_number = UPB buffer - buf_ch + 1;
                   long long int p10 = whole_powers_of_10[digit_number];
                   int digit = SHORTEN SHORTEN  (work % p10);
                   buffer[buf_ch] := REPR (ABS digit + char_zero);
                   buf_ch +:= 1;
                   work -:= LENG LENG digit * p10
                od
          end,
          (long int number_to_convert):
          begin long int work := number_to_convert;
                while buf_ch <= UPB buffer
                do int digit_number = UPB buffer - buf_ch + 1;
                   long int p10 = SHORTEN whole_powers_of_10[digit_number];
                   int digit = SHORTEN  (work % p10);
                   buffer[buf_ch] := REPR (ABS digit + char_zero);
                   buf_ch +:= 1;
                   work -:= LENG digit * p10
                od
          end,
          (int number_to_convert):
          begin int work := number_to_convert;
                while buf_ch <= UPB buffer
                do int digit_number = UPB buffer - buf_ch + 1;
                   int p10 = SHORTEN SHORTEN whole_powers_of_10[digit_number];
                   int digit =  (work % p10);
                   buffer[buf_ch] := REPR (ABS digit + char_zero);
                   buf_ch +:= 1;
                   work -:= digit * p10
                od
          end,
          (short int number_to_convert):
          begin short int work := number_to_convert;
                while buf_ch <= UPB buffer
                do int digit_number = UPB buffer - buf_ch + 1;
                   short int p10 = SHORTEN SHORTEN SHORTEN whole_powers_of_10[digit_number];
                   int digit = LENG  (work % p10);
                   buffer[buf_ch] := REPR (ABS digit + char_zero);
                   buf_ch +:= 1;
                   work -:= SHORTEN digit * p10
                od
          end,
          (short short int number_to_convert):
          begin short short int work := number_to_convert;
                while buf_ch <= UPB buffer
                do int digit_number = UPB buffer - buf_ch + 1;
                   short short int p10 = SHORTEN SHORTEN SHORTEN SHORTEN whole_powers_of_10[digit_number];
                   int digit = LENG LENG  (work % p10);
                   buffer[buf_ch] := REPR (ABS digit + char_zero);
                   buf_ch +:= 1;
                   work -:= SHORTEN SHORTEN digit * p10
                od
          end
       esac { subwhole };

    { Returns a string of maximum length `width' containing a rounded
      decimal representation of the positive real number `v'; if
      `after' is greater than zero, this string contains a decimal
      point followed by `after' digits. }

    proc subfixed = (Number v, int width, after) string:
       case v in
          ( real x):
             begin string s, int before := 0;
                    real y := x +  .5 *  .1 ** after;
                   proc choosedig = (ref  real y) char:
                      dig_char ((int c :=  ENTIER (y *:=  10.0); (c > 9 | c := 9);
                                 y -:=  c; c));
                   while y >=  10.0 ** before do before +:= 1 od;
                   y /:=  10.0 ** before;
                   to before do s +:= choosedig (y) od;
                   (after > 0 | s +:= ".");
                   to after do s +:= choosedig (y) od;
                   (UPB s > width | width * errorchar | s)
             end,
          (long real x):
             begin string s, int before := 0;
                   long real y := x + long .5 * long .1 ** after;
                   proc choosedig = (ref long real y) char:
                      dig_char ((int c := SHORTEN ENTIER (y *:= long 10.0); (c > 9 | c := 9);
                                 y -:= LENG c; c));
                   while y >= long 10.0 ** before do before +:= 1 od;
                   y /:= long 10.0 ** before;
                   to before do s +:= choosedig (y) od;
                   (after > 0 | s +:= ".");
                   to after do s +:= choosedig (y) od;
                   (UPB s > width | width * errorchar | s)
             end,
          (long long real x):
             begin string s, int before := 0;
                   long long real y := x + long long .5 * long long .1 ** after;
                   proc choosedig = (ref long long real y) char:
                      dig_char ((int c := SHORTEN SHORTEN ENTIER (y *:= long long 10.0); (c > 9 | c := 9);
                                 y -:= LENG LENG c; c));
                   while y >= long long 10.0 ** before do before +:= 1 od;
                   y /:= long long 10.0 ** before;
                   to before do s +:= choosedig (y) od;
                   (after > 0 | s +:= ".");
                   to after do s +:= choosedig (y) od;
                   (UPB s > width | width * errorchar | s)
             end
       esac;

    { Adjusts the value of `y' so that it may be transput according to
      the format $ n(before)d, n(after)d $; `p' is set so that y * 10
      ** p is equal to the original value of `y'.  }

    proc standardize = (ref  real y, int before, after, ref int p) void:
    begin
           real g =  10.0 ** before;  real h = g *  .1;
          while y >= g do y *:=  .1; p +:= 1 od;
          (y /=  0.0 | while y  < h do y *:=  10.0; p -:= 1 od);
          (y +  .5 *  .1 ** after >= g | y := h; p +:= 1)
    end;
    { a68j: long_standardize and long_long_standardize scale y with one
      division or multiplication by a power of ten, whose exponent q is
      estimated with the decimal logarithm and corrected by at most a few
      steps; libga68 multiplies by .1 or 10.0 once per decimal digit, up
      to some 300 times, and the rounding errors add up to wrong last
      digits (docs/ga68-bug-reports.md, entry 5).  A power of ten beyond
      10.0 ** 300 is applied in two parts, as it may overflow.  }
    proc long_standardize = (ref long real y, int before, after, ref int p) void:
    begin
          long real g = long 10.0 ** before; long real h = g * long .1;
          if y /= long 0.0
          then long real x = y;
               int q := SHORTEN ENTIER long_log (x) - before + 1;
               proc scale = void:
                  y := (q > 300 | x / long 10.0 ** 300 / long 10.0 ** (q - 300)
                       |: q >= 0 | x / long 10.0 ** q
                       |: q >= -300 | x * long 10.0 ** -q
                       | x * long 10.0 ** 300 * long 10.0 ** (-q - 300));
               scale;
               while y >= g do q +:= 1; scale od;
               while y < h do q -:= 1; scale od;
               p +:= q
          fi;
          (y + long .5 * long .1 ** after >= g | y := h; p +:= 1)
    end;
    proc long_long_standardize = (ref long long real y, int before, after, ref int p) void:
    begin
          long long real g = long long 10.0 ** before; long long real h = g * long long .1;
          if y /= long long 0.0
          then long long real x = y;
               int q := SHORTEN SHORTEN ENTIER long_long_log (x) - before + 1;
               proc scale = void:
                  y := (q > 300 | x / long long 10.0 ** 300 / long long 10.0 ** (q - 300)
                       |: q >= 0 | x / long long 10.0 ** q
                       |: q >= -300 | x * long long 10.0 ** -q
                       | x * long long 10.0 ** 300 * long long 10.0 ** (-q - 300));
               scale;
               while y >= g do q +:= 1; scale od;
               while y < h do q -:= 1; scale od;
               p +:= q
          fi;
          (y + long long .5 * long long .1 ** after >= g | y := h; p +:= 1)
    end;

    proc dig_char = (int x) char: "0123456789abcdef"[x+1];

    { Returns true if the absolute value of the result is
      <= L max int }

    proc string_to_short_short_int = (string s, int radix, ref short short int i) bool:
     begin
          short short int lr = SHORTEN SHORTEN radix; bool safe := true;
          short short int n := short short 0, short short int m = short_short_max_int % lr;
          short short int m1 = short_short_max_int - m * lr;
          for i from 2 to UPB s
          while short short int dig = SHORTEN SHORTEN char_dig (s[i]);
                safe := n < m OR n = m AND dig <= m1
          do n := n * lr + dig od;
          if safe then i := (s[1] = "+" | n | -n); true else false fi
    end;
    proc string_to_short_int = (string s, int radix, ref short int i) bool:
     begin
          short int lr = SHORTEN radix; bool safe := true;
          short int n := short 0, short int m = short_max_int % lr;
          short int m1 = short_max_int - m * lr;
          for i from 2 to UPB s
          while short int dig = SHORTEN char_dig (s[i]);
                safe := n < m OR n = m AND dig <= m1
          do n := n * lr + dig od;
          if safe then i := (s[1] = "+" | n | -n); true else false fi
    end;
    proc string_to_int = (string s, int radix, ref  int i) bool:
     begin
           int lr =  radix; bool safe := true;
           int n :=  0,  int m = max_int % lr;
           int m1 = max_int - m * lr;
          for i from 2 to UPB s
          while  int dig =  char_dig (s[i]);
                safe := n < m OR n = m AND dig <= m1
          do n := n * lr + dig od;
          if safe then i := (s[1] = "+" | n | -n); true else false fi
    end;
    proc string_to_long_int = (string s, int radix, ref long int i) bool:
     begin
          long int lr = LENG radix; bool safe := true;
          long int n := long 0, long int m = long_max_int % lr;
          long int m1 = long_max_int - m * lr;
          for i from 2 to UPB s
          while long int dig = LENG char_dig (s[i]);
                safe := n < m OR n = m AND dig <= m1
          do n := n * lr + dig od;
          if safe then i := (s[1] = "+" | n | -n); true else false fi
    end;
    proc string_to_long_long_int = (string s, int radix, ref long long int i) bool:
     begin
          long long int lr = LENG LENG radix; bool safe := true;
          long long int n := long long 0, long long int m = long_long_max_int % lr;
          long long int m1 = long_long_max_int - m * lr;
          for i from 2 to UPB s
          while long long int dig = LENG LENG char_dig (s[i]);
                safe := n < m OR n = m AND dig <= m1
          do n := n * lr + dig od;
          if safe then i := (s[1] = "+" | n | -n); true else false fi
    end;

    { a68j: string_to_real, string_to_long_real and string_to_long_long_real
      assign the exponent part to expart (":="); libga68 compares it
      ("=") and ignores it (docs/ga68-bug-reports.md, entry 2).  }

    { Returns true if the absolute value of the result is <= L max
      real.  }

    pub proc string_to_real = (string s, ref  real r) bool:
    begin
          int e := UPB s + 1;
          char_in_string ("^" { XXX unicode 10^ }, e, s);
          int p := e; char_in_string (".", p, s);
          int j := 1, length := 0,  real x :=  0.0;
          { Skip leading zeroes:  }
          for i from 2 to e - 1
          while s[i] = "0" OR s[i] = "." OR s[i] = "_."
          do j := i od;
          for i from j + 1 to e - 1 while length < real_width
          do
             if s[i] /= "."
             then x := x *  10.0 +  char_dig (s[j:=i]); length +:= 1
             fi { all significant digits converted.  }
          od;
          { Set preliminary exponent:  }
          int exp := (p > j | p - j - 1 | p - j), expart := 0;
          { Convert exponent part: }
          bool safe := if e < UPB s
                       then  int tmp :=  expart;
                            bool b = string_to_int (s[e+1:], 10, tmp);
                            expart :=  tmp;
                            b
                       else true
                       fi;
          { Prepare a representation of L max real to compare with the L
                real value to be delivered: }
           real max_stag := max_real, int max_exp := 0;
          standardize (max_stag, length, 0, max_exp); exp +:= expart;
          if ~safe OR (exp > max_exp OR exp = max_exp AND x > max_stag)
          then false
          else r := (s[1] = "+" | x | -x) *  10.0 ** exp; true
          fi
    end;
    pub proc string_to_long_real = (string s, ref long real r) bool:
    begin
          int e := UPB s + 1;
          char_in_string ("^" { XXX unicode 10^ }, e, s);
          int p := e; char_in_string (".", p, s);
          int j := 1, length := 0, long real x := long 0.0;
          { Skip leading zeroes:  }
          for i from 2 to e - 1
          while s[i] = "0" OR s[i] = "." OR s[i] = "_."
          do j := i od;
          for i from j + 1 to e - 1 while length < long_real_width
          do
             if s[i] /= "."
             then x := x * long 10.0 + LENG char_dig (s[j:=i]); length +:= 1
             fi { all significant digits converted.  }
          od;
          { Set preliminary exponent:  }
          int exp := (p > j | p - j - 1 | p - j), expart := 0;
          { Convert exponent part: }
          bool safe := if e < UPB s
                       then long int tmp := LENG expart;
                            bool b = string_to_long_int (s[e+1:], 10, tmp);
                            expart := SHORTEN tmp;
                            b
                       else true
                       fi;
          { Prepare a representation of L max real to compare with the L
                real value to be delivered: }
          long real max_stag := long_max_real, int max_exp := 0;
          long_standardize (max_stag, length, 0, max_exp); exp +:= expart;
          if ~safe OR (exp > max_exp OR exp = max_exp AND x > max_stag)
          then false
          else r := (s[1] = "+" | x | -x) * long 10.0 ** exp; true
          fi
    end;
    pub proc string_to_long_long_real = (string s, ref long long real r) bool:
    begin
          int e := UPB s + 1;
          char_in_string ("^" { XXX unicode 10^ }, e, s);
          int p := e; char_in_string (".", p, s);
          int j := 1, length := 0, long long real x := long long 0.0;
          { Skip leading zeroes:  }
          for i from 2 to e - 1
          while s[i] = "0" OR s[i] = "." OR s[i] = "_."
          do j := i od;
          for i from j + 1 to e - 1 while length < long_long_real_width
          do
             if s[i] /= "."
             then x := x * long long 10.0 + LENG LENG char_dig (s[j:=i]); length +:= 1
             fi { all significant digits converted.  }
          od;
          { Set preliminary exponent:  }
          int exp := (p > j | p - j - 1 | p - j), expart := 0;
          { Convert exponent part: }
          bool safe := if e < UPB s
                       then long long int tmp := LENG LENG expart;
                            bool b = string_to_long_long_int (s[e+1:], 10, tmp);
                            expart := SHORTEN SHORTEN tmp;
                            b
                       else true
                       fi;
          { Prepare a representation of L max real to compare with the L
                real value to be delivered: }
          long long real max_stag := long_long_max_real, int max_exp := 0;
          long_long_standardize (max_stag, length, 0, max_exp); exp +:= expart;
          if ~safe OR (exp > max_exp OR exp = max_exp AND x > max_stag)
          then false
          else r := (s[1] = "+" | x | -x) * long long 10.0 ** exp; true
          fi
    end;

    proc char_dig = (char x) int:
       (x = "." | 0 | int i; char_in_string (x,i,"0123456789abcdef"); i-1);

    pub proc char_in_string = (char c, ref int i, string s) bool:
    begin bool found := false;
          for k from LWB s to UPB s while ~found
          do (c = s[k] | i := k; found := true) od;
          found
    end;

    { The smallest integral value such that `L max int' may be
      converted without error using the pattern n(L int width)d }

    pub int short_short_int_width =
       (int c := 1; while short short 10 ** (c - 1) < short_short_max_int % short short 10 do c +:= 1 od;
        c);
    pub int short_int_width =
       (int c := 1; while short 10 ** (c - 1) < short_max_int % short 10 do c +:= 1 od;
        c);
    pub int int_width =
       (int c := 1; while  10 ** (c - 1) < max_int %  10 do c +:= 1 od;
        c);
    pub int long_int_width =
       (int c := 1; while long 10 ** (c - 1) < long_max_int % long 10 do c +:= 1 od;
        c);
    pub int long_long_int_width =
       (int c := 1; while long long 10 ** (c - 1) < long_long_max_int % long long 10 do c +:= 1 od;
        c);

    { The smallest integral value such that different string are
      produced by conversion of `1.0' and of `1.0 + L small real'
      using the pattern d .n(L real width - 1)d  }

    pub int real_width = 1 -  ENTIER (ln (small_real) / ln ( 10));
    pub int long_real_width = 1 - SHORTEN ENTIER (long_ln (long_small_real) / long_ln (long 10));
    pub int long_long_real_width = 1 - SHORTEN SHORTEN ENTIER (long_long_ln (long_long_small_real) / long_long_ln (long long 10));

    { The smallest integral value such that `L max real' may be
      converted without error using the pattern
      d .n(L real width - 1)d e n(L exp with)d }

    pub int exp_width =
       1 +  ENTIER (ln (ln (max_real) / ln ( 10)) / ln ( 10));
    pub int long_exp_width =
       1 + SHORTEN ENTIER (long_ln (long_ln (long_max_real) / long_ln (long 10)) / long_ln (long 10));
    pub int long_long_exp_width =
       1 + SHORTEN SHORTEN ENTIER (long_long_ln (long_long_ln (long_long_max_real) / long_long_ln (long long 10)) / long_long_ln (long long 10));

    skip
fed
