    { 10.2.3.7 Operations on complex operands }

    pub op = = ( compl a,b) bool: (re'a = re'b AND im'a = im'b);
    pub op EQ = ( compl a,b) bool: a = b;

    pub op /= = ( compl a,b) bool: NOT (a = b);
    pub op NE = ( compl a,b) bool: a /= b;

    pub op + = ( compl a,b)  compl: (re'a + re'b, im'a + im'b);
    pub op +:= = (ref  compl a,  compl b) ref  compl:
       (a := a + b; a);
    pub op PLUSAB = (ref  compl a,  compl b) ref  compl:
       a +:= b;

    pub op - = ( compl a)  compl: (-re'a, -im'a);
    pub op - = ( compl a,b)  compl: (re'a - re'b, im'a - im'b);
    pub op -:= = (ref  compl a,  compl b) ref  compl:
       (a := a - b; a);
    pub op MINUSAB = (ref  compl a,  compl b) ref  compl:
       a -:= b;

    pub op * = ( compl a,b)  compl:
       (re'a * re'b - im'a * im'b, re'a * im'b + im'a * re'b);
    pub op *:= = (ref  compl a,  compl b) ref  compl:
       (a := a * b; a);
    pub op TIMESAB = (ref  compl a,  compl b) ref  compl:
       a *:= b;

    pub op / = ( compl a,b)  compl:
    begin
           real d = re'(b * CONJ b);
           compl n = a * CONJ b;
          (re'n/d, im'n/d)
    end;

    pub op /:= = (ref  compl a,  compl b) ref  compl:
       (a := a / b; a);
    pub op DIVAB = (ref  compl a,  compl b) ref  compl:
       a /:= b;

    pub op CONJ = ( compl z)  compl: (re'z, -im'z);
    pub op ABS  = ( compl z)  real: sqrt(re'z*re'z + im'z*im'z);

    pub op ARG = ( compl z)  real:
       if  real zr = re'z, zi = im'z;
          zr /=  0 OR zi /=  0
       then if ABS zr > ABS zi
            then arctan(zi/zr)
                 + pi/ 2*(zi< 0 |  SIGN zr -  1 |  1 -  SIGN zr)
            else -arctan(zr/zi) + pi/ 2* SIGN zi
            fi
       fi;
    pub op = = (long compl a,b) bool: (re'a = re'b AND im'a = im'b);
    pub op EQ = (long compl a,b) bool: a = b;

    pub op /= = (long compl a,b) bool: NOT (a = b);
    pub op NE = (long compl a,b) bool: a /= b;

    pub op + = (long compl a,b) long compl: (re'a + re'b, im'a + im'b);
