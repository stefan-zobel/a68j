access Genie_Transput
begin
   { Checks of the answers to the exercises of Chapter 3. }
   { Exercise 1 }
   print (((int a = 3; a * a + 1), (2 > 1 | 10 | 20) + 1, newline));
   { Exercise 2 }
   int x = 1;
   begin int y = x + 1; begin int x = y * 10; print (x) end; print (x) end;
   print (newline);
   { Exercise 3 }
   int na := 0, nb := 0, nc := 0, nd := 0;
   for i from 5 to 1 do na +:= 1 od;
   for i from 1 by 2 to 10 do nb +:= 1 od;
   for i from 10 by -2 to 1 do nc +:= 1 od;
   to 0 do nd +:= 1 od;
   print ((na, nb, nc, nd, newline));
   { Exercise 4 }
   for v from -1 to 1 do
      print ((if v > 0 then "plus" elif v < 0 then "minus" else "zero" fi, " "))
   od;
   print (newline);
   { Exercise 7 }
   int p := 1;
   while p <= 1000 do print (whole (p, -5)); p *:= 2 od;
   print (newline);
   { Exercise 8 }
   int k := 3;
   to k do k *:= 2; print (k) od;
   print (newline);
   { Exercise 11 }
   real x11 := 1.5; int n11 := 2; bool b11 = x11 > n11;
   real v = (b11 | x11 | n11);
   print ((fixed (v, 0, 1), newline));
   { Exercise 13 }
   for n from 0 to 10 do print (n < 1 AND n > 9) od;
   print (newline);
   { Exercise 10 }
   for kk to 5 do
      string name = case kk in "one", "two", "three" out goto bad esac;
      print ((name, " "))
   od;
   stop;
bad:
   print (("bad", newline))
end
