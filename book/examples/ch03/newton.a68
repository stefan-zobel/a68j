access Genie_Transput
begin
{ begin excerpt }
   proc root = (real a) real:
   begin
      real x := (a > 1 | a | 1);
      while real better = (x + a / x) / 2;
            ABS (better - x) > 1e-6 * x
      do x := better od;
      x
   end;
   print ((fixed (root (2), 0, 5), " ", fixed (root (1e6), 0, 2), " ",
           fixed (root (0.25), -7, 5), newline))
{ end excerpt }
end
