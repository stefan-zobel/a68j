access Genie_Transput
begin
   int n = 7;
{ begin excerpt }
   if n MOD 2 = 0 then print (("even", newline)) else print (("odd", newline)) fi;
   string size = if n < 10 then "small" elif n < 100 then "medium" else "large" fi;
   print ((size, newline));
   print (((n > 0 | "positive" | "not positive"), newline))
{ end excerpt }
end
