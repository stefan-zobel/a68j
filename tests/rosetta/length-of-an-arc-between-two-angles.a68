{ dg-modules "rcprelude" }
{ Rosetta Code, task "Length of an arc between two angles", ALGOL 68 solution length-of-an-arc-between-two-angles.alg.
  https://rosettacode.org/wiki/Length_of_an_arc_between_two_angles#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/length-of-an-arc-between-two-angles.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    { returns the length of the arc between the angles a and b on a circle of radius r }
    { the angles should  be specified in degrees                                       }
    proc major_arc_length = ( real a, b, r )real:
         begin
            real angle := ABS ( a - b );
            while angle > 360 do angle -:= 360 od;
            if angle < 180 then angle := 360 - angle fi;
            ( r * angle * pi ) / 180
         end { majorArcLength } ;
    { task test case                                                                   }
    print( ( fixed( major_arc_length( 10, 120, 10 ), -10, 4 ), newline ) )
end
)
