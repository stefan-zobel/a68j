{ dg-modules "genietransput" }
{ Rosetta Code, task "Multifactorial", ALGOL 68 solution multifactorial.alg.
  https://rosettacode.org/wiki/Multifactorial#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/multifactorial.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
   int highest_degree = 5;
   int largest_number = 10;
{ Recursive implementation of multifactorial function }
   proc multi_fact = (int n, deg) int :
   (n <= deg | n | n * multi_fact(n - deg, deg));
{ Iterative implementation of multifactorial function }
   proc multi_fact_i = (int n, deg) int :
   begin
      int result := n, nn := n;
      while (nn >= deg + 1) do
	 result TIMESAB nn - deg;
	 nn MINUSAB deg
      od;
      result
   end;
{ Print out multifactorials }
   for i to highest_degree do
      printf (($l, "Degree ", g(0), ":"$, i));
      for j to largest_number do
	 printf (($xg(0)$, multi_fact (j, i)))
      od
   od
end
)
