{ dg-modules "rcprelude" }
{ Rosetta Code, task "Naming conventions", ALGOL 68 solution naming-conventions-4.alg.
  https://rosettacode.org/wiki/Naming_conventions#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/naming-conventions-4.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
. 
mode Xint = int;
Xint sum_sq:=0;
for i while
  sum_sq/=70*70
do
  sum_sq+:=i**2
od
)
