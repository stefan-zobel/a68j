{ dg-modules "rcprelude" }
{ Rosetta Code, task "Josephus problem", ALGOL 68 solution josephus-problem.alg.
  https://rosettacode.org/wiki/Josephus_problem#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/josephus-problem.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
   proc josephus = (int n, k, m) int :
   { Return m-th on the reversed kill list; m=0 is final survivor. }
   begin
      int lm := m;			{ Local copy of m }
      for a from m+1 while a <= n do lm := (lm+k) %* a od;
      lm
   end;
   int n = 41, k=3;
   printf (($"n = ", g(0), ", k = ", g(0), ", final survivor: ", g(0)l$,
	    n, k, josephus (n, k, 0)))
end
)
