{ dg-modules "rcprelude" }
{ Rosetta Code, task "Numeric separator syntax", ALGOL 68 solution numeric-separator-syntax.alg.
  https://rosettacode.org/wiki/Numeric_separator_syntax#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/numeric-separator-syntax.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    int  a = 1 234 567;
    real b = 3      .    1 4159 26 5 359;
    print( ( whole( a, 0 ), "  ", fixed( b, - 14, 11 ), newline ) )
end
)
