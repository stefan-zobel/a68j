{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Bitwise operations", ALGOL 68 solution bitwise-operations-1.alg.
  https://rosettacode.org/wiki/Bitwise_operations#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/bitwise-operations-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
begin

  bits all_bits_mask = NOT 16r0;
  long bits long_bits_mask = LENG all_bits_mask;

  prio SLC = 8, SRC = 8; { SLC and SRC are not built in, define and overload them here }
  op SLC = (bits b, int rotate) bits: b SHL rotate OR b SHR ( bits_width - rotate );
  op SRC = (bits b, int rotate) bits: b SHR rotate OR SHORTEN (   long_bits_mask
                                                              AND ( LENG b SHL ( bits_width - rotate ) )
                                                              );
  { SRC and SRL are non-standard, but versions are built in to ALGOL 68R's standard prelude }

  prio XOR = 2;
  op XOR = (bits p, q) bits: p AND NOT q OR NOT p AND q;
  { XOR is non-standard, but a version is built in to ALGOL 68G's standard prelude }

  { ALGOL 68 has 5 different ways of representing a BINary BITS - Bases: 2, 4, 8, 16 and flip/flop }
  Gformat b5 = if bits_width > 32
              then gfmt ("""2r""2r64d,"" 4r""4r32d,l""          8r""8r22d,"" 16r""16r16d,l""          ""gl")
              else gfmt ("""2r""2r32d,"" 4r""4r16d,"" 8r""8r11d,"" 16r""16r8d,l""          ""gl")
              fi;
  op BBBBB = (bits b)[]bits: (b,b,b,b,b);

  proc bitwise = (bits a, bits b, int shift)void:
  (
    printf((
      gfmt ("""         bits shorths: ""gxgl"), bits_shorths, "1 plus the number of extra SHORT BITS types",
      gfmt ("""         bits lengths: ""gxgl"), bits_lengths, "1 plus the number of extra LONG BITS types",
      gfmt ("""             max bits: ""gl"), max_bits,
      gfmt ("""        long max bits: ""gl"), long_max_bits,
      gfmt ("""   long long max bits: ""gl"), long_long_max_bits,
      gfmt ("""           bits width: ""gxgl"), bits_width, "The number of CHAR required to display BITS",
      gfmt ("""      long bits width: ""gxgl"), long_bits_width, "The number of CHAR required to display LONG BITS",
      gfmt (""" long long bits width: ""gxgl"), long_long_bits_width, "The number of CHAR required to display LONG LONG BITS",
      gfmt ("""         bytes shorths: ""gxgl"), bytes_shorths, "1 plus the number of extra SHORT BYTES types",
      gfmt ("""         bytes lengths: ""gxgl"), bits_lengths, "1 plus the number of extra LONG BYTES types",
      gfmt ("""          bytes width: ""gxgl"), bytes_width, "The number of CHAR required to display BYTES",
      gfmt ("""     long bytes width: ""gxgl"), long_bytes_width, "The number of CHAR required to display LONG BYTES"
    ));

    printf((gfmtd (""" a:       ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), BBBBB a));
    printf((gfmtd (""" b:       ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), BBBBB b));
    printf((gfmtd (""" a AND b: ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), BBBBB(a AND b)));
    printf((gfmtd (""" a OR b:  ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), BBBBB(a OR b)));
    printf((gfmtd (""" a XOR b: ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), BBBBB(a XOR b)));
    printf((gfmtd (""" NOT b:   ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), BBBBB NOT a));
    printf((gfmtd (""" a SHL ""d"": ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), shift, BBBBB(a SHL shift)));
    printf((gfmtd (""" a SHR ""d"": ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), shift, BBBBB(a SHR shift)));

    printf((gfmtd (""" a SLC ""d"": ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), shift, BBBBB(a SLC shift)));
    printf((gfmtd (""" a SRC ""d"": ""f(@1)", skip, (int gfindex) Gformat: case gfindex in b5 esac), shift, BBBBB(a SRC shift)))
{ with original ALGOL 68 character set;
    printf(($" a AND b: "f(b5)$, BBBBB(a ∧ b)));
    printf(($" a OR b:  "f(b5)$, BBBBB(a ∨ b)));
    printf(($" NOT b:   "f(b5)$, BBBBB ¬ a));
    printf(($" a SHL "d": "f(b5)$, shift, BBBBB(a ↑ shift)));
    printf(($" a SHR "d": "f(b5)$, shift, BBBBB(a ↓ shift)));
Also:
    printf(($" a AND b: "f(b5)$, BBBBB(a /\ b)));
    printf(($" a OR b: "f(b5)$, BBBBB(a \/ b)));
}
  );

  bitwise(BIN 255, BIN 170, 5)
{ or using alternate representations for 255 and 170 in BITS }
{
  bitwise(2r11111111,2r10101010,5);
  bitwise(4r3333,4r2222,5);
  bitwise(8r377,8r252,5);
  bitwise(16rff,16raa,5)
END }
end
)
