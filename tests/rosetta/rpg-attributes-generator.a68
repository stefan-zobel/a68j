{ dg-modules "genietransput" }
{ Rosetta Code, task "RPG attributes generator", ALGOL 68 solution rpg-attributes-generator.alg.
  https://rosettacode.org/wiki/RPG_attributes_generator#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/rpg-attributes-generator.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { RPG attributes generator }

    int attrib_count = 6;
    mode Result = struct( bool success, int sum, high_count, [ 1 : attrib_count ]int a );

    proc generate_attrib = int:
    begin
        int min := 255, sum := 0;
        from 0 to 3 do
            int v = ENTIER( next_random * 6 ) + 1;
            if v < min then
                min := v
            fi;
            sum +:= v
        od;
        sum - min
    end { generate attrib };

    proc generate = ( ref Result res )void:
    begin
        high_count of res := 0;
        sum of res        := 0;
        for i from LWB a of res to UPB a of res do
            int v = generate_attrib;
            if v >= 15 then
               high_count of res +:= 1
            fi;
            sum of res +:= v;
            ( a of res )[ i ] := v
        od;
        success of res := ( high_count of res >= 2 AND sum of res >= 75 )
    end { generate } ;

    begin
        Result res;
        success of res := false;
        while NOT success of res do
            generate( res );
            print( ( "attribs: " ) );
            for i from LWB a of res to UPB a of res do
                print( ( whole( ( a of res )[ i ], 0 ) ) );
                if i < UPB a of res then
                    print( ( " " ) )
                fi
            od;
            print( ( " sum=", whole( sum of res, 0 )
                   , " highCount=", whole( high_count of res, 0 )
                   , " ", if success of res then "success" else "failed" fi
                   , newline
                   )
                 )
        od
    end
end
)
