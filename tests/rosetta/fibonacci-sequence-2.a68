{ dg-modules "rcprelude" }
{ Rosetta Code, task "Fibonacci sequence", ALGOL 68 solution fibonacci-sequence-2.alg.
  https://rosettacode.org/wiki/Fibonacci_sequence#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/fibonacci-sequence-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
proc iterative_fibonacci = (int n)int:
  case n+1 in
    0, 1, 1, 2, 3, 5
  out
    int even:=3, odd:=5;
    for i from odd+1 to n do
      (ODD i|odd|even) := odd + even
    od;
    (ODD n|odd|even)
  esac;

for i from 0 to 30 while
  print(whole(iterative_fibonacci(i),0));
{ WHILE } i /= 30 do
  print(", ")
od;
print(new_line)
)
