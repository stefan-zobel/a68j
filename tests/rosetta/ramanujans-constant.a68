{ dg-modules "genietransput" }
{ Rosetta Code, task "Ramanujan's constant", ALGOL 68 solution ramanujans-constant.alg.
  https://rosettacode.org/wiki/Ramanujan's_constant#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/ramanujans-constant.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { Ramanujan's constant }

     

    proc ramanujan = ( int n )long long real:
         long_long_exp( long_long_pi * long_long_sqrt( n ) );

    print( ( "Ramanujan''s constant to 32 decimal places is: " ) );
    print( ( fixed( ramanujan( 163 ), -52, 32 ), newline, newline ) );

    []int heegner = ( 19, 43, 67, 163 );
    print( ( "Heegner numbers yielding almost integers:", newline ) );
    for hpos from LWB heegner to UPB heegner do
        int h = heegner[ hpos ];
        long long real r  = ramanujan( h );
        long long int rc := ENTIER r;
        if rc /= r then rc +:= 1 fi;
        long long real diff = rc - r;
        print( ( whole( h, -3 ), ":", fixed ( r, -52, 32 ) ) );
        print( ( " ~ ", whole( rc, -20 ), newline ) );
        print( ( "        diff:         ", fixed( diff, -34, 32 ), newline ) )
    od
end
)
