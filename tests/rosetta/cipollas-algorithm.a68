{ dg-modules "rcprelude" }
{ Rosetta Code, task "Cipolla's algorithm", ALGOL 68 solution cipollas-algorithm.alg.
  https://rosettacode.org/wiki/Cipolla's_algorithm#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/cipollas-algorithm.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { Cipolla's algorithm - translation of the EasyLang sample }
    mode Integer = long int;
    op   SQRT    = ( Integer x )long real: long_sqrt( x );
    proc mul_mod = ( Integer a, b_in, m )Integer:
         begin
            Integer b := b_in, x := 0, y := a MOD m;
            while b > 0 do
                if ODD b then x +:= y MODAB m fi;
                y *:= 2 MODAB m;
                b OVERAB 2
            od;
            x
         end { mul mod } ;
    proc pow_mod = ( Integer b_in, p_in, m )Integer:
         begin
            Integer b := b_in, x := 1, p := p_in;
            while p > 0 do
                if ODD p then x := mul_mod( x, b, m ) fi;
                b := mul_mod( b, b, m );
                p OVERAB 2
            od;
            x
         end { pow_mod } ;
    proc isprime = ( Integer num )bool:
         if   num <= 2 OR NOT ODD num
         then num = 2
         else Integer sqrt_num = ENTIER SQRT num;
              bool result := true;
              for i from 3 by 2 to SHORTEN sqrt_num while result := num MOD i /= 0 do skip od;
              result
         fi { isprime } ;
    proc legendre = ( Integer a, p )Integer:
         if   Integer x = pow_mod( a, ( ( p - 1 ) OVER 2 ), p );
              p - 1 = x
         then x - p
         else x
         fi { legendre } ;
    proc fp2mul = ( []Integer a, b, Integer p, w2 )[]Integer:
         begin
            [ 1 : 2 ]Integer ans;
            Integer tmp1 := mul_mod( a[ 1 ], b[ 1 ], p );
            Integer tmp2 := mul_mod( a[ 2 ], b[ 2 ], p );
            tmp2     := mul_mod( tmp2, w2, p );
            ans[ 1 ] := ( tmp1 + tmp2 ) MOD p;
            tmp1     := mul_mod( a[ 1 ], b[ 2 ], p );
            tmp2     := mul_mod( a[ 2 ], b[ 1 ], p );
            ans[ 2 ] := ( tmp1 + tmp2 ) MOD p;
            ans
         end { fp2mul } ;
    proc fp2square = ( []Integer a, Integer p, w2 )[]Integer: fp2mul( a, a, p, w2 );
    proc fp2pow = ( []Integer a, Integer n, p, w2 )[]Integer:
         if   n = 0     then ( 1, 0 )
         elif n = 1     then a
         elif NOT ODD n then fp2square( fp2pow( a, ( n OVER 2 ), p, w2 ), p, w2 )
         else                fp2mul( a, fp2pow( a, ( n - 1 ), p, w2 ), p, w2 )
         fi { fp2pow } ;
    proc test = ( Integer n, p )void:
         if   print( ( "n = ", whole( n, -12 ), " p = ", whole( p, -12 ), " ->" ) );
              p = 2 OR NOT isprime( p ) OR legendre( n, p ) /= 1
         then print( ( " no solution", newline ) )
         else while bool    finished := false;
                    Integer a  := 0, w2 := 0;
                    while   a  := ENTIER ( random * ( p - 2 ) ) + 1;
                          w2 := a * a - n;
                          legendre( w2, p ) /= -1
                    do skip od;
                    []Integer ans = fp2pow( ( a, 1 ), ( ( p + 1 ) OVER 2 ), p, w2 );
                    if ans[ 2 ] = 0
                    then Integer x1 = ans[ 1 ];
                         Integer x2 = p - x1;
                         if mul_mod( x1, x1, p ) = n AND mul_mod( x2, x2, p ) = n
                         then print( ( " x1 = ", whole( x1, -12 ), " x2 = ", whole( x2, -12 ) ) );
                              finished := true
                         fi
                    fi;
                    NOT finished
              do skip od;
              print( ( newline ) )
         fi { test } ;
    test(        10,         13 );
    test(        56,        101 );
    test(      8218,      10007 );
    test(      8219,      10007 );
    test(    331575,    1000003 );
    test( 665165880, 1000000007 )
end
)
