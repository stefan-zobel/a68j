{ dg-modules "rcprelude" }
{ Rosetta Code, task "Show the (decimal) value of a number of 1s appended with a 3, then squared", ALGOL 68 solution show-the-decimal-value-of-a-number-of-1s-appended-with-a-3-then-squared-1.alg.
  https://rosettacode.org/wiki/Show_the_(decimal)_value_of_a_number_of_1s_appended_with_a_3,_then_squared#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/show-the-decimal-value-of-a-number-of-1s-appended-with-a-3-then-squared-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    long int n := 0;
    to 8 do
        long int n3 = ( n * 10 ) + 3;
        print( ( whole( n3, 0 ), " ", whole( n3 * n3, 0 ), newline ) );
        n *:= 10 +:= 1
    od
end
)
