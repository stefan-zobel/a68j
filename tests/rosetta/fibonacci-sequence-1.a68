{ dg-modules "genietransput" }
{ Rosetta Code, task "Fibonacci sequence", ALGOL 68 solution fibonacci-sequence-1.alg.
  https://rosettacode.org/wiki/Fibonacci_sequence#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/fibonacci-sequence-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
proc analytic_fibonacci = (long int n)long int:(
  long real sqrt_5 = long_sqrt(5);
  long real p = (1 + sqrt_5) / 2;
  long real q = 1/p;
  ROUND( (p**n + q**n) / sqrt_5 )
);

for i from 1 to 30 while
  print(whole(analytic_fibonacci(i),0));
{ WHILE } i /= 30 do
  print(", ")
od;
print(new_line)
)
