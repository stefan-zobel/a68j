{ dg-modules "rcprelude" }
{ Rosetta Code, task "Solve equations with substitution method", ALGOL 68 solution solve-equations-with-substitution-method.alg.
  https://rosettacode.org/wiki/Solve_equations_with_substitution_method#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/solve-equations-with-substitution-method.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { solve equations using the substitution method - translation of Phix  }

    proc solve2 = ( []real e1, e2 )[]real:
         begin
             real a1 = e1[ 1 ], b1 = e1[ 2 ], c1 = e1[ 3 ];
             real a2 = e2[ 1 ], b2 = e2[ 2 ], c2 = e2[ 3 ];
             real x  = (b2*c1 - b1*c2) / (b2*a1 - b1*a2);
             real y  = (a1*x - c1)/-b1;
             ( x, y )
         end { solve2 } ;

   op   FMT = ( real v )string:     { prints v with at most 3 decimal places }
         begin
            string result := fixed( ABS v, 0, 3 );
            if result[ LWB result ] = "." then "0" +=: result fi;
            while result[ UPB result ] = "0" do result := result[ : UPB result - 1 ] od;
            if result[ UPB result ] = "." then result := result[ : UPB result - 1 ] fi;
            if v < 0 then "-" else "" fi + result
         end { FMT } ;

    []real xy = solve2( ( 3, 1, -1 ), ( 2, -3, -19 ) );
    print( ( "x = ", FMT xy[ 1 ], ", y = ", FMT xy[ 2 ], newline ) )

end
)
