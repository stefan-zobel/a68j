  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
string final_state = (
  int condition;
  proc do_something = void: condition := 1 + ENTIER (3 * random);

  state1:
     do_something;
     case condition in
        state_1, state_2
     out
        state_n
     esac
  exit

  state_2:
     "State Two"
  exit

  state_n:
     "State N"
);
print(("Final state: ",final_state, new_line));
)
