{ dg-modules "rcprelude" }
{ Rosetta Code, task "Least common multiple", ALGOL 68 solution least-common-multiple.alg.
  https://rosettacode.org/wiki/Least_common_multiple#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/least-common-multiple.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
   proc gcd = (int m, n) int :
   begin
      int a := ABS m, b := ABS n;
      if a=0 OR b=0 then 0 else
	 while b /= 0 do int t = b; b := a MOD b; a := t od;
	 a
      fi
   end;
   proc lcm = (int m, n) int : ( m*n = 0 | 0 | ABS (m*n) % gcd (m, n));
   int m=12, n=18;
   printf (($gxg(0)3(xgxg(0))l$,
	    "The least common multiple of", m, "and", n, "is", lcm(m,n),
	    "and their greatest common divisor is", gcd(m,n)))
end
)
