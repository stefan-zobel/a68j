{ dg-modules "rcprelude" }
{ Rosetta Code, task "Two's complement", ALGOL 68 solution twos-complement.alg.
  https://rosettacode.org/wiki/Two's_complement#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/twos-complement.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    int a := 3;
    print( ( -a, " ", 1 + ABS NOT BIN a, newline ) )
end
)
