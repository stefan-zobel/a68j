{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Arithmetic/Integer", ALGOL 68 solution arithmetic-integer.alg.
  https://rosettacode.org/wiki/Arithmetic/Integer#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/arithmetic-integer.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
main:(
  long int a=355, b=113;
  printf((gfmt ("""a PLUS b = a+b = ""gl"), a + b));
  printf((gfmt ("""a MINUS b = a-b = ""gl"), a - b));
  printf((gfmt ("""a TIMES b = a*b = a×b = ""gl"), a * b));
  printf((gfmt ("""a DIV b = a/b = ""gl"), a / b));
  printf((gfmt ("""a OVER b = a%b = a÷b = ""gl"), a % b));
  printf((gfmt ("""a MOD b = a%*b = a%×b = a÷×b = a÷*b = ""gl"), a %* b));
  printf((gfmt ("""a UP b = a**b = a↑b = ""gl"), a ** b))
)
)
