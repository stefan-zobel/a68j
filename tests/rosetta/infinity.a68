{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Infinity", ALGOL 68 solution infinity.alg.
  https://rosettacode.org/wiki/Infinity#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/infinity.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
printf((gfmt ("""max int: ""gl"),max_int));
printf((gfmt ("""long max int: ""gl"),long_max_int));
printf((gfmt ("""long long max int: ""gl"),long_long_max_int));
printf((gfmt ("""max real: ""gl"),max_real));
printf((gfmt ("""long max real: ""gl"),long_max_real));
printf((gfmt ("""long long max real: ""gl"),long_long_max_real));
printf((gfmt ("""error char: ""gl"),error_char))
)
