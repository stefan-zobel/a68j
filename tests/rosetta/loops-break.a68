{ dg-modules "rcprelude" }
{ Rosetta Code, task "Loops/Break", ALGOL 68 solution loops-break.alg.
  https://rosettacode.org/wiki/Loops/Break#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/loops-break.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
{main}
(
    while
        int a = ENTIER (random * 20);
        print((a));
        a /= 10
    do
        print((ENTIER (random * 20), new_line))
    od;
    print(new_line)
)
)
