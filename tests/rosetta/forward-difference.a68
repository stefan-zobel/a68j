{ dg-modules "rcprelude" }
{ Rosetta Code, task "Forward difference", ALGOL 68 solution forward-difference.alg.
  https://rosettacode.org/wiki/Forward_difference#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/forward-difference.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
main:(
  mode Listreal = [1:0]real;

  op - = (Listreal a,b)Listreal: (
    [UPB a]real out_;
    for i to UPB out_ do out_[i]:=a[i]-b[i] od;
    out_
  );

  FORMAT real_fmt=$zzz-d.d$;
  FORMAT repeat_fmt = $n(UPB s-1)(f(real fmt)",")f(real fmt)$;
  FORMAT list_fmt = $"("f(UPB s=1|real fmt|repeat fmt)")"$;

  flex [1:0] real s := (90, 47, 58, 29, 22, 32, 55, 5, 55, 73);

  printf((list_fmt,s,$";"l$));
  to UPB s-1 do
    s := s[2:] - s[:UPB s-1];
    printf((list_fmt,s,$";"l$))
  od
)
)
