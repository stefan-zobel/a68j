{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Formatted numeric output", ALGOL 68 solution formatted-numeric-output-1.alg.
  https://rosettacode.org/wiki/Formatted_numeric_output#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/formatted-numeric-output-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
{main:} (
  real r=exp(pi)-pi;
  print((r,newline));
  printf((gfmt ("g(-16,4)l"),-r));
  printf((gfmt ("g(-16,4)l"),r));
  printf((gfmt ("g(16,4)l"),r));
  printf((gfmt ("g(16,4,1)l"),r));
  printf((gfmt ("-dddd.ddddl"),-r));
  printf((gfmt ("-dddd.ddddl"),r));
  printf((gfmt ("+dddd.ddddl"),r));
  printf((gfmt ("ddddd.ddddl"),r));
  printf((gfmt ("zzzzd.ddddl"),r));
  printf((gfmt ("zzzz-dd.ddddl"),-r));
  printf((gfmt ("zzzz-dd.dddde-ddl"),-r));
  printf((gfmt ("zz-d.dddde+ddl"),-r));
  printf((gfmt ("4z-d.4de+4dl"),r))
)
)
