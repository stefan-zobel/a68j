{ dg-modules "rcprelude" }
{ Rosetta Code, task "Prime numbers of measurement", ALGOL 68 solution prime-numbers-of-measurement.alg.
  https://rosettacode.org/wiki/Prime_numbers_of_measurement#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/prime-numbers-of-measurement.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { Prime numbers of measurement - translated from the EasyLang sample }
    [ 1 : 1000 ]int prmeas;
    prmeas[ 1 ] := 1;
    int prind   := 1;
    for next from 2 while prind < UPB prmeas do
        int sum := 0;
        for i to prind while sum /= next do
            sum := 0;
            for j from i to prind while sum < next do
                sum +:= prmeas[ j ]
            od
        od;
        if sum /= next then prmeas[ prind +:= 1 ] := next fi
    od;
    print( ( "First 100:", newline ) );
    for n to 100 do
        print( ( " ", whole( prmeas[ n ], -5 ) ) );
        if n MOD 10 = 0 then print( ( newline ) ) fi
    od;
    print( ( "One Thousandth: ", whole( prmeas[ 1000 ], 0 ) ) )
end
)
