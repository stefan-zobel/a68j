{ dg-modules "rcprelude" }
{ Rosetta Code, task "Show the (decimal) value of a number of 1s appended with a 3, then squared", ALGOL 68 solution show-the-decimal-value-of-a-number-of-1s-appended-with-a-3-then-squared-2.alg.
  https://rosettacode.org/wiki/Show_the_(decimal)_value_of_a_number_of_1s_appended_with_a_3,_then_squared#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/show-the-decimal-value-of-a-number-of-1s-appended-with-a-3-then-squared-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
     
    long long int n := 0;
    for i from 0 to 111 do
        long long int n3 = ( n * 10 ) + 3;
        if i > 84 then
            string v := whole( n3 * n3, 0 );
            int pos := 0;
            string pattern := "123456790";
            int    p_len   := ( UPB pattern - LWB pattern ) + 1;
            while string_in_string( pattern, pos, v ) do
                v := v[ 1 : pos - 1 ] + "A" + v[ pos + p_len : ]
            od;
            pattern := "987654320";
            while string_in_string( pattern, pos, v ) do
                v := v[ 1 : pos - 1 ] + "Z" + v[ pos + p_len : ]
            od;
            print( ( whole( i, -3 ), " ", v, newline ) )
        fi;
        n *:= 10 +:= 1
    od
end
)
