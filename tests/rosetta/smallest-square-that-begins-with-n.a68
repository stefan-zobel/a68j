{ dg-modules "rcprelude" }
{ Rosetta Code, task "Smallest square that begins with n", ALGOL 68 solution smallest-square-that-begins-with-n.alg.
  https://rosettacode.org/wiki/Smallest_square_that_begins_with_n#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/smallest-square-that-begins-with-n.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find the smallest square that begins with n for n in 1..49 }
    int max_number = 49;
    [ max_number ]int square; for i to max_number do square[ i ] := 0 od;
    int number_found := 0;
    for i while number_found < max_number do
        int sq = i * i;
        int v := sq;
        while v > 0 do
            if v <= max_number then
                if square[ v ] = 0 then
                    { found the first square that starts with v }
                    square[ v ]   := sq;
                    number_found +:= 1
                fi
            fi;
            v OVERAB 10
        od
    od;
    { show the squares }
    for i to max_number do
        print( ( " ", whole( square[ i ], -6 ) ) );
        if i MOD 10 = 0 then print( ( newline ) ) fi
    od
end
)
