{ dg-modules "genietransput" }
{ Rosetta Code, task "Averages/Arithmetic mean", ALGOL 68 solution averages-arithmetic-mean.alg.
  https://rosettacode.org/wiki/Averages/Arithmetic_mean#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/averages-arithmetic-mean.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
proc mean = (ref[]real p)real:
{ Calculates the mean of qty REALs beginning at p. }
  if LWB p > UPB p then 0.0
  else
    real total := 0.0;
    for i from LWB p to UPB p do total +:= p[i] od;
    total / (UPB p - LWB p + 1)
  fi;

main:(
  [6]real test := (1.0, 2.0, 5.0, -5.0, 9.5, 3.14159);
  print((mean(test),new_line))
)
)
