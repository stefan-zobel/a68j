{ dg-modules "rcprelude" }
{ Rosetta Code, task "Cantor set", ALGOL 68 solution cantor-set.alg.
  https://rosettacode.org/wiki/Cantor_set#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/cantor-set.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    { draw a Cantor Set using ASCII                                            }
    int    lines     = 5; { number of lines for the set                        }
    { we must choose the line width so that the width of each segment is       }
    { divisible by 3 ( except for the final line where the segment width will  }
    { be 1 )                                                                   }
    int    set_width = 3 ^ ( lines - 1 );
    [ set_width ]char cset;
    { start with a complete line }
    for i to set_width do cset[ i ] := "#" od;
    print( ( cset, newline ) );
    { repeatedly modify the line, replacing the middle third of each segment   }
    { with blanks                                                              }
    int   segment_width := set_width OVER 3;
    while segment_width > 0 do
        int   set_pos := 1;
        while set_pos < ( set_width - segment_width ) do
            set_pos   +:= segment_width;
            for char_pos from set_pos to ( set_pos + segment_width ) - 1 do
                cset[ char_pos ] := " "
            od;
            set_pos +:= segment_width
        od;
        print( ( cset, newline ) );
        segment_width OVERAB 3
    od
end
)
