{ dg-modules "genietransput" }
{ Rosetta Code, task "Jaccard index", ALGOL 68 solution jaccard-index.alg.
  https://rosettacode.org/wiki/Jaccard_index#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/jaccard-index.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { calculate the Jaccard index of some sets                             }

    { returns TRUE if v is in s, FALSE otherwise                             }
    prio CONTAINS = 1;
    op   CONTAINS = ( []int s, int v )bool:
         begin
            bool found := false;
            for i from LWB s to UPB s while NOT ( found := s[ i ] = v ) do skip od;
            found
         end { CONTAINS } ;
    { returns TRUE if v is not in s, FALSE if it is                          }
    prio NOTIN = 1;
    op   NOTIN = ( int v, []int s )bool: NOT ( s CONTAINS v );

    { returns the Jaccard index of a and b                                   }
    prio JACCARD = 1;
    op   JACCARD = ( []int a, []int b )real:
         if LWB a > UPB a AND LWB b > UPB b
         then 1 { both sets are empty }
         else int i_count := 0, u_count := 0;
              for i from LWB a to UPB a do
                  u_count +:= 1;
                  if b CONTAINS a[ i ] then i_count +:= 1 fi
              od;
              for i from LWB b to UPB b do
                  if b[ i ] NOTIN a then u_count +:= 1 fi
              od;
              i_count / u_count
         fi { JACCARD } ;

    [][]int  sets  = ( []int( () )
                     , ( 1, 2, 3, 4,  5 )
                     , ( 1, 3, 5, 7,  9 )
                     , ( 2, 4, 6, 8, 10 )
                     , ( 2, 3, 5, 7 )
                     , []int( 8 )
                     );
    []string names = ( "A", "B", "C", "D", "E", "F" );
    print( ( "  " ) );
    for n from LWB names to UPB names do print( ( "      ", names[ n ] ) ) od;
    print( ( newline ) );
    for s1 from LWB sets to UPB sets do
        print( ( names[ s1 ], " " ) );
        for s2 from LWB sets to UPB sets do
            print( ( fixed( sets[ s1 ] JACCARD sets[ s2 ], -7, 3 ) ) )
        od;
        print( ( newline ) )
    od
end
)
