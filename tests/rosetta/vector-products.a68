{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Vector products", ALGOL 68 solution vector-products.alg.
  https://rosettacode.org/wiki/Vector_products#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/vector-products.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
mode Field = int;
Gformat field_fmt = gfmt ("g(-0)");

mode Vec = [3]Field;
Gformat vec_fmt = gfmtd ("""(""f(@1)"", ""f(@2)"", ""f(@3)"")""", skip, (int gfindex) Gformat: case gfindex in field_fmt, field_fmt, field_fmt esac);

proc crossp = (Vec a, b)Vec:(
    {Cross product of two 3D vectors}
    { ASSERT(LWB a = LWB b AND UPB a = UPB b AND UPB b = 3 # "For 3D vectors only" #); }
    (a[2]*b[3] - a[3]*b[2], a[3]*b[1] - a[1]*b[3], a[1]*b[2] - a[2]*b[1])
);

prio MAXLWB = 8, MINUPB=8;

op MAXLWB = (Vec a, b)int: (LWB a<LWB b|LWB a|LWB b);
op MINUPB = (Vec a, b)int: (UPB a>UPB b|UPB a|UPB b);

proc dotp = (Vec a, b)Field:(
    {Dot product of two vectors}
    Field sum := 0;
    for i from a MAXLWB b to a MINUPB b do sum +:= a[i]*b[i] od;
    sum
);

proc scalartriplep = (Vec a, b, c)Vec:(
    {Scalar triple product of three vectors: "a . (b x c)"}
    dotp(a, crossp(b, c))
);

proc vectortriplep = (Vec a, b, c)Vec:(
    {Vector triple product of three vectors: "a x (b x c)"}
    crossp(a, crossp(b, c))
);

{ Declare some useful operators }
prio DOT = 5, X = 5;
op (Vec, Vec)Field DOT = dotp;
op (Vec, Vec)Vec X = crossp;

main:(
    Vec a=(3, 4, 5), b=(4, 3, 5), c=(-5, -12, -13);
    printf((gfmtd ("""a = ""f(@1)"";  b = ""f(@2)"";  c = ""f(@3)l", skip, (int gfindex) Gformat: case gfindex in vec_fmt, vec_fmt, vec_fmt esac) , a, b, c));
    printf(gfmt ("""Using PROCedures:""l"));
    printf((gfmtd ("""a . b = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in field_fmt esac), dotp(a,b)));
    printf((gfmtd ("""a x b = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in vec_fmt esac), crossp(a,b)));
    printf((gfmtd ("""a . (b x c) = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in field_fmt esac), scalartriplep(a, b, c)));
    printf((gfmtd ("""a x (b x c) = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in vec_fmt esac), vectortriplep(a, b, c)));
    printf(gfmt ("""Using OPerators:""l"));
    printf((gfmtd ("""a . b = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in field_fmt esac), a DOT b));
    printf((gfmtd ("""a x b = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in vec_fmt esac), a X b));
    printf((gfmtd ("""a . (b x c) = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in field_fmt esac), a DOT (b X c)));
    printf((gfmtd ("""a x (b x c) = ""f(@1)l", skip, (int gfindex) Gformat: case gfindex in vec_fmt esac), a X (b X c)))
)
)
