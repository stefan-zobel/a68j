{ dg-modules "rcprelude" }
{ Rosetta Code, task "Longest string challenge", ALGOL 68 solution longest-string-challenge-1.alg.
  https://rosettacode.org/wiki/Longest_string_challenge#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/longest-string-challenge-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
   int bound = 1000000;			 { Arbitrary upper limit on string lengths }
   int max;				 { Length of longest string }
   int len;				 { Length of string under examination }
   string buffer := "";			 { All characters read from stand in }
   string mask := bound * "0";		 { High water mark of string length seen so far }
{ Standard boiler plate }
   on_file_end (stand_in, (ref file f) bool: (close (f); goto finished));
   do
      string line;
      read ((line, newline));
      buffer PLUSAB line + REPR 10;	{ Concatenate string and newline }
      mask[UPB line] := "1"		{ And set mask where character exists in line }
   od;
finished:
   buffer PLUSAB REPR 10;		{ Guarantee there's a zero-length string at the end }
{
   Scan backwards through mask looking for highest index used which is equal to the length
   of the longest string with its terminating newline.
}
   for i from bound by -1 to 1
   do
      from ABS mask[i] to ABS "0" do max := i od	{ Exploit ABS "1" > ABS "0" }
   od;
   from 1 to UPB buffer
   do							{ Null loop if buffer is empty }
      void (char_in_string (REPR 10, len, buffer));	{ Pedantry and Algol68 Genie extension }
      from max to len
      do						{ Null loop if len < max }
	 for i from 1 to max
	 do
	    printf (($a$, buffer[i]))			{ Print string and newline }
	 od
      od;
      buffer := buffer[len : UPB buffer];		{ Step over string }
      buffer := buffer[2 : UPB buffer]			{ Step over newline }
   od
end
)
