{ dg-modules "genietransput" }
{ Rosetta Code, task "Bulls and cows", ALGOL 68 solution bulls-and-cows.alg.
  https://rosettacode.org/wiki/Bulls_and_cows#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/bulls-and-cows.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
string digits = "123456789";

[4]char chosen;
string available := digits;
for i to UPB chosen do
    int c = ENTIER(random*UPB available)+1;
    chosen[i] := available[c];
    available := available[:c-1]+available[c+1:]
od;

{ print((chosen, new line)); # Debug # END }

op D = (int d)string: whole(d,0); { for formatting an integer }

print (("I have chosen a number from ",D UPB chosen
       ," unique digits from 1 to 9 arranged in a random order."
       , new_line,"You need to input a ",D UPB chosen
       ," digit, unique digit number as a guess at what I have chosen", new_line));

prio WITHIN = 5, NOTWITHIN = 5;
op WITHIN = (char c, []char s)bool: char_in_string(c,loc int,s);
op NOTWITHIN = (char c, []char s)bool: NOT ( c WITHIN s );

bool quit := false;
int guesses := 0, bulls, cows;
while
    string guess;
    guesses +:= 1;
    while
        { get a good guess }
        print((new_line,"Next guess [",D guesses,"] (or Q to quit): "));
        read((guess, new_line));
        if guess = "Q" OR guess = "q" then
            quit := true;
            false
        elif UPB guess NE UPB chosen then
            false
        else
            bool ok;
            for i to UPB guess while
                ok := guess[i] WITHIN digits AND guess[i] NOTWITHIN guess[i+1:]
            do skip od;
            NOT ok
        fi
    do
        print(("Problem, try again. You need to enter ",D UPB chosen," unique digits from 1 to 9", new_line))
    od;
{ WHILE }
    guess NE chosen AND NOT quit
do
    bulls := cows := 0;
    for i to UPB chosen do
        if guess[i] = chosen[i] then
            bulls +:= 1
        elif guess[i] WITHIN chosen then
            cows +:= 1
        fi
    od;
    print(("  ",D bulls," Bulls",new_line,"  ",D cows," Cows"))
od;
if quit then
    print((new_line, "Game abandoned, feel free to play again later...", new_line))
else
    print((new_line, "Congratulations you guessed correctly in ",D guesses," attempts.",new_line))
fi
)
