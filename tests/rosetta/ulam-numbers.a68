{ dg-modules "rcprelude" }
{ Rosetta Code, task "Ulam numbers", ALGOL 68 solution ulam-numbers.alg.
  https://rosettacode.org/wiki/Ulam_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/ulam-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find some Ulam numbers, U(n) = the smallest number > U(n-1) that is  }
      { the uniue sum of U(i) and U(j), i, j < n, i =/= j, U(1)=1, U(2) = 2  }
    int max_ulam  = 10 000;                    { maximum ulam number to find }
    [ 1 : max_ulam ]int u;                              { ulam numbers found }
    for i to UPB u do u[ i ] := 0 od;
    int ulam_size = 20 000;         { initial size of the ulam number buffer }
    char unused = "0", one = "1", multiple = "2";   { states of ulam numbers }
    flex[ 1 : ulam_size ]char ulam;for i to UPB ulam do ulam[ i ] := unused od;
    ulam[ 3 ] := ulam[ 2 ] := ulam[ 1 ] := one; u[ 1 ] := 1; u[ 2 ] := 2;
    print( ( " 1 2" ) );
    int u_count      :=   2;                  { numer of ulam numbers found  }
    int power_of_ten := 100;       { next "power of ten" ulam number to show }
    for i from 3 while u_count < max_ulam do
        if ulam[ i ] = one then
            { can use this number                                            }
            u[ u_count +:= 1 ] := i;
            if u_count < 21 then
                print( ( " ", whole( i, 0 ) ) );
                if u_count = 20 then print( ( "..." ) ) fi
            elif u_count = power_of_ten then
                print( ( newline, "The ", whole( power_of_ten, -6 ) ) );
                print( ( "th Ulam number is: ", whole( i, 0 ) ) );
                power_of_ten *:= 10
            fi;
            for p to u_count - 1 do
                int upi = u[ p ] + i;
                if upi > UPB ulam then
                    { need a bigger ulam buffer                              }
                    [ 1 : UPB ulam + ulam_size ]char new_ulam;
                    new_ulam[ 1 : UPB ulam ] := ulam;
                    for u_pos from UPB ulam + 1 to UPB new_ulam do new_ulam[ u_pos ] := unused od;
                    ulam := new_ulam
                fi;
                char upic = ulam[ upi ];
                if   upic = unused
                then ulam[ upi ] := one         { u[ p ] + i is unique so far }
                elif upic = one
                then ulam[ upi ] := multiple    { u[ p ] + i isn't unique     }
                fi
            od
        fi
    od;
    print( ( newline ) )
end
)
