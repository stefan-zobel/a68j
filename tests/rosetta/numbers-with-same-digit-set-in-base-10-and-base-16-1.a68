{ dg-modules "rcprelude" }
{ Rosetta Code, task "Numbers with same digit set in base 10 and base 16", ALGOL 68 solution numbers-with-same-digit-set-in-base-10-and-base-16-1.alg.
  https://rosettacode.org/wiki/Numbers_with_same_digit_set_in_base_10_and_base_16#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/numbers-with-same-digit-set-in-base-10-and-base-16-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find numbers that use the same digits in decimal and hexadecimal      }
      { translation of the Algol W sample                                     }
    int max_number = 100 000;
    { note 100 000 is 186A0 in hexadecimal, so we need to consider numbers    }
    { with up to 5 hexadedcimal digits                                        }
    { powers of 16 }
    int x2 = 16; int x3 = x2 * 16; int x4 = x3 * 16; int x5 = x4 * 16;
    { construct the numbers that have only 0-9 in their hex representations   }
    int hd_count := 0;
    int n        := 0;
    int hx5      := 0;
    for h5 from 0 to 1 while n < max_number do
        int hx4 := 0;
        for h4 from 0 to 9 while n < max_number do
            int hx3 := 0;
            for h3 from 0 to 9 while n < max_number do
                int hx2 := 0;
                for h2 from 0 to 9 while n < max_number do
                    for h1 from 0 to 9 while ( n := hx5 + hx4 + hx3 + hx2 + h1 ) < max_number do
                        int  d    := n;
                        bits dset := if d = 0 then 16r1 else 16r0 fi;
                        while d > 0 do
                            dset  := dset OR ( 16r1 SHL ( d MOD 10 ) );
                            d OVERAB 10
                        od;
                        bits hset := 16r0;
                        if 0 /= h5                then hset := hset OR ( 16r1 SHL h5 ) fi;
                        if 0 /= h5 + h4           then hset := hset OR ( 16r1 SHL h4 ) fi;
                        if 0 /= h5 + h4 + h3      then hset := hset OR ( 16r1 SHL h3 ) fi;
                        if 0 /= h5 + h4 + h3 + h2 then hset := hset OR ( 16r1 SHL h2 ) fi;
                        hset := hset OR ( 16r1 SHL h1 );
                        if dset = hset then
                            { the decimal and hexadecimal representations     }
                            { use the same digits                             }
                            print( ( " ", whole( n, -7 ) ) );
                            if ( hd_count +:= 1 ) MOD 10 = 0 then print( ( newline ) ) fi
                        fi
                    od;
                    hx2 +:= x2
                od;
                hx3 +:= x3
            od;
            hx4 +:= x4
        od;
        hx5 +:= x5
    od;
    print( ( newline ) );
    print( ( "Found ", whole( hd_count, 0 ), " numbers up to ", whole( max_number, 0 ) ) );
    print( ( " where the decimal and hexadecimal representations use the same digits", newline ) )
end
)
