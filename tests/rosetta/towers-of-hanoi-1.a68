{ dg-modules "genietransput" }
{ Rosetta Code, task "Towers of Hanoi", ALGOL 68 solution towers-of-hanoi-1.alg.
  https://rosettacode.org/wiki/Towers_of_Hanoi#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/towers-of-hanoi-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
proc move = (int n, from_, to_, via) void:
  if n > 0 then
    move(n - 1, from_, via, to_);
    printf(($"Move disk from pole "g" to pole "gl$, from_, to_));
    move(n - 1, via, to_, from_)
  fi
;

main: (
  move(4, 1,2,3)
)
)
