{ dg-modules "genietransput" }
{ Rosetta Code, task "Meissel-Mertens constant", ALGOL 68 solution meissel-mertens-constant.alg.
  https://rosettacode.org/wiki/Meissel-Mertens_constant#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/meissel-mertens-constant.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { compute an approximation to the Meissel-Mertens constant             }
    { construct a sieve of odd primes                                        }
    [ 0 : 10 000 000 ]bool primes;
    begin
        for i to UPB primes do primes[ i ] := true  od;
        int ip := 1;
        for i while i + ( ip +:= 2 ) <= UPB primes do
            if primes[ i ] then
                for s from i + ip by ip to UPB primes do primes[ s ] := false od
            fi
        od
    end;
    { sum the reciprocals of the primes                                      }
    int       p_count := 1;
    int       last_p  := 0;
    long real sum     := long_ln( 0.5 ) + 0.5;
    int       p       := 1;
    int       p10     := 10;
    { Euler's constant from the wikipedia, truncated for LONG REAL           }
    long real eulers_constant = 0.5772156649015328606 { 0651209008240243104215933593992 };
    for i to UPB primes do
        p +:= 2;
        if primes[ i ] then
            long real rp = 1 / LENG p;
            sum     +:= long_ln( 1 - rp ) + rp;
            p_count +:= 1;
            last_p   := p;
            if p_count = p10 then
                print( ( "after ", whole( p_count, -8 ), " primes, the approximation is: "
                       , fixed( sum + eulers_constant, -14, 12 )
                       , ", last prime considered: ", whole( last_p, 0 )
                       , newline
                       )
                     );
                p10 := if p10 < 1 000 000 then p10 * 10 else p10 + 1 000 000 fi
            fi
        fi
    od;
    print( ( "after ", whole( p_count, -8 ), " primes, the approximation is: "
           , fixed( sum + eulers_constant, -14, 12 )
           , ", last prime considered: ", whole( last_p, 0 )
           , newline
           )
         )
end
)
