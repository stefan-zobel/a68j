{ dg-modules "genietransput" }
{ Rosetta Code, task "Thue-Morse", ALGOL 68 solution thue-morse.alg.
  https://rosettacode.org/wiki/Thue-Morse#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/thue-morse.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ "flips" the "bits" in a string (assumed to contain only "0" and "1" characters) }
op  FLIP = ( string s )string:
    begin
        string result := s;
        for char_pos from LWB result to UPB result do
            result[ char_pos ] := if result[ char_pos ] = "0" then "1" else "0" fi
        od;
        result
    end; { FLIP }

{ print the first few members of the Thue-Morse sequence }
string tm := "0";
to 7 do
    print( ( tm, newline ) );
    tm +:= FLIP tm
od
)
