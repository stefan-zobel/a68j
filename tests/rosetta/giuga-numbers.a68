{ dg-modules "genietransput" }
{ Rosetta Code, task "Giuga numbers", ALGOL 68 solution giuga-numbers.alg.
  https://rosettacode.org/wiki/Giuga_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/giuga-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find some Giuga numbers, composites n such that all their distinct   }
      {                        prime factors f exactly divide ( n / f ) - 1  }

    { find the first four Giuga numbers                                      }
    { each prime factor must appear only once, e.g.: for 2:                  }
    { [ ( n / 2 ) - 1 ] mod 2 = 0  => n / 2 is odd => n isn't divisible by 4 }
    { similarly for other primes                                             }
    int g_count := 0;
    for n from 2 by 4 while g_count < 4 do { assume the numbers are all even }
        int  v        := n OVER 2;
        bool is_giuga := true;
        int  f_count  := 1;
        for f from 3 by 2 while f <= v AND is_giuga do
            if v MOD f = 0 then
                { have a prime factor                                        }
                f_count +:= 1;
                is_giuga := ( ( n OVER f ) - 1 ) MOD f = 0;
                v OVERAB f
            fi
        od;
        if is_giuga then
            { n is still a candidate, check it is not prime                  }
            if f_count > 1 then
                g_count +:= 1;
                print( ( " ", whole( n, 0 ) ) )
            fi
        fi
    od
end
)
