{ dg-modules "genietransput" }
{ Rosetta Code, task "Horner's rule for polynomial evaluation", ALGOL 68 solution horners-rule-for-polynomial-evaluation.alg.
  https://rosettacode.org/wiki/Horner's_rule_for_polynomial_evaluation#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/horners-rule-for-polynomial-evaluation.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
proc horner = ([]real c, real x)real :
(
  real res := 0.0;
  for i from UPB c by -1 to LWB c do
    res := res * x + c[i]
  od;
  res
);

main:(
  [4]real coeffs := (-19.0, 7.0, -4.0, 6.0);
  print( horner(coeffs, 3.0) )
)
)
