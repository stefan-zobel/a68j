{ dg-modules "genietransput" }
{ Rosetta Code, task "Sign of an integer (signum)", ALGOL 68 solution sign-of-an-integer-signum-.alg.
  https://rosettacode.org/wiki/Sign_of_an_integer_(signum)#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sign-of-an-integer-signum-.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin

    proc signum = ( int x )int: if ABS x = 0 then x elif x < 0 then -1 else 1 fi;

    for x from 0 to 3 do
        print( ( whole( -x, -2 ), " -> ", whole( signum( -x ), -2 ), "; "    ) );
        print( ( whole(  x, -2 ), " -> ", whole( signum(  x ), -2 ), newline ) )
    od
end
)
