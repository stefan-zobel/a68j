{ dg-modules "genietransput" }
{ Rosetta Code, task "Forbidden numbers", ALGOL 68 solution forbidden-numbers.alg.
  https://rosettacode.org/wiki/Forbidden_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/forbidden-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find some forbidden numbers: numbers that cannot be formed by        }
      { summing fewer than four squares                                      }
    { returns TRUE if n is a Forbidden numbr, FALSE otherwise                }
    {         based on the Wren version of the example at oeis.org/A004215   }
    proc is_forbidden = ( int n )bool:
         begin
             int m  := n;
             int p4 := 1;
             while m > 1 AND m MOD 4 = 0 do
                 m OVERAB 4;
                 p4   *:= 4
             od;
             ( n OVER p4 ) MOD 8 = 7
         end { is forbidden } ;
    { show the first 50 forbidden numbers and counts of Forbidden numbers    }
    int f_count      :=   0;
    int next_to_show := 500;
    for i to 50 000 000 do
        if is_forbidden( i ) then
            f_count +:= 1;
            if f_count <= 50 then
                print( ( " ", whole( i, -4 ) ) );
                if f_count MOD 10 = 0 then print( ( newline ) ) fi
            fi
        fi;
        if i = next_to_show then
            print( ( "There are ", whole( f_count, -8 )
                   , " Forbidden numbers up to ", whole( i, 0 )
                   , newline
                   )
                 );
            next_to_show *:= 10
        fi
    od
end
)
