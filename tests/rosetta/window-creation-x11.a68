{ dg-modules "rcprelude" }
{ Rosetta Code, task "Window creation/X11", ALGOL 68 solution window-creation-x11.alg.
  https://rosettacode.org/wiki/Window_creation/X11#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/window-creation-x11.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
file window;
draw_device (window, "X", "600x400");
open (window, "Hello, World!", stand_draw_channel);
  draw_erase (window);
  draw_move (window, 0.25, 0.5);
  draw_colour (window, 1, 0, 0);
  draw_text (window, "c", "c", "hello world");
  draw_show (window);
  void (read_char);
close (window)
)
