access Genie_Transput (
{ -*- coding: utf-8 -*- }
mode Dietitem = struct(
  string food, annual_quantity, units, real cost
);

{ Stigler's 1939 Diet ... }
FORMAT diet_item_fmt = $g": "g" "g" = $"zd.dd$;
[]Dietitem stigler_diet = (
  ("Cabbage",           "111","lb.",  4.11),
  ("Dried Navy Beans",  "285","lb.", 16.80),
  ("Evaporated Milk",    "57","cans", 3.84),
  ("Spinach",            "23","lb.",  1.85),
  ("Wheat Flour",       "370","lb.", 13.33),
  ("Total Annual Cost",    "","",    39.93)
)
)
