{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Count in octal", ALGOL 68 solution count-in-octal.alg.
  https://rosettacode.org/wiki/Count_in_octal#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/count-in-octal.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
{!/usr/local/bin/a68g --script }

int oct_width = (bits_width-1) OVER 3 + 1;
main:
(
  for i to 17 { max int } do
    printf((gfmtd ("""8r""8r n(@1)dl", (int gfindex) int: case gfindex in oct_width esac, skip), BIN i))
  od
)
)
