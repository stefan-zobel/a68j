{ dg-modules "rcprelude" }
{ Rosetta Code, task "Elementary cellular automaton", ALGOL 68 solution elementary-cellular-automaton.alg.
  https://rosettacode.org/wiki/Elementary_cellular_automaton#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/elementary-cellular-automaton.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { elementary cellular automaton }
    { returns the next state from state using rule s must be at least 2 characters long
            and consist of # and - only
    }
    proc next_state = ( string state, int rule )string:
         begin
            { returns 1 or 0 depending on whether c = # or not }
            op TOINT = ( char c )int: if c = "#" then 1 else 0 fi;
            { construct the state with additional extra elements to allow wrap-around }
            string s = state[ UPB state ] + state + state[ LWB state : LWB state + 1 ];
            { convert rule to a string of # or - depending on whether the bits of r are on or off
            }
            string r := "";
            int    v := rule;
            to 8 do
                r +:= if ODD v then "#" else "-" fi;
                v OVERAB 2
            od;
            string new_state := "";
            for i from LWB s to UPB s - 3 do
                char c1  = s[ i     ];
                char c2  = s[ i + 1 ];
                char c3  = s[ i + 2 ];
                int pos := ( ( ( TOINT c1 * 2 ) + TOINT c2 ) * 2 ) + TOINT c3;
                new_state +:= r[ pos + 1 ]
            od;
            new_state
         end { next state } ;
    { evolve state until the next state = the current state or 10 iterations have occured }
    proc test = ( string state, int rule )void:
         begin
             print( ( "Rule ", whole( rule, 0 ), newline ) );
             string curr := state;
             print( ( " 0: ", curr, newline ) );
             for i to 10 while string next = next_state( curr, rule );
                               next /= curr
             do
                 print( ( whole( i, -2 ), ": ", next, newline ) );
                 curr := next
             od
         end { test } ;
    { tests }
    test( "---------#---------", 30 );
    test( "---------#---------", 60 );
    test( "---------#---------", 90 )
end
)
