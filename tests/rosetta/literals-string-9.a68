{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Literals/String", ALGOL 68 solution literals-string-9.alg.
  https://rosettacode.org/wiki/Literals/String#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/literals-string-9.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
Gformat my_symbol = gfmt ("""SYMBOL""");
Gformat foo  = gfmtd ("""prefix_""f(@1)""_suffix""", skip, (int gfindex) Gformat: case gfindex in my_symbol esac);
putf(linef ,foo);
)
