{ dg-modules "genietransput" }
{ Rosetta Code, task "Input loop", ALGOL 68 solution input-loop-1.alg.
  https://rosettacode.org/wiki/Input_loop#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/input-loop-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
main:(
  proc raise_logical_file_end = (ref File f) bool: ( except_logical_file_end );
  on_logical_file_end(stand_in, raise_logical_file_end);
  do
    print(read_string);
    read(new_line);
    print(new_line)
  od;
  except_logical_file_end:
    skip
)
)
