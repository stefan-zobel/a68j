{ dg-modules "rcprelude" }
{ Rosetta Code, task "Modified random distribution", ALGOL 68 solution modified-random-distribution.alg.
  https://rosettacode.org/wiki/Modified_random_distribution#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/modified-random-distribution.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { Modified random distribution - translation of the Wren sample }

    next_random; { initialise the random number generator }

    proc rng = ( proc(real)real modifier_fn )real:
         begin
            real r1, r2;
            while
                r1 := random;
                r2 := random;
                r2 >= modifier_fn( r1 )
            do skip od;
            r1
         end { rng } ;

    proc modifier = ( real x )real: 2 * ABS ( 0.5 - x );

    int  n              = 100 000;
    int  num_bins       = 21;
    real bin_size       = 1 / num_bins;
    char hist_char      = "#";
    int  hist_char_size = 125;
    [ 0 : num_bins - 1 ]int  bins ; for i from LWB bins to UPB bins do bins[ i ] := 0 od;
    from 0 to n do
        bins[ ENTIER ( rng( modifier ) / bin_size ) ] +:= 1
    od;

    proc f2 = ( real v )string:        { formatting routine }
         begin
            string result := fixed( ABS v, 0, 2 );
            if result[ LWB result ] = "." then "0" +=: result fi;
            if v < 0 then "-" +=: result fi;
            result
         end { FMT } ;

    print( ( "Modified random distribution with ", whole( n, 0 ), " samples in range [0, 1):", newline ) );
    print( ( "    Range       Number of samples within that range", newline ) );
    for i from LWB bins to UPB bins do
        string hist = hist_char * ROUND ( bins[ i ] / hist_char_size );
        print( ( f2( bin_size * i ), " ..< " ) );
        print( ( f2( bin_size * ( i + 1 ) ), "  ", whole( bins[ i ], -5 ), " ", hist, newline ) )
    od

end
)
