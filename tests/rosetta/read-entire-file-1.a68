  tools/rosetta_prep.py. }
access Genie_Transput (
mode Book = flex[0]flex[0]flex[0]char; ¢ pages_of_lines_of_characters ¢
Book book;

File book_file;
int errno = open(book_file, "book.txt", stand_in_channel);

get(book_file, book)
)
