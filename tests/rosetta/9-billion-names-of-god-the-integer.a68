{ dg-modules "genietransput" }
{ Rosetta Code, task "9 billion names of God the integer", ALGOL 68 solution 9-billion-names-of-god-the-integer.alg.
  https://rosettacode.org/wiki/9_billion_names_of_God_the_integer#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/9-billion-names-of-god-the-integer.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
int number_of_rows = 123;
mode Nameg = long int;


[ number_of_rows ]ref[]Nameg c;
[ number_ofrows ]      Nameg names;
for i to UPB names do
    names[ i ] := 0;
    c[ i ] := heap [ i ]Nameg;
    for j to i do c[ i ][ j ] := 0 od
od;

for n to UPB names do
    for col to n do
        c[ n ][ col ] := if   col = 1                         then 1
                         elif col = 2                         then n OVER 2
                         elif col >= n - 1                    then 1
                         elif ( n - col ) < col               then names[ n - col ]
                         elif ( n - col ) = col AND NOT ODD n then names[ n - col ]
                         else
                             Nameg partial_sum := 0;
                             for k to col do partial_sum +:= c[ n - col ][ k ] od;
                             partial_sum
                         fi
    od;
    names[ n ]:= 0;
    for k to n do names[ n ] +:= c[ n ][ k ] od
; if n MOD 200 = 0 then print( ( "...", whole( n, 0 ), newline ) ) fi
od;

{ display the first 25 rows of the triangle }
for n to 25 do
    print( ( "(", whole( names[ n ], -6 ), ")", whole( n, -3 ), ":" ) );
    for col to n do
        print( ( " ", whole( c[ n ][ col ], -3 ) ) )
    od;
    print( ( newline ) )
od;

print( ( "   23: ", whole( names[    23 ], 0 ), newline ) );
print( ( "  123: ", whole( names[   123 ], 0 ), newline ) )
)
