{ dg-modules "genietransput" }
{ Rosetta Code, task "Undefined values", ALGOL 68 solution undefined-values.alg.
  https://rosettacode.org/wiki/Undefined_values#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/undefined-values.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
mode R = ref bool;
R r := nil;

mode U = union(bool, void);
U u := empty;

if r is R(nil) then
  print(("r IS NIL", new_line))
else
  print(("r ISNT NIL", new_line))
fi;

case u in
  (void):print(("u is EMPTY", new_line))
  out    print(("u isnt EMPTY", new_line))
esac
)
