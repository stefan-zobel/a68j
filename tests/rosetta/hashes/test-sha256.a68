# SHA-256 and HMAC-SHA-256: the test vectors of FIPS 180-4 and RFC 4231,  #
# the Rosetta Code task "SHA-256", and messages whose lengths are near    #
# the limits of the padding                                               #
BEGIN
   PR read "bits.incl.a68" PR
   PR read "hashes.incl.a68" PR

   INT failed := 0;
   PROC check = (STRING name, [] INT digest, STRING expected) VOID:
      BEGIN
         STRING h = hex (digest);
         print ((IF h = expected THEN "ok    " ELSE "WRONG " FI, name, ": ", h, newline));
         IF h /= expected THEN failed +:= 1 FI
      END # check # ;
   PROC repeated = (CHAR c, INT n) STRING:
      BEGIN
         STRING s := "";
         FOR i TO n DO s +:= c OD;
         s
      END # repeated # ;
   PROC bytes of = (INT value, n) [] INT:
      BEGIN
         [1 : n] INT b;
         FOR i TO n DO b[i] := value OD;
         b
      END # bytes of # ;

   check ("empty", sha256 (bytes ("")),
          "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
   check ("abc", sha256 (bytes ("abc")),
          "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
   check ("448 bits", sha256 (bytes ("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")),
          "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
   check ("896 bits", sha256 (bytes ("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn" +
                                     "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")),
          "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");
   check ("Rosetta code", sha256 (bytes ("Rosetta code")),
          "764faf5c61ac315f1497f9dfa542713965b785e5cc2f707d6468d7d1124cdfcf");
   []  STRUCT (INT length, STRING digest) lengths =
      ((55, "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318"),
       (56, "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a"),
       (63, "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34"),
       (64, "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb"),
       (119, "31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb"),
       (1000, "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3"));
   FOR i FROM LWB lengths TO UPB lengths DO
      check (whole (length OF lengths[i], 0) + " times a",
             sha256 (bytes (repeated ("a", length OF lengths[i]))), digest OF lengths[i])
   OD;

   PROC sha = ([] INT m) [] INT: sha256 (m);
   check ("HMAC 1", hmac (sha, 64, bytes of (11, 20), bytes ("Hi There")),
          "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
   check ("HMAC 2", hmac (sha, 64, bytes ("Jefe"), bytes ("what do ya want for nothing?")),
          "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
   check ("HMAC 3", hmac (sha, 64, bytes of (170, 20), bytes of (221, 50)),
          "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe");
   check ("HMAC 6", hmac (sha, 64, bytes of (170, 131),
                          bytes ("Test Using Larger Than Block-Size Key - Hash Key First")),
          "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
   print ((whole (failed, 0), " wrong", newline))
END
