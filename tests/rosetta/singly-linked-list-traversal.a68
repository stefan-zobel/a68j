{ dg-modules "genietransput" }
{ Rosetta Code, task "Singly-linked list/Traversal", ALGOL 68 solution singly-linked-list-traversal.alg.
  https://rosettacode.org/wiki/Singly-linked_list/Traversal#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/singly-linked-list-traversal.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
mode Stringlist = struct(string value, ref Stringlist next);

Stringlist list := ("Big",
  loc Stringlist := ("fjords",
    loc Stringlist := ("vex",
      loc Stringlist := ("quick",
        loc Stringlist := ("waltz",
          loc Stringlist := ("nymph",nil))))));

ref Stringlist node := list;
while node isnt ref Stringlist(nil) do
  print((value of node, space));
  node := next of node
od;
print(newline)
)
