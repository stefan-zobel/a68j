{ dg-modules "rcprelude" }
{ Rosetta Code, task "Command-line arguments", ALGOL 68 solution command-line-arguments.alg.
  https://rosettacode.org/wiki/Command-line_arguments#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/command-line-arguments.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
main:(
  for i to argc do
    printf(($"the argument #"g(-0)" is "gl$, i, argv(i)))
  od
)
)
