{ dg-modules "genietransput" }
{ Rosetta Code, task "Egyptian division", ALGOL 68 solution egyptian-division.alg.
  https://rosettacode.org/wiki/Egyptian_division#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/egyptian-division.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
    { performs Egyptian division of dividend by divisor, setting quotient and remainder }
    { this uses 32 bit numbers, so a table of 32 powers of 2 should be sufficient       }
    { ( divisors > 2^30 will probably overflow - this is not checked here )             }
    proc egyptian_division = ( int dividend, divisor, ref int ed_quotient, ed_remainder )void:
         begin
            [ 1 : 32 ]int powers_of_2, doublings;
            { initialise the powers of 2 and doublings tables }
            powers_of_2[ 1 ] := 1;
            doublings  [ 1 ] := divisor;
            int   table_pos  := 1;
            while table_pos +:= 1;
                  powers_of_2[ table_pos ] := powers_of_2[ table_pos - 1 ] * 2;
                  doublings  [ table_pos ] := doublings  [ table_pos - 1 ] * 2;
                  doublings[ table_pos ] <= dividend
            do
                skip
            od;
            { construct the accumulator and answer }
            int accumulator := 0, answer := 0;
            while table_pos >=1
            do
                if ( accumulator + doublings[ table_pos ] ) <= dividend
                then
                    accumulator +:= doublings  [ table_pos ];
                    answer      +:= powers_of_2[ table_pos ]
                fi;
                table_pos -:= 1
            od;
            ed_quotient  := answer;
            ed_remainder := ABS ( accumulator - dividend )
        end { egyptian division } ;

    begin { task test case }
        int ed_quotient, ed_remainder;
        egyptian_division( 580, 34, ed_quotient, ed_remainder );
        print( ( "580 divided by 34 is: ", whole( ed_quotient, 0 ) ) );
        print( ( " remainder: ", whole( ed_remainder, 0 ), newline ) )
    end
end
)
