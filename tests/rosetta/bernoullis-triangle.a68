{ dg-modules "rcprelude" }
{ Rosetta Code, task "Bernoulli's triangle", ALGOL 68 solution bernoullis-triangle.alg.
  https://rosettacode.org/wiki/Bernoulli's_triangle#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/bernoullis-triangle.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { Bernoulli's triangle                                                 }

    { returns the next row of Bernoulli's triangle after prev                }
    op   NEXTBTROW = ( []int prev )[]int:
         if UPB prev < LWB prev then
            { generate the first row                                         }
            ( 1 )
         else
            { row 2 or higher                                                }
            [ LWB prev : UPB prev + 1 ]int next;
            next[ LWB prev : UPB prev ] := prev;
            int p2 := 2;
            for i from UPB prev by -1 to LWB prev + 1 do
                next[ i ] := prev[ i - 1 ] + prev[ i ];
                p2 +:= p2
            od;
            next[ UPB next ] := p2;
            next
         fi { NEXTBTROW };

    begin { show the first 15 rows of the triangle                           }
        flex[ 1 : 0 ]int row;
        to 15 do
            row := NEXTBTROW row;
            for i from LWB row to UPB row do
                print( ( if i = 1 then "" else " " fi, whole( row[ i ], 0 ) ) )
            od;
            print( ( newline ) )
        od
    end
end
)
