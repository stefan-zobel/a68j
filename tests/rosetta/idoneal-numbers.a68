{ dg-modules "rcprelude" }
{ Rosetta Code, task "Idoneal numbers", ALGOL 68 solution idoneal-numbers.alg.
  https://rosettacode.org/wiki/Idoneal_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/idoneal-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find idoneal numbers - numbers that cannot be written as ab + bc + ac }
      {                        where 0 < a < b < c                            }
      { there are 65 known idoneal numbers                                    }
    int count    :=  0;
    int max_count = 65;
    for n while count < max_count do
        bool idoneal := true;
        for a to n OVER 2 while idoneal do
            for b from a + 1 to n - 1
            while int ab = a * b;
                  int c   = ( n - ab ) OVER ( a + b );
                  int sum = ab + ( c * ( b + a ) );
                  sum <= n
              AND b < c
              AND ( idoneal := c <= b OR sum /= n )
            do skip od
        od;
        if idoneal then
            print( ( " ", whole( n, -4 ) ) );
            if ( count +:= 1 ) MOD 13 = 0 then print( ( newline ) ) fi
        fi
    od
end
)
