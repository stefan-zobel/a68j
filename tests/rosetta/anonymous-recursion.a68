{ dg-modules "rcprelude" }
{ Rosetta Code, task "Anonymous recursion", ALGOL 68 solution anonymous-recursion.alg.
  https://rosettacode.org/wiki/Anonymous_recursion#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/anonymous-recursion.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
proc fibonacci = ( int x )int:
     if x < 0
     then
         print( ( "negative parameter to fibonacci", newline ) );
         stop
     else
         proc actual_fibonacci = ( int n )int:
             if n < 2
             then
                 n
             else
                 actual_fibonacci( n - 1 ) + actual_fibonacci( n - 2 )
             fi;
         actual_fibonacci( x )
     fi;
)
