{ dg-modules "genietransput" }
{ Rosetta Code, task "Bitwise operations", ALGOL 68 solution bitwise-operations-2.alg.
  https://rosettacode.org/wiki/Bitwise_operations#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/bitwise-operations-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ unpack (widen) some data back into an a BOOL array }
int i := 170;
bits j := BIN i;
[bits_width]bool k := j;

printf(($g", 8r"8r4d", "8(g)l$, i, j, k[bits_width-8+1:]));

{ now pack some data back into an INT }
k[bits_width-8+1:] := (false, true, false, true, false, true, false, true);
j := bits_pack(k);
i := ABS j;

printf(($g", 8r"8r4d", "8(g)l$, i, j, k[bits_width-8+1:]))
)
