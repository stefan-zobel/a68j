{ dg-modules "rcprelude" }
{ Rosetta Code, task "Sorting algorithms/Bubble sort", ALGOL 68 solution sorting-algorithms-bubble-sort.alg.
  https://rosettacode.org/wiki/Sorting_algorithms/Bubble_sort#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sorting-algorithms-bubble-sort.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
mode Data = int;
proc swap = (ref[]Data slice)void:
(
  Data tmp = slice[1];
  slice[1] := slice[2];
  slice[2] := tmp
);

proc sort = (ref[]Data array)void:
(
  bool sorted;
  int shrinkage := 0;
  for size from UPB array - 1 by -1 while
    sorted := true;
    shrinkage +:= 1;
    for i from LWB array to size do
      if array[i+1] < array[i] then
        swap(array[i:i+1]);
        sorted := false
      fi
    od;
    NOT sorted
  do skip od
);

main:(
  [10]int random := (1,6,3,5,2,9,8,4,7,0);

  printf(($"Before: "10(g(3))l$,random));
  sort(random);
  printf(($"After: "10(g(3))l$,random))
)
)
