{ dg-modules "rcprelude" }
{ Rosetta Code, task "Arithmetic-geometric mean", ALGOL 68 solution arithmetic-geometric-mean.alg.
  https://rosettacode.org/wiki/Arithmetic-geometric_mean#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/arithmetic-geometric-mean.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
   proc agm = (long real x, y) long real :
   begin
      if x < long 0.0 OR y < long 0.0 then -long 1.0
      elif x + y = long 0.0 then long 0.0		{ Edge cases }
      else
         long real a := x, g := y;
         long real epsilon := a + g;
         long real next_a := (a + g) / long 2.0, next_g := long_sqrt (a * g);
         long real next_epsilon := ABS (a - g);
         while next_epsilon < epsilon
         do
            print ((epsilon, "   ", next_epsilon, newline));
            epsilon := next_epsilon;
            a := next_a; g := next_g;
            next_a := (a + g) / long 2.0; next_g := long_sqrt (a * g);
            next_epsilon := ABS (a - g)
         od;
         a
      fi
   end;
   printf (($lg(-35,33)l$, agm (long 1.0, long 1.0 / long_sqrt (long 2.0))))
end
)
