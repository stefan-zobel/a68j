{ dg-modules "genietransput" }
{ Rosetta Code, task "Remove vowels from a string", ALGOL 68 solution remove-vowels-from-a-string.alg.
  https://rosettacode.org/wiki/Remove_vowels_from_a_string#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/remove-vowels-from-a-string.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
    { returns s with the vowels removed }
    op DEVOWEL = ( string s )string:
       begin
            [ LWB s : UPB s ]char result;
            int r_pos := LWB result - 1;
            for s_pos from LWB s to UPB s do
                if NOT char_in_string( s[ s_pos ], nil, "aeiouAEIOU" ) then
                    { have a non-vowel - add it to the output }
                    r_pos +:= 1;
                    result[ r_pos ] := s[ s_pos ]
                fi
            od;
            result[ LWB s : r_pos ]
       end { DEVOWEL } ;
    { tests the DEVOWEL operator }
    proc test_devowel = ( string s )void:
         print( ( "<", s, "> -> <", DEVOWEL s, ">", newline ) );
    { some test cases }
    test_devowel( ""                              );
    test_devowel( "aAeEiIoOuU"                    );
    test_devowel( "bcdfghjklmnprstvwxyz"          );
    test_devowel( "abcdefghijklmnoprstuvwxyz"     );
    test_devowel( "Algol 68 Programming Language" )
end
)
