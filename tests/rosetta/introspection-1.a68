access Rc_Prelude (
begin
    print (("Integer range: ", -max_int, " .. ", max_int, new_line));
    print (("Integer digits: ", int_width, new_line));
    print (("Float range: ", -max_real, " .. ", max_real, new_line));
    print (("Float digits: ", real_width, new_line))
end
)
