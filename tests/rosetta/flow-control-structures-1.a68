access Rc_Prelude (
(
   for j to 1000 do
     for i to j-1 do
       if random > 0.999 then
         printf(($"Exited when: i="g(0)", j="g(0)l$,i,j));
         done
       fi
       { etc. }
     od
   od;
 done: empty
);
)
