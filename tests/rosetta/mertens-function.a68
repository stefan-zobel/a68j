{ dg-modules "rcprelude" }
{ Rosetta Code, task "Mertens function", ALGOL 68 solution mertens-function.alg.
  https://rosettacode.org/wiki/Mertens_function#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/mertens-function.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { compute values of the Mertens function                      }
    { Generate Mertens numbers                                      }
    [ 1 : 1000 ]int m;
    m[ 1 ] := 1;
    for n from 2 to UPB m do
        m[ n ] := 1;
        for k from 2 to n do m[ n ] -:= m[ n OVER k ] od
    od;
    { Print table                                                   }
    print( ( "The first 99 Mertens numbers are:", newline ) );
    print( ( "   " ) );
    int left := 9;
    for n to 99 do
        print( ( whole( m[ n ], -3 ) ) );
        if ( left -:= 1 ) = 0 then
            left := 10;
            print( ( newline ) )
        fi
    od;
    { Calculate zeroes and crossings                                }
    int zero  := 0;
    int cross := 0;
    for n from 2 to UPB m do
        if m[ n ] = 0 then
            zero +:= 1;
            if m[ n - 1 ] /= 0 then cross +:= 1 fi
        fi
    od;
    print( ( newline ) );
    print( ( "M(N) is zero      ", whole( zero,  -4 ), " times.", newline ) );
    print( ( "M(N) crosses zero ", whole( cross, -4 ), " times.", newline ) )
end
)
