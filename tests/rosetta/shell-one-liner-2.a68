{ dg-modules "genietransput" }
{ Rosetta Code, task "Shell one-liner", ALGOL 68 solution shell-one-liner-2.alg.
  https://rosettacode.org/wiki/Shell_one-liner#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/shell-one-liner-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
code='print(("Hello", new_line))'
a=/tmp/algol$$ s=/usr/share/algol68toc;
echo -e "PROGRAM algol$$ CONTEXT VOID\nUSE standard\nBEGIN\n$code\nEND\nFINISH\n" > $a.a68 &&
a68toc -lib $s -dir $s -uname TMP -tmp $a.a68 && rm $a.a68 &&
gcc $s/A first.o $a.c  -l{a68s,a68,m,c} -o $a && rm $a.c &&
$a; rm $a
)
