{ dg-modules "genietransput" }
{ Rosetta Code, task "Hello world/Graphical", ALGOL 68 solution hello-world-graphical.alg.
  https://rosettacode.org/wiki/Hello_world/Graphical#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/hello-world-graphical.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
   file window;
   open (window, "Hello!", stand_draw_channel);
   draw_device (window, "X", "600x400");
   draw_erase (window);
   draw_move (window, 0.25, 0.5);
   draw_colour (window, 1, 0, 0);
   draw_text (window, "c", "c", "Goodbye, world!");
   draw_show (window);
   close (window)
end
)
