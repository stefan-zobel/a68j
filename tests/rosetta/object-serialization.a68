{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Object serialization", ALGOL 68 solution object-serialization.alg.
  https://rosettacode.org/wiki/Object_serialization#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/object-serialization.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
mode Entity = struct([6]char name, int creation);
Gformat entity_repr = gfmt ("""Name: ""g"", Created:""g");
mode Person = struct(Entity entity, string email);
Gformat person_repr = gfmtd ("f(@1)"", Email: ""g", skip, (int gfindex) Gformat: case gfindex in entity_repr esac);

Person instance1 := Person(Entity("Cletus", 20080808), "test+1@localhost.localdomain");
print((name of entity of instance1, new_line));

Entity instance2 := Entity("Entity",20111111);
print((name of instance2, new_line));

File target;
int errno := open(target, "rows.dat", stand_back_channel); { open file }

{  Serialise }
put(target,(instance1, new_line, instance2, new_line));
printf((gfmt ("""Serialised...""l")));

close(target); { flush file stream }
errno := open(target, "rows.dat", stand_back_channel); { load again }

{ Unserialise }
Person i1;
Entity i2;
get(target,(i1, new_line, i2, new_line));
printf((gfmt ("""Unserialised...""l")));

printf((person_repr, i1, gfmt ("l")));
printf((entity_repr, i2, gfmt ("l")))
)
