{ dg-modules "genietransput" }
{ Rosetta Code, task "Twin primes whose sum is square number", ALGOL 68 solution twin-primes-whose-sum-is-square-number-1.alg.
  https://rosettacode.org/wiki/Twin_primes_whose_sum_is_square_number#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/twin-primes-whose-sum-is-square-number-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find twin primes whose sum is a square, i.e.:                        }
      { find primes p such that p + 2 is prime and p + p + 2 is a square     }

    int max_prime = 10 000 000;         { maximum possible prime to consider }
    proc is_prime = ( int n )bool:
         begin
            bool result := n = 2 OR ( ODD n AND n > 1 );
            for k from 3 by 2 while result AND k * k <= n do result := n MOD k /= 0 od;
            result
         end { is prime } ;

    { if p is a twin prime then we want p where 2p + 2 = x^2 for some x      }
    { x must be even                                                         }
    for x from 2 by 2 to ENTIER sqrt( ( 2 * max_prime ) + 2 ) do
        int x2 = x * x;
        int p = ( x2 - 2 ) OVER 2;
        if is_prime( p ) then
            if is_prime( p + 2 ) then
                string twin_sum = whole( p, -8  ) + " + " + whole( p + 2, 0 );
                int    twin_len = ( UPB twin_sum - LWB twin_sum ) + 1;
                print( ( twin_sum, " " * ( 18 - twin_len ), " = " ) );
                print( ( whole( x, 0 ), "^2", newline ) )
            fi
        fi
    od

end
)
