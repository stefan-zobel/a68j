{ dg-modules "genietransput" }
{ Rosetta Code, task "Strange numbers", ALGOL 68 solution strange-numbers.alg.
  https://rosettacode.org/wiki/Strange_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/strange-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { show some strange numbers - numbers whose digits differ by a prime }
    { returns TRUE if n is strange, FALSE otherwise                        }
    proc is_strange = ( int n )bool:
         begin
            int d1       := ABS n MOD  10;
            int v        := ABS n OVER 10;
            bool strange := true;
            while strange AND v > 0 do
                int d2     = v MOD 10;
                v     OVERAB 10;
                int diff   = ABS ( d1 - d2 );
                strange   := diff = 2 OR diff = 3 OR diff = 5 OR diff = 7;
                d1        := d2
            od;
            strange
         end { is strange } ;
    int s_count := 0;
    for n from 101 to 499 do
        if is_strange( n ) then
            print( ( whole( n, -4 ) ) );
            if ( s_count +:= 1 ) MOD 20 = 0 then print( ( newline ) ) fi
        fi
    od
end
)
