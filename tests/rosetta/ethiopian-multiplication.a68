{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Ethiopian multiplication", ALGOL 68 solution ethiopian-multiplication.alg.
  https://rosettacode.org/wiki/Ethiopian_multiplication#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/ethiopian-multiplication.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
proc halve = (ref int x)void: x := ABS(BIN x SHR 1);
proc doublit = (ref int x)void: x := ABS(BIN x SHL 1);
proc iseven = ({CONST} int x)bool: NOT ODD x;

proc ethiopian = (int in_plier,
              int in_plicand, {CONST} bool tutor)int:
(
  int plier := in_plier, plicand := in_plicand;
  int result:=0;

  if tutor then
    printf((gfmt ("""ethiopian multiplication of ""g(0),"" by ""g(0)l"), plier, plicand)) fi;

  while plier >= 1 do
    if iseven(plier) then
      if tutor then printf((gfmt (""" ""4d,""  ""6d"" struck""l"), plier, plicand)) fi
    else
      if tutor then printf((gfmt (""" ""4d,""  ""6d"" kept""l"), plier, plicand)) fi;
      result +:= plicand
    fi;
    halve(plier); doublit(plicand)
  od;
  result
);

main:
(
  printf((gfmt ("g(0)l"), ethiopian(17, 34, true)))
)
)
