{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Cholesky decomposition", ALGOL 68 solution cholesky-decomposition.alg.
  https://rosettacode.org/wiki/Cholesky_decomposition#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/cholesky-decomposition.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
{!/usr/local/bin/a68g --script }

mode Field=long real;
proc (Field)Field field_sqrt = long_sqrt;
int field_prec = 5;
Gformat field_fmt = gfmtd ("g(@1,@2)", (int gfindex) int: case gfindex in -(2+1+field_prec), field_prec esac, skip);

mode Mat = [0,0]Field;

proc cholesky = (Mat a) Mat:(
    [UPB a, 2 UPB a]Field l;

    for i from LWB a to UPB a do
        for j from 2 LWB a to i do
            Field s := 0;
            for k from 2 LWB a to j-1 do
                s +:= l[i,k] * l[j,k]
            od;
            l[i,j] := if i = j
                      then field_sqrt(a[i,i] - s)
                      else 1.0 / l[j,j] * (a[i,j] - s) fi
        od;
        for j from i+1 to 2 UPB a do
            l[i,j]:=0 { Not required if matrix is declared as triangular }
        od
    od;
    l
);

proc print_matrix_v1 =(Mat a)void:(
    for i from LWB a to UPB a do
        for j from 2 LWB a to 2 UPB a do
            printf((gfmtd ("g(@1,@2)", (int gfindex) int: case gfindex in -(2+1+field_prec), field_prec esac, skip), a[i,j]))
        od;
        printf(gfmt ("l"))
    od
);

proc print_matrix =(Mat a)void:(
    Gformat vector_fmt = gfmtd ("""(""f(@1)n(@1)("", "" f(@2))"")""", (int gfindex) int: case gfindex in 2 UPB a-2 LWB a esac, (int gfindex) Gformat: case gfindex in field_fmt, field_fmt esac);
    Gformat matrix_fmt = gfmtd ("""(""f(@1)n(@1)("",""lxf(@2))"")""", (int gfindex) int: case gfindex in  UPB a-  LWB a esac, (int gfindex) Gformat: case gfindex in vector_fmt, vector_fmt esac);
    printf((matrix_fmt, a))
);

main: (
    Mat m1 = ((25, 15, -5),
              (15, 18,  0),
              (-5,  0, 11));
    Mat c1 = cholesky(m1);
    print_matrix(c1);
    printf(gfmt ("l"));

    Mat m2 = ((18, 22,  54,  42),
              (22, 70,  86,  62),
              (54, 86, 174, 134),
              (42, 62, 134, 106));
    Mat c2 = cholesky(m2);
    print_matrix(c2)
)
)
