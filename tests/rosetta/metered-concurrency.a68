{ dg-modules "rcprelude" }
{ Rosetta Code, task "Metered concurrency", ALGOL 68 solution metered-concurrency.alg.
  https://rosettacode.org/wiki/Metered_concurrency#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/metered-concurrency.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
sema sem = LEVEL 1;

proc job = (int n)void: (
   printf(($" Job "d" acquired Semaphore ..."$,n));
   to 10000000 do skip od;
   printf(($" Job "d" releasing Semaphore"l$,n))
);

par (
  ( DOWN sem ; job(1) ; UP sem ) ,
  ( DOWN sem ; job(2) ; UP sem ) ,
  ( DOWN sem ; job(3) ; UP sem )
)
)
