{ dg-modules "rcprelude" }
{ Rosetta Code, task "Random numbers", ALGOL 68 solution random-numbers.alg.
  https://rosettacode.org/wiki/Random_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/random-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
proc random_normal = real:  { normal distribution, centered on 0, std dev 1 }
(
  sqrt(-2*log(random)) * cos(2*pi*random)
);

test:(
  [1000]real rands;
  for i to UPB rands do
    rands[i] := 1 + random_normal/2
  od;
  int limit=10;
  printf(($"("n(limit-1)(-d.6d",")-d.5d" ... )"$, rands[:limit]))
)
)
