{ dg-modules "rcprelude" }
{ Rosetta Code, task "Greatest element of a list", ALGOL 68 solution greatest-element-of-a-list.alg.
  https://rosettacode.org/wiki/Greatest_element_of_a_list#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/greatest-element-of-a-list.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
mode Flt = real; { substitute any array type with ">" defined }

proc max = ([]Flt item, proc void raise_empty_array)Flt:
begin
   if LWB item > UPB item then
      raise_empty_array; skip
   else
     Flt max_element := item[LWB item];

     for i from LWB item + 1 to UPB item do
       if item[i] > max_element then
         max_element := item[i]
       fi
     od;
     max_element
   fi
end { max };

{test}(
  []Flt buf = (-275.0, -111.19, 0.0, -1234568.0, pi, -pi);
  { handle an exception for the case of an empty array }
  proc have_empty_array = void:print(("empty array", newline));

  print((max(buf,have_empty_array),new_line))
)
end
)
