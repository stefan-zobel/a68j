{ dg-modules "rcprelude" }
{ Rosetta Code, task "Arithmetic derivative", ALGOL 68 solution arithmetic-derivative-1.alg.
  https://rosettacode.org/wiki/Arithmetic_derivative#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/arithmetic-derivative-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin proc lagarias = (long int n) long int: { Lagarias arithmetic derivative }
           if n < 0
           then -lagarias (-n)
           elif n = 0 OR n = 1
           then 0
           elif proc small_pf = (long int j, k) long int: { Smallest prime factor }
                     (j %* k = 0 | k | small_pf (j, k + 1));
                long int f = small_pf (n, 2); long int q = n % f;
                q = 1
           then 1
           else q * lagarias (f) + f * lagarias (q)
           fi;

      for n from -99 to 100
      do print (("D(", whole (n, 0), ") = ", whole (lagarias (n), 0), new_line))
      od;
      new_line (standout);
      for n to 20
      do long int m = long 10 ^ n;
         print (("D(", whole (m, 0), ") / 7 = ", whole (lagarias (m) % 7, 0), new_line))
      od
end
)
