access Rc_Prelude (
  mode Objlink = struct(
    ref Objlink next,
    ref Objlink prev,
    OBJVALUE value { ... etc. required }
  );
  proc obj_link_new = ref Objlink: heap Objlink;
  proc obj_link_free = (ref Objlink free)void: skip
)
