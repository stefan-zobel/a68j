{ dg-modules "rcprelude" }
{ Rosetta Code, task "Specific characters", ALGOL 68 solution specific-characters.alg.
  https://rosettacode.org/wiki/Specific_characters#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/specific-characters.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
proc specific_characters = ([]string ss) []int:
  begin
    proc count_and_erase = (ref string s, char ch) int:
      begin
        int count := 0, pos;
        while char_in_string(ch, pos, s) do
          count +:= 1;
          s[pos] := REPR 0
        od;
        count
      end;

    [UPB ss]int result;

    for i to UPB ss do
      result[i] := 0;
      string s := ss[i];
      for j to UPB s - 1 do
        char ch = s[j];
        if ch /= REPR 0 then
          int count = count_and_erase(s, ch);
          if count = 2 then
            bool unique := true;
            for k to UPB ss do
              if k /= i then
                unique := unique AND ~char_in_string(ch, loc int, ss[k])
              fi
             od;
             if unique then result[i] +:= 1 fi
           fi
         fi
       od
     od;
     result
   end;

print((specific_characters(("ahwiueshaiu", "ajxxfioaaf", "ajrdsfroiwr")), new_line))
)
