{ dg-modules "rcprelude" }
{ Rosetta Code, task "Special variables", ALGOL 68 solution special-variables-2.alg.
  https://rosettacode.org/wiki/Special_variables#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/special-variables-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
{!/usr/local/bin/a68g --script }

printf(($g": [", g, "] & [",g,"]"l$,
  "Math constants", "long","long long",
    "pi", long_pi, long_long_pi,
  "Physical Constants", "mksa","cgs",
