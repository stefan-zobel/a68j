{ dg-modules "rcprelude" }
{ Rosetta Code, task "Partial function application", ALGOL 68 solution partial-function-application.alg.
  https://rosettacode.org/wiki/Partial_function_application#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/partial-function-application.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
mode Set = flex[0]int;

mode F = proc(int)int,
     Fs = proc(Set)Set;

proc fs = (F f, Set set)Set: (
  [LWB set:UPB set]int out_;
  for i from LWB set to UPB set do out_[i]:=f(set[i]) od;
  out_
);

proc f1 = (int value)int: value * 2,
     f2 = (int value)int: value ** 2;

Fs fsf1 = fs(f1,),
   fsf2 = fs(f2,);

[4]int set;
FORMAT set_fmt = $"("n(UPB set-LWB set)(g(0)", ")g(0)")"l$;

set := (0, 1, 2, 3);
  printf((set_fmt, fsf1((0, 1, 2, 3)))); { prints (0, 2, 4, 6) }
  printf((set_fmt, fsf2((0, 1, 2, 3)))); { prints (0, 1, 4, 9) }

set := (2, 4, 6, 8);
  printf((set_fmt, fsf1((2, 4, 6, 8)))); { prints (4, 8, 12, 16) }
  printf((set_fmt, fsf2((2, 4, 6, 8))))  { prints (4, 16, 36, 64) }
)
