{ dg-modules "genietransput" }
{ Rosetta Code, task "Golden ratio/Convergence", ALGOL 68 solution golden-ratio-convergence.alg.
  https://rosettacode.org/wiki/Golden_ratio/Convergence#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/golden-ratio-convergence.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { calculate the Golden Ratio and show the number of iterations required }

  int  count := 0;
  real phi0  := 1, diff := 1e20;

  while 1e-5 < diff do
      real phi1 = 1.0 + ( 1.0 / phi0 );
      diff     := ABS ( phi1 - phi0 );
      phi0     := phi1;
      count   +:= 1
  od;

  print( ( "Result:", fixed( phi0, -9, 6 ), " after ", whole( count, 0 ), " iterations", newline ) );
  print( ( "The error is approximately ", fixed( phi0 - ( 0.5 * ( 1 + sqrt( 5 ) ) ), -9, 6 ), newline ) )

end
)
