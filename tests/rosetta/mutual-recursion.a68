{ dg-modules "genietransput" }
{ Rosetta Code, task "Mutual recursion", ALGOL 68 solution mutual-recursion.alg.
  https://rosettacode.org/wiki/Mutual_recursion#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/mutual-recursion.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
proc (int)int m; { ONLY required for ELLA ALGOL 68RS - an official subset OF full ALGOL 68 }

proc f = (int n)int:
  if n = 0 then 1
  else n - m(f(n-1)) fi;

m := (int n)int:
  if n = 0 then 0
  else n - f(m(n-1)) fi;

main:
(
  for i from 0 to 19 do
    print(whole(f(i),-3))
  od;
  new_line(stand_out);
  for i from 0 to 19 do
    print(whole(m(i),-3))
  od;
  new_line(stand_out)
)
)
