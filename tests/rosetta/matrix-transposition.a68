{ dg-modules "rcprelude" }
{ Rosetta Code, task "Matrix transposition", ALGOL 68 solution matrix-transposition.alg.
  https://rosettacode.org/wiki/Matrix_transposition#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/matrix-transposition.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
main:(

  [,]real m=((1,  1,  1,   1),
             (2,  4,  8,  16),
             (3,  9, 27,  81),
             (4, 16, 64, 256),
             (5, 25,125, 625));

  op ZIP = ([,]real in_)[,]real:(
    [2 LWB in_:2 UPB in_,1 LWB in_:1 UPB in_]real out_;
    for i from LWB in_ to UPB in_ do
       out_[,i]:=in_[i,]
    od;
    out_
  );

  proc pprint = ([,]real m)void:(
    FORMAT real_fmt = $g(-6,2)$; { width of 6, with no '+' sign, 2 decimals }
     FORMAT vec_fmt = $"("n(2 UPB m-1)(f(real fmt)",")f(real fmt)")"$;
    FORMAT matrix_fmt = $x"("n(UPB m-1)(f(vec fmt)","lxx)f(vec fmt)");"$;
    { finally print the result }
    printf((matrix_fmt,m))
  );

  printf(($x"Transpose:"l$));
  pprint((ZIP m))
)
)
