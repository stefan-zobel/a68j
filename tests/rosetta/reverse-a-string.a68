{ dg-modules "rcprelude" }
{ Rosetta Code, task "Reverse a string", ALGOL 68 solution reverse-a-string.alg.
  https://rosettacode.org/wiki/Reverse_a_string#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/reverse-a-string.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
proc reverse = (ref string s)void:
  for i to UPB s OVER 2 do
    char c = s[i];
    s[i] := s[UPB s - i + 1];
    s[UPB s - i + 1] := c
  od;

main:
(
  string text := "Was it a cat I saw";
  reverse(text);
  print((text, new_line))
)
)
