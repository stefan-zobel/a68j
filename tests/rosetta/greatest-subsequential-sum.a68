{ dg-modules "rcprelude" }
{ Rosetta Code, task "Greatest subsequential sum", ALGOL 68 solution greatest-subsequential-sum.alg.
  https://rosettacode.org/wiki/Greatest_subsequential_sum#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/greatest-subsequential-sum.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
(
        []int a = (-1 , -2 , 3 , 5 , 6 , -2 , -1 , 4 , -4 , 2 , -1);

        int begin_max, end_max, max_sum, sum;

        sum := 0;
        begin_max := 0;
        end_max := -1;
        max_sum := 0;


        for begin_ from LWB a to UPB a do
                sum := 0;
                for end_ from begin_ to UPB a do
                        sum +:= a[end_];
                        if sum > max_sum then
                                max_sum := sum;
                                begin_max := begin_;
                                end_max := end_
                        fi
                od
        od;

        for i from begin_max to end_max do
                print((" ",whole(a[i],0)))
        od

)
)
