{ dg-modules "genietransput" }
{ Rosetta Code, task "Semiprime", ALGOL 68 solution semiprime.alg.
  https://rosettacode.org/wiki/Semiprime#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/semiprime.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ returns TRUE if n is semi-prime, FALSE otherwise            }
{         n is semi prime if it has exactly two prime factors }
proc is_semiprime = ( int n )bool:
     begin
         { We only need to consider factors between 2 and     }
         { sqrt( n ) inclusive. If there is only one of these }
         { then it must be a prime factor and so the number   }
         { is semi prime                                      }
         int factor_count := 0;
         for factor from 2 to ENTIER sqrt( ABS n )
         while factor_count < 2 do
             if n MOD factor = 0 then
                 factor_count +:= 1;
                 { check the factor isn't a repeated factor   }
                 if n /= factor * factor then
                     { the factor isn't the square root       }
                     int other_factor = n OVER factor;
                     if other_factor MOD factor = 0 then
                         { have a repeated factor             }
                         factor_count +:= 1
                     fi
                 fi
             fi
         od;
         factor_count = 1
     end { is semiprime } ;

{ determine the first few semi primes                          }
print( ( "semi primes below 100:", newline, "   " ) );
for i to 99 do
    if is_semi_prime( i ) then print( ( " ", whole( i, 0 ) ) ) fi
od;
print( ( newline ) );
print( ( "semi primes between 1670 and 1690: " ) );
for i from 1670 to 1690 do
    if is_semi_prime( i ) then print( ( whole( i, 0 ), " " ) ) fi
od;
print( ( newline ) )
)
