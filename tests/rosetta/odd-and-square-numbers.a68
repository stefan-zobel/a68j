{ dg-modules "genietransput" }
{ Rosetta Code, task "Odd and square numbers", ALGOL 68 solution odd-and-square-numbers.alg.
  https://rosettacode.org/wiki/Odd_and_square_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/odd-and-square-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { print odd suares between 100 and 1000 }
    { if 2m + 1 and 2m - 1 are consecutive odd numbers, the difference between their squares is 8m }
    int to_next    := 8;
    int odd_square := 1;
    while odd_square < 1000 do
        if odd_square > 99 then
            print( ( " ", whole( odd_square, 0 ) ) )
        fi;
        odd_square +:= to_next;
        to_next    +:= 8
    od
end
)
