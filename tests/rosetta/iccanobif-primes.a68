{ dg-modules "genietransput" }
{ Rosetta Code, task "Iccanobif primes", ALGOL 68 solution iccanobif-primes.alg.
  https://rosettacode.org/wiki/Iccanobif_primes#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/iccanobif-primes.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { show the first 10 prime Iccanobif (reversed Fibonacci) numbers       }
    { returns n with the digits reversed                                     }
    op REVERSE = ( int n )int:
       begin
            int reverse := 0;
            int v       := ABS n;
            while v > 0 do
                reverse *:= 10 +:= v MOD 10;
                v OVERAB 10
            od;
            if n < 0 then - reverse else reverse fi
       end { REVERSE } ;
    { returns TRUE if n is prime, FALSE otherwise - uses trial division      }
    proc is_prime = ( long int n )bool:
         if   n < 3       then n = 2
         elif n MOD 3 = 0 then n = 3
         elif NOT ODD n   then false
         else
             bool is_a_prime := true;
             int  f          := 5;
             int  f2         := 25;
             int  to_next    := 24;
             while f2 <= n AND is_a_prime do
                 is_a_prime := n MOD f /= 0;
                 f         +:= 2;
                 f2        +:= to_next;
                 to_next   +:= 8
             od;
             is_a_prime
         fi { is prime } ;
    { task                                                                   }
    int p_count := 0;
    int prev    := 0;
    int curr    := 1;
    while p_count < 10 do
        int next = prev + curr;
        prev    := curr;
        curr    := next;
        int rev := REVERSE curr;
        if is_prime( rev ) then
            { have a prime iccanobif number }
            p_count +:= 1;
            print( ( " ", whole( rev, 0 ) ) )
        fi
    od
end
)
