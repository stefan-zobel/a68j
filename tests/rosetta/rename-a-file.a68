{ dg-modules "rcprelude" }
{ Rosetta Code, task "Rename a file", ALGOL 68 solution rename-a-file.alg.
  https://rosettacode.org/wiki/Rename_a_file#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/rename-a-file.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
main:(
  proc rename = (string source_name, dest_name)int:
  begin
    file actual_file;
    int errno = open(actual_file, source_name, stand_back_channel);
    if errno NE 0 then
      errno
    else
      if reidf_possible(actual_file) then
        reidf(actual_file, dest_name); { change the identification of the book }
        errno
      else
        close(actual_file);
        -1
      fi
    fi
  end;
  rename("input.txt", "output.txt");
  rename("/input.txt", "/output.txt");
  rename("docs", "mydocs");
  rename("/docs", "/mydocs")
)
)
