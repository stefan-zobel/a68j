{ dg-modules "rcprelude" }
{ Rosetta Code, task "Lempel?Ziv complexity", ALGOL 68 solution lempel-ziv-complexity.alg.
  https://rosettacode.org/wiki/Lempel%E2%80%93Ziv_complexity#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/lempel-ziv-complexity.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { Lempel-Ziv complexity                                                }

    { MODE to hold the results of LZ                                         }
    mode Lzcomplexity = struct( int complexity, string substrings );

    { returns the LZ complexity of str and the substrings                    }
    op   LZ = ( string str )Lzcomplexity:
         begin
            int n           = ( UPB str - LWB str ) + 1;
            int complexity := 0;
            string subs    := "";
            if n > 0 then
                int i := 0, u := 1, v := 1;
                int vmax   := v;
                complexity := 1;
                subs := str[ 1 ];
                while u + v <= n do
                    if str[ i + v ] = str[ u + v ] then
                        v +:= 1
                    else
                        if v > vmax then vmax := v fi;
                        i +:= 1;
                        if i = u then
                            complexity +:= 1;
                            subs +:= "." + str[ u + 1 : u + vmax ];
                            u   +:= vmax;
                            i    := 0;
                            vmax := 1
                        fi;
                        v := 1
                    fi
                od;
                if v /= 1 then
                    complexity +:= 1;
                    subs +:= "." + str[ u + 1 : n ]
                fi
            fi;
            ( complexity, subs )
         end { LZ } ;

    { left pads s with blanks to w characters                                 }
    prio PAD = 8;
    op   PAD = ( int w, string s )string:
         if   int len = ( UPB s - LWB s ) + 1;
              len >= w
         then s
         else ( ( w - len ) * " " ) + s
         fi { PAD } ;

    begin { test cases                                                       }
        print( ( "                          String  LZ Substrings", newline ) );
        print( ( "================================ === " ) );
        print( ( "=================================================", newline ) );
        mode Tcase = struct( string str, int expected );
        []Tcase tests = ( ( "AZSEDRFTGYGUJIJOKB",         16 )
                        , ( "ABCABCABCABCABCABC",          4 )
                        , ( "111011111001111011111001",    6 )
                        , ( "101001010010111110",          5 )
                        , ( "1001111011000010",            6 )
                        , ( "1010101010",                  3 )
                        , ( "1010101010101010",            3 )
                        , ( "1001111011000010000010",      7 )
                        , ( "100111101100001000001010",    8 )
                        , ( "0001101001000101",            6 )
                        , ( "1111111",                     2 )
                        , ( "0001",                        2 )
                        , ( "010",                         3 )
                        , ( "1",                           1 )
                        , ( "",                            0 )
                        , ( "01011010001101110010",        7 )
                        , ( "ABCDEFGHIJKLMNOPQRSTUVWXYZ", 26 )
                        , ( "HELLO WORLD! HELLO WORLD! HELLO WORLD! HELLO WORLD!"
                          , 11
                          )
                        );

        for t_pos from LWB tests to UPB tests do
            string str   =      str of tests[ t_pos ];
            int expected = expected of tests[ t_pos ];
            Lzcomplexity lzc = LZ str;
            if complexity of lzc /= expected then
                print( ( "**** expected complexity ", whole( expected, 0 ) ) );
                print( ( " for """, str, """ got ", whole( complexity of lzc, 0 ), newline ) )
            fi;
            if ( UPB str - LWB str ) + 1 <= 32 then
                print( ( 32 PAD str ) )
            else
                print( ( str, newline, 32 PAD "->" ) )
            fi;
            print( ( " ",  whole( complexity of lzc, -3 ), " ", substrings of lzc, newline ) )
        od
    end
end
)
