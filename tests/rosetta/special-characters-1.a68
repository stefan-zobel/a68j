  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
printf((gfmt ("""flip:""g""!""l"),flip));
printf((gfmt ("""flop:""g""!""l"),flop));
printf((gfmt ("""blank:""g""!""l"),blank));
printf((gfmt ("""error char:""g""!""l"),error_char));
printf((gfmt ("""null character:""g""!""l"),null_character))
)
