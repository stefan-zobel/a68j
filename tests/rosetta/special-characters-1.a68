access Genie_Transput (
printf(($"flip:"g"!"l$,flip));
printf(($"flop:"g"!"l$,flop));
printf(($"blank:"g"!"l$,blank));
printf(($"error char:"g"!"l$,error_char));
printf(($"null character:"g"!"l$,null_character))
)
