access Genie_Transput (
mode Foo = struct(char u,l);
int n := 26;
[n]Foo f;

{ Additionally each item can be initialised }
for i to UPB f do f[i] := (REPR(ABS("A")-1+i), REPR(ABS("a")-1+i))  od;

print((f, new_line))
)
