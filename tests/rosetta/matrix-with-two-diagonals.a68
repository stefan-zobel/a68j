{ dg-modules "rcprelude" }
{ Rosetta Code, task "Matrix with two diagonals", ALGOL 68 solution matrix-with-two-diagonals.alg.
  https://rosettacode.org/wiki/Matrix_with_two_diagonals#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/matrix-with-two-diagonals.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { draw a matrix with 1s on the diagonals and 0s elsewhere         }
    { draws a matrix with height and width = n with 1s on the diagonals }
    proc draw_2_diagonals = ( int n )void:
         begin
            int l_pos := 1;
            int r_pos := n;
            to n do
                for j to n do
                    print( ( " ", whole( ABS ( j = l_pos OR j = rpos ), 0 ) ) )
                od;
                print( ( newline ) );
                l_pos +:= 1;
                r_pos -:= 1
            od
         end { draw 2 diagonals } ;
    { test the draw 2 diagonals procedure }
    draw_2_diagonals( 10 );
    print( ( newline ) );
    draw_2_diagonals( 11 )
end
)
