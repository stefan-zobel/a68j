{ dg-modules "genietransput" }
{ Rosetta Code, task "Map range", ALGOL 68 solution map-range.alg.
  https://rosettacode.org/wiki/Map_range#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/map-range.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ maps a real s in the range [ a1, a2 ] to the range [ b1, b2 ]           }
{ there are no checks that s is in the range or that the ranges are valid }
proc map_range = ( real s, a1, a2, b1, b2 )real:
    b1 + ( ( s - a1 ) * ( b2 - b1 ) ) / ( a2 - a1 );

{ test the mapping }
for i from 0 to 10 do
    print( ( whole( i, -2 ), " maps to ", fixed( map_range( i, 0, 10, -1, 0 ), -8, 2 ), newline ) )
od
)
