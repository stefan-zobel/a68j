{ dg-modules "genietransput" }
{ Rosetta Code, task "McNuggets problem", ALGOL 68 solution mcnuggets-problem.alg.
  https://rosettacode.org/wiki/McNuggets_problem#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/mcnuggets-problem.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
    { Solve the McNuggets problem: find the largest n <= 100 for which there }
    { are no non-negative integers x, y, z such that 6x + 9y + 20z = n       }
    int max_nuggets = 100;
    [ 0 : max_nuggets ]bool sum;
    for i from LWB sum to UPB sum do sum[ i ] := false od;
    for x from 0 by 6 to max_nuggets do
        for y from x by 9 to max_nuggets do
            for z from y by 20 to max_nuggets do
                sum[ z ] := true
            od { z }
        od { y }
    od { x } ;
    { show the highest number that cannot be formed                          }
    int largest := max_nuggets;
    while sum[ largest ] do largest -:= 1 od;
    print( ( "The largest non McNugget number is: "
           , whole( largest, 0 )
           , newline
           )
         )
end
)
