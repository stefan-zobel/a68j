{ dg-modules "genietransput" }
{ Rosetta Code, task "Unique characters", ALGOL 68 solution unique-characters-2.alg.
  https://rosettacode.org/wiki/Unique_characters#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/unique-characters-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ helper functions }

proc concat = ([]string strs)string:
  begin
    string result := "";
    for i from LWB strs to UPB strs do
      result +:= strs[i]
    od;
    result
  end;

proc qsort = (ref string s, int lo, hi)void:
  if lo < hi then
    int partition =
      begin
        char pivot = s[(lo + hi) % 2]; int i := lo - 1, j := hi + 1;
        do
          while i +:= 1; i <= hi AND s[i] < pivot do skip od;
          while j -:= 1; j >= lo AND s[j] > pivot do skip od;
          if i >= j then return fi;
          char tmp = s[i]; s[i] := s[j]; s[j] := tmp
        od;
        return: j
      end;
    qsort(s, lo, partition);
    qsort(s, partition+1, hi)
  fi;

{ actual solution }

string str := concat(("133252abcdeeffd",  "a6789798st",  "yxcdfgxcyz"));
qsort(str, 1, UPB str);

string unique := "";
char ch := REPR 0;
int count := 0;

for i from 1 to UPB str do
  if str[i] = ch then
    count +:= 1
  else
    if count = 1 then unique +:= ch fi;
    ch := str[i]; count := 1
  fi
od;
if count = 1 then unique +:= ch fi;

print((unique, new_line))
)
