access Rc_Prelude (
----------------- SUM DIGITS of AN INTEGER -----------------

-- base D igit S um :: I nt -> I nt -> I nt_on_base
D igit S um(base)
    script_on
 |λ|(n)
            script_go_on
 |λ|(x)
                    if_0 < x_then
                        J ust({x mod base, x div base})
                    else_
                        N othing()
                    end_if_end
 |λ|
            end_script_sum
(unfoldl(go_, n))
        end_ |λ|
    end_script_end_base
D igit S um


--------------------------- TEST ---------------------------
on_run
    {ap(map(baseDigitSum, {2, 8, 10, 16}), {255}), ¬
        ap(map(baseDigitSum, {10}), {1, 1234}), ¬
        ap(map(baseDigitSum, {16}), map(readHex, {"0xfe", "0xf0e"}))}

    --> {{8, 17, 12, 30}, {1, 10}, {29, 29}}
end_run


