{ dg-modules "rcprelude" }
{ Rosetta Code, task "Pernicious numbers", ALGOL 68 solution pernicious-numbers.alg.
  https://rosettacode.org/wiki/Pernicious_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/pernicious-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
{ calculate various pernicious numbers                          }

{ returns the population (number of bits on) of the non-negative integer n    }
proc population = ( int n )int:
     begin
        int    number := n;
        int    result := 0;
        while number > 0 do
            if ODD number then result +:= 1 fi;
            number OVERAB 2
        od;
        result
     end { population } ;

{ as we are dealing with 32 bit numbers, the maximum possible population is 32 }
{ so we only need a table of whether the integers 0 : 32 are prime or not      }
{ we use the sieve of Eratosthenes...                                          }
int max_number = 32;
[ 0 : max_number ]bool is_prime;
is_prime[ 0 ] := false;
is_prime[ 1 ] := false;
for i from 2 to max_number do is_prime[ i ] := true od;
for i from 2 to ENTIER sqrt( max_number ) do
    if is_prime[ i ] then for p from i * i by i to max_number do is_prime[ p ] := false od fi
od;

{ returns TRUE if n is pernicious, FALSE otherwise                             }
proc is_pernicious = ( int n )bool: is_prime[ population( n ) ];

{ find the first 25 pernicious numbers, 0 and 1 are not pernicious             }
int pernicious_count := 0;
for i from 2 while pernicious_count < 25 do
    if is_pernicious( i ) then
        { found a pernicious number }
        print( ( whole( i, 0 ), " " ) );
        pernicious_count +:= 1
    fi
od;
print( ( newline ) );

{ find the pernicious numbers between 888 888 877 and 888 888 888              }
for i from 888 888 877 to 888 888 888 do
    if is_pernicious( i ) then
        print( ( whole( i, 0 ), " " ) )
    fi
od;
print( ( newline ) )
)
