{ dg-modules "genietransput" }
{ Rosetta Code, task "Anti-primes", ALGOL 68 solution anti-primes.alg.
  https://rosettacode.org/wiki/Anti-primes#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/anti-primes.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find some anti-primes: numbers with more divisors than the     }
      { previous numbers                                               }
    heap[ 1 : 0 ]int empty_list;
    ref[]int ndc     := empty_list;       { table of divisor counts    }
    int max_divisors := 0;
    int a_count      := 0;
    for n while a_count < 20 do
        if n > UPB ndc then
            { need a bigger table of divisor counts                    }
            ndc := heap[ 1 : UPB ndc + 5 000 ]int;
            for i from 1 to UPB ndc do ndc[ i ] := 1 od;
            for i from 2 to UPB ndc do
                for j from i by i to UPB ndc do ndc[ j ] +:= 1 od
            od
        fi;
        if ndc[ n ] > max_divisors then
            print( ( " ", whole( n, 0 ) ) );
            max_divisors := ndc[ n ];
            a_count     +:= 1
        fi
    od;
    print( ( newline ) )
end
)
