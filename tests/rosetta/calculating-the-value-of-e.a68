{ dg-modules "genietransput" }
{ Rosetta Code, task "Calculating the value of e", ALGOL 68 solution calculating-the-value-of-e.alg.
  https://rosettacode.org/wiki/Calculating_the_value_of_e#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/calculating-the-value-of-e.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
    { calculate an approximation to e }
    long real epsilon = 1.0e-15;
    long int  f := 1;
    long real e := 2;
    long int  n := 2;
    while
        long real e0 = e;
        f *:= n;
        n +:= 1;
        e +:= 1.0 / f;
        ABS ( e - e0 ) >= epsilon
    do skip od;
    print( ( "e = ", fixed( e, -17, 15 ), newline ) )
end
)
