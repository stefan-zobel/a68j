{ dg-modules "rcprelude" }
{ Rosetta Code, task "Loops/Increment loop index within loop body", ALGOL 68 solution loops-increment-loop-index-within-loop-body.alg.
  https://rosettacode.org/wiki/Loops/Increment_loop_index_within_loop_body#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/loops-increment-loop-index-within-loop-body.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    { returns TRUE if n is prime, FALSE otherwise }
    proc is_prime = ( long int n )bool:
         if   n MOD 2 = 0 then n = 2
         elif n MOD 3 = 0 then n = 3
         else
            long int d := 5;
            bool result := true;
            while if   d * d > n   then false
                  elif n MOD d = 0 then result := false
                  elif d +:= 2;
                       n MOD d = 0 then result := false
                  else d +:= 4; true
                  fi
            do skip od;
            result
         fi { is prime } ;

    long int count := 0;
    long int i     := 42;
    while count < 42 do
        if is_prime( i ) then
            count +:= 1;
            print( ( "n = "
                   , whole( count,  -2 )
                   , "  "
                   , whole( i, -19 )
                   , newline
                   )
                 );
            i +:= i - 1
        fi;
        i +:= 1
    od
end
)
