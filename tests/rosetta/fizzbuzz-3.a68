{ dg-modules "genietransput" }
{ Rosetta Code, task "FizzBuzz", ALGOL 68 solution fizzbuzz-3.alg.
  https://rosettacode.org/wiki/FizzBuzz#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/fizzbuzz-3.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
for i to 100 do
    if  if i MOD 3 = 0 then print( "Fizz" ); false else true fi
    AND if i MOD 5 = 0 then print( "Buzz" ); false else true fi
    then
        print( ( whole( i, 0 ) ) )
    fi;
    print( ( newline ) )
od
)
