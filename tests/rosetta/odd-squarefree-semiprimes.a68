{ dg-modules "genietransput" }
{ Rosetta Code, task "Odd squarefree semiprimes", ALGOL 68 solution odd-squarefree-semiprimes.alg.
  https://rosettacode.org/wiki/Odd_squarefree_semiprimes#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/odd-squarefree-semiprimes.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find some odd square free semi-primes                    }
      { numbers of the form p*q where p =/= q and p, q are prime }
    { reurns a list of primes up to n }
    proc prime_list = ( int n )[]int:
         begin
            { sieve the primes to n }
            int no = 0, yes = 1;
            [ 1 : n ]int p;
            p[ 1 ] := no; p[ 2 ] := yes;
            for i from 3 by 2 to n do p[ i ] := yes od;
            for i from 4 by 2 to n do p[ i ] := no  od;
            for i from 3 by 2 to ENTIER sqrt( n ) do
                if p[ i ] = yes then for s from i * i by i + i to n do p[ s ] := no od fi
            od;
            { replace the sieve with a list }
            int p_pos := 0;
            for i to n do if p[ i ] = yes then p[ p_pos +:= 1 ] := i fi od;
            p[ 1 : p_pos ]
         end { prime list } ;
    { show odd square free semi-primes up to 1000 }
    int max_number = 1000;
    int max_prime  = 1 + ( max_number OVER 3 ); { the smallest odd prime is 3, so this shuld be enough primes }
    []int prime    = prime_list( max_prime );
    [ 1 : max_number ]bool numbers; for i to max_number do numbers[ i ] := false od;
    for i from 2 to UPB prime - 1 do
        for j from i + 1 to UPB prime
        while int pq = prime[ i ] * prime[ j ];
              pq < max_number
        do
            numbers[ pq ] := true
        od
    od;
    int n_count   := 0;
    for i to max_number do
        if numbers[ i ] then
            print( ( " ", whole( i, -4 ) ) );
            n_count +:= 1;
            if n_count MOD 20 = 0 then print( ( newline ) ) fi
        fi
    od
end
)
