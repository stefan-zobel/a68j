{ dg-modules "rcprelude" }
{ Rosetta Code, task "Goodstein Sequence", ALGOL 68 solution goodstein-sequence.alg.
  https://rosettacode.org/wiki/Goodstein_Sequence#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/goodstein-sequence.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { Goodstein sequence - translation of Phix via EasyLang }

    mode Integer = long int;

    proc bump = ( Integer v, b )Integer:
         begin
            Integer n := v, res := 0;
            for i from 0 while n > 0 do
                Integer d = n MOD b;
                if d > 0 then
                    res +:= d * ENTIER ( ( ( b + 1 ) ^ bump( i, b ) ) + 0.5 )
                fi;
                n OVERAB b
            od;
            res
         end { bump } ;

    proc goodstein = ( Integer n, int maxterms )[]Integer:
         begin
            [ 1 : maxterms ]Integer res;
            int len_res := 0;
            if maxterms > 0 then
                res[ len_res +:= 1 ] := n;
                while len_res < maxterms AND res[ len_res ] /= 0 do
                    int cur_len := len_res;
                    res[ len_res +:= 1 ] := bump( res[ cur_len ], cur_len + 1 ) - 1
                od
            fi;
            res[ 1 : len_res ]
         end { goodstein } ;

    begin
        for i from 0 to 7 do
            []Integer gs = goodstein( i, 10 );
            print( ( "[" ) );
            for spos from LWB gs to UPB gs do print( ( " ", whole( gs[ spos ], 0 ) ) ) od;
            print( ( " ]", newline ) )
        od;
        print( ( newline ) );
        for i from 0 to 10 do
            []Integer h = goodstein( i, ( i + 1 ) );
            print( ( whole( h[ UPB h ], 0 ), newline ) )
        od
    end
end
)
