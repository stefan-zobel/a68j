{ dg-modules "genietransput" }
{ Rosetta Code, task "Juggler sequence", ALGOL 68 solution juggler-sequence.alg.
  https://rosettacode.org/wiki/Juggler_sequence#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/juggler-sequence.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { Jugglar sequences - starting with a[0] = n, a[k+1] = floor(sqrt(a[k])) if a[k] is even }
      {                                                    = floor(sqrt(a[k]))*a[k] otherwise  }

    { find the number of terms required to reach a[n] = 1, the maximum value of the sequence   }
    { before it reaches 1 and the index at which the maximum was first reached                 }

    print( ( " n  l[n]            h[n] i[n]", newline ) );
    print( ( "=============================", newline ) );
    for a0 from 20 to 39 do
        long int ak := a0, amax := 0, aindex := 0, mindex := 0;
        while ak /= 1 do
            if amax < ak then
                amax   := ak;
                mindex := aindex
            fi;
            aindex +:= 1;
            long real root_ak = long_sqrt( ak );
            ak := ENTIER if ODD ak then root_ak * ak else root_ak fi
        od;
        print( ( whole( a0, -2 ), whole( aindex, -5 ), whole( amax, -16 ), whole( mindex, -5 ), newline ) )
    od

end
)
