  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
{!/usr/bin/a68g --script }
{ -*- coding: utf-8 -*- }

string dog = "Benjamin";
op D = (int og)string: "Samba";
op DOG = (int gy)string: "Bernie";
int og=~, gy=~;

main:(
  printf(($"The three dogs are named "g", "g" and "g"."l$, dog, D og, DOG gy));
  0
)
)
