{ dg-modules "rcprelude" }
{ Rosetta Code, task "Common list elements", ALGOL 68 solution common-list-elements.alg.
  https://rosettacode.org/wiki/Common_list_elements#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/common-list-elements.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find common elements of lists                                        }

    prio COMMON = 1;
    { returns the common elements of a and b                                 }
    op   COMMON = ( []int a, b )[]int:
         if  int a_len = ( UPB a - LWB a ) + 1;
             int b_len = ( UPB b - LWB b ) + 1;
             a_len < 1 OR b_len < 1
         then                               { one or both lists is/are empty }
             []int()
         elif a_len < b_len
         then                       { both lists are non-empty, b is shorter }
              b COMMON a
         else          { both lists are non-empty, a is at most as long as b }
             [ 1 : b_len ]int result;
             [ LWB a : UPB a ]bool used;
             for i from LWB a to UPB a do used[ i ] := false od;
             int r_pos := 0;
             for b_pos from LWB b to UPB b do
                 bool found := false;
                 for a_pos from LWB a to UPB a while NOT found do
                     if NOT used[ a_pos ] then
                         if ( found := a[ a_pos ] = b[ b_pos ] ) then
                             result[ r_pos +:= 1 ] := b[ b_pos ];
                             used[ a_pos ] := true
                         fi
                     fi
                 od
             od;
             result[ : r_pos ]
         fi { COMMON } ;
    { returns the common elements in the lists in nums                      }
    op   COMMON = ( [][]int nums )[]int:
         if   1 UPB nums < 1 LWB nums then                       { no lists }
             []int()
         elif 1 UPB nums = 1 LWB nums then                  { only one list }
             nums[ LWB nums ]
         else                                           { two or more lists }
             flex[ 1 : 0 ]int result;
             result := nums[ LWB nums ] COMMON nums[ LWB nums + 1 ];
             for i from LWB nums + 2 to UPB nums do
                 result := result COMMON nums[ i ]
             od;
             result
         fi { COMMON } ;

    print( ( COMMON [][]int( ( 2, 5, 1, 3, 8, 9, 4, 6 )
                           , ( 3, 5, 6, 2, 9, 8, 4 )
                           , ( 1, 3, 7, 6, 9 )
                           )
           )
         )
end
)
