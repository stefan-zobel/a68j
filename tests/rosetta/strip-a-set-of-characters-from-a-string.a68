{ dg-modules "rcprelude" }
{ Rosetta Code, task "Strip a set of characters from a string", ALGOL 68 solution strip-a-set-of-characters-from-a-string.alg.
  https://rosettacode.org/wiki/Strip_a_set_of_characters_from_a_string#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/strip-a-set-of-characters-from-a-string.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
{!/usr/local/bin/a68g --script }

proc strip_chars = (string mine, ore)string: (
  string out_ := "";
  for i from LWB mine to UPB mine do
    if NOT char_in_string(mine[i], loc int, ore) then
      out_ +:= mine[i]
    fi
  od;
  out_[@LWB mine]
);

printf(($gl$,stripchars("She was a soul stripper. She took my heart!","aei")))
)
