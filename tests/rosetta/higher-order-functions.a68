{ dg-modules "rcprelude" }
{ Rosetta Code, task "Higher-order functions", ALGOL 68 solution higher-order-functions.alg.
  https://rosettacode.org/wiki/Higher-order_functions#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/higher-order-functions.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
proc first = (proc(long real)long real f) long real:
(
  f(1) + 2
);

proc second = (long real x)long real:
(
  x/2
);

main: (
  printf(($xg(5,2)l$,first(second)))
)
)
