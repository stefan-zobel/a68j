{ dg-modules "rcprelude" }
{ Rosetta Code, task "Frobenius numbers", ALGOL 68 solution frobenius-numbers.alg.
  https://rosettacode.org/wiki/Frobenius_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/frobenius-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find some Frobenius Numbers:                                         }
      {     Frobenius(n) = ( prime(n) * prime(n+1) ) - prime(n) - prime(n+1) }
    { reurns a list of primes up to n }
    proc prime_list = ( int n )[]int:
         begin
            { sieve the primes to n }
            int no = 0, yes = 1;
            [ 1 : n ]int p;
            p[ 1 ] := no; p[ 2 ] := yes;
            for i from 3 by 2 to n do p[ i ] := yes od;
            for i from 4 by 2 to n do p[ i ] := no  od;
            for i from 3 by 2 to ENTIER sqrt( n ) do
                if p[ i ] = yes then for s from i * i by i + i to n do p[ s ] := no od fi
            od;
            { replace the sieve with a list }
            int p_pos := 0;
            for i to n do if p[ i ] = yes then p[ p_pos +:= 1 ] := i fi od;
            p[ 1 : p_pos ]
         end { prime list } ;
    { show Frobenius numbers up to 10 000 }
    int max_number = 10 000;
    []int prime    = prime_list( max_number );
    for i to max_number - 1
    while int frobenius_number = ( ( prime[ i ] * prime[ i + 1 ] ) - prime[ i ] ) - prime[ i + 1 ];
              frobenius_number < max_number
    do
        print( ( " ", whole( frobenius_number, 0 ) ) )
    od
end
)
