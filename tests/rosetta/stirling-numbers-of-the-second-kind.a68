{ dg-modules "genietransput" }
{ Rosetta Code, task "Stirling numbers of the second kind", ALGOL 68 solution stirling-numbers-of-the-second-kind.alg.
  https://rosettacode.org/wiki/Stirling_numbers_of_the_second_kind#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/stirling-numbers-of-the-second-kind.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { show some Stirling numbers of the second kind                        }

    { specify the precision of LONG LONG INT, somewhat under 160 digits are  }
    { needed for Stirling numbers of the second kind with n, k = 100         }
     
    mode Sint = long long int;

    { returns a triangular matrix of Stirling numbers up to max n, max n }
    proc make_s2 = ( int max_n )ref[,]Sint:
    begin
        heap[ 0 : max_n, 0 : max_n ]Sint s2;
        for n from 0 to max_n do for k from 0 to max_n do s2[ n, k ] := 0 od od;
        for n from 0 to max_n do s2[ n, n ] := 1 od;
        for n from 0 to max_n - 1 do
            for k from 1 to n do
                s2[ n + 1, k ] := k * s2[ n, k ] + s2[ n, k - 1 ]
            od
        od;
        s2
    end { make s2 } ;
    { task requirements:                                                     }
    { print Stirling numbers up to n, k = 12                                 }
    begin
        int max_stirling = 12;
        ref[,]Sint s2 = make_s2( max_stirling );
        print( ( "Stirling numbers of the second kind:", newline ) );
        print( ( " k" ) );
        for k from 0 to max_stirling do print( ( whole( k, -8 ) ) ) od;
        print( ( newline, " n", newline ) );
        for n from 0 to max_stirling do
            print( ( whole( n, -2 ) ) );
            for k from 0 to n do
                print( ( whole( s2[ n, k ], -8 ) ) )
            od;
            print( ( newline ) )
        od
    end;
    { find the maximum Stirling number with n = 100                          }
    begin
        int max_stirling = 100;
        ref[,]Sint s2 = make_s2( max_stirling );
        Sint max_100 := 0;
        for k from 0 to max_stirling do
            if s2[ max_stirling, k ] > max_100 then max_100 := s2[ max_stirling, k ] fi
        od;
        print( ( "Maximum Stirling number of the second kind with n = 100:", newline ) );
        print( ( whole( max_100, 0 ), newline ) )
    end
end
)
