{ dg-modules "genietransput" }
{ Rosetta Code, task "Monte Carlo methods", ALGOL 68 solution monte-carlo-methods.alg.
  https://rosettacode.org/wiki/Monte_Carlo_methods#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/monte-carlo-methods.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
proc pi = (int throws)real:
begin
   int inside := 0;
   to throws do
      if random ** 2 + random ** 2 <= 1 then
         inside +:= 1
      fi
   od;
   4 * inside / throws
end { pi };

print (("     10 000:",pi (     10 000),new_line));
print (("    100 000:",pi (    100 000),new_line));
print (("  1 000 000:",pi (  1 000 000),new_line));
print ((" 10 000 000:",pi ( 10 000 000),new_line));
print (("100 000 000:",pi (100 000 000),new_line))
)
