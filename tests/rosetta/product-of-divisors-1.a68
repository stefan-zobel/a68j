{ dg-modules "rcprelude" }
{ Rosetta Code, task "Product of divisors", ALGOL 68 solution product-of-divisors-1.alg.
  https://rosettacode.org/wiki/Product_of_divisors#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/product-of-divisors-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { product of divisors - transaltion of the Fortran sample }
    [ 1 : 50 ]int divis;
    for i to UPB divis do divis[ i ] := 1 od;
    for i from 2 to UPB divis do
        for j from i by i to UPB divis do
            divis[ j ] *:= i
        od
    od;
    for i to UPB divis do
        print( ( whole( divis[ i ], -10 ) ) );
        if i MOD 5 = 0 then print( ( newline ) ) fi
    od
end
)
