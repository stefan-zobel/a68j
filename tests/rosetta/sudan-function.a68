{ dg-modules "rcprelude" }
{ Rosetta Code, task "Sudan function", ALGOL 68 solution sudan-function.alg.
  https://rosettacode.org/wiki/Sudan_function#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sudan-function.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { compute some values of the Sudan function                          }
    proc sudan = ( int n, x, y )int:
         if   n = 0 then x + y
         elif y = 0 then x
         else
             int s = sudan( n, x, y - 1 );
             sudan( n - 1, s, s + y )
         fi { sudan } ;
    for n from 0 to 1 do
        print( ( "Values of F(", whole( n, 0 ), ", x, y):", newline ) );
        print( ( "y/x    0   1   2   3   4   5",            newline ) );
        print( ( "----------------------------",            newline ) );
        for y from 0 to 6 do
            print( ( whole( y, 0 ), "  |" ) );
            for x from 0 to 5 do
                print( ( whole( sudan( n, x, y ), -4 ) ) )
            od;
            print( ( newline ) )
        od;
        print( ( newline ) )
    od;
    print( ( newline ) );
    print( ( "F(2, 1, 1) = ", whole( sudan( 2, 1, 1 ), 0 ), newline ) );
    print( ( "F(3, 1, 1) = ", whole( sudan( 3, 1, 1 ), 0 ), newline ) );
    print( ( "F(2, 2, 1) = ", whole( sudan( 2, 2, 1 ), 0 ), newline ) )
end
)
