{ dg-modules "rcprelude" }
{ Rosetta Code, task "Abundant, deficient and perfect number classifications", ALGOL 68 solution abundant-deficient-and-perfect-number-classifications.alg.
  https://rosettacode.org/wiki/Abundant,_deficient_and_perfect_number_classifications#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/abundant-deficient-and-perfect-number-classifications.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { classify the numbers 1 : 20 000 as abudant, deficient or perfect }
    int abundant_count    := 0;
    int deficient_count   := 0;
    int perfect_count     := 0;
    int max_number         = 20 000;
    { construct a table of the proper divisor sums                 }
    [ 1 : max_number ]int pds;
    pds[ 1 ] := 0;
    for i from 2 to UPB pds do pds[ i ] := 1 od;
    for i from 2 to UPB pds do
        for j from i + i by i to UPB pds do pds[ j ] +:= i od
    od;
    { classify the numbers                                         }
    for n to max_number do
        int pd_sum = pds[ n ];
        if     pd_sum < n then
            deficient_count +:= 1
        elif   pd_sum = n then
            perfect_count   +:= 1
        else { pd sum > n }
            abundant_count  +:= 1
        fi
    od;
    print( ( "abundant  ", whole(  abundant_count, 0 ), newline ) );
    print( ( "deficient ", whole( deficient_count, 0 ), newline ) );
    print( ( "perfect   ", whole(   perfect_count, 0 ), newline ) )
end
)
