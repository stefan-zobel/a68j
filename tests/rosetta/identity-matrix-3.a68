access Rc_Prelude (
{ -*- coding: utf-8 -*- }

prio IDENT = 9; { The same as I for COMPLex }

op IDENT = (int lwb, upb)MATNEW:
  ONEINIT loc [lwb:upb,lwb:upb]SCAL;

op IDENT = (int upb)MATNEW: { default lwb is 1 }
  1 IDENT upb;

skip
)
