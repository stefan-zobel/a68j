{ dg-modules "genietransput" }
{ Rosetta Code, task "Approximate equality", ALGOL 68 solution approximate-equality.alg.
  https://rosettacode.org/wiki/Approximate_equality#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/approximate-equality.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { test REAL values for approximate equality }
    { returns TRUE if value is approximately equal to other, FALSE otherwide }
    proc approx_equals = ( real value, real other, real epsilon )bool: ABS ( value - other ) < epsilon;
    { shows the result of testing a for approximate equality with b }
    proc test = ( real a, b )void:
         begin
            real epsilon = 1e-18;
            print( ( a, ", ", b, " => ", if approx_equals( a, b, epsilon ) then "true" else "false" fi, newline ) )
         end { test } ;
    { task test cases }
    test( 100000000000000.01, 100000000000000.011 );
    test( 100.01, 100.011 );
    test( 10000000000000.001 / 10000.0, 1000000000.0000001000);
    test( 0.001, 0.0010000001 );
    test( 0.000000000000000000000101, 0.0 );
    test(   sqrt( 2 ) * sqrt( 2 ),  2.0 );
    test( - sqrt( 2 ) * sqrt( 2 ), -2.0 );
    test( 3.14159265358979323846, 3.14159265358979324 )
end
)
