{ dg-modules "rcprelude" }
{ Rosetta Code, task "Strip control codes and extended characters from a string", ALGOL 68 solution strip-control-codes-and-extended-characters-from-a-string.alg.
  https://rosettacode.org/wiki/Strip_control_codes_and_extended_characters_from_a_string#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/strip-control-codes-and-extended-characters-from-a-string.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
{ remove control characters and optionally extended characters from the string text  }
{ assums ASCII is the character set                                                  }
proc strip_characters = ( string text, bool strip_extended )string:
     begin
         { we build the result in a []CHAR and convert back to a string at the end }
         int text_start = LWB text;
         int text_max   = UPB text;
         [ text_start : text_max ]char result;
         int result_pos := text_start;
         for text_pos from text_start to text_max do
             int ch := ABS text[ text_pos ];
             if ( ch >= 0 AND ch <= 31 ) OR ch = 127 then
                 { control character }
                 skip
             elif strip_extended AND ( ch > 126 OR ch < 0 ) then
                 { extened character and we don't want them }
                 skip
             else
                 { include this character }
                 result[ result_pos ] := REPR ch;
                 result_pos +:= 1
             fi
         od;
         result[ text_start : result_pos - 1 ]
     end { strip characters } ;

{ test the control/extended character stripping procedure }
string t = REPR 2 + "abc" + REPR 10 + REPR 160 + "def~" + REPR 127 + REPR 10 + REPR 150 + REPR 152 + "!";
print( ( "<<" + t + ">> - without control characters:             <<" + strip_characters( t, false ) + ">>", newline ) );
print( ( "<<" + t + ">> - without control or extended characters: <<" + strip_characters( t, true  ) + ">>", newline ) )
)
