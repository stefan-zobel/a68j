{ dg-modules "rcprelude" }
{ Rosetta Code, task "Sequence: smallest number with exactly n divisors", ALGOL 68 solution sequence:-smallest-number-with-exactly-n-divisors.alg.
  https://rosettacode.org/wiki/Sequence:_smallest_number_with_exactly_n_divisors#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sequence:-smallest-number-with-exactly-n-divisors.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin

    proc count_divisors = ( int n )int:
         begin
            int count := 0;
            for i while i*i <= n do
                if n MOD i = 0 then
                    count +:= if i = n OVER i then 1 else 2 fi
                fi
            od;
            count
         end { count divisors } ;

    int max = 15;
    [ max ]int seq;for i to max do seq[ i ] := 0 od;
    int found := 0;
    for i while found < max do
        if int divisors = count_divisors( i );
           divisors <= max
        then
            { have an i with an appropriate number of divisors                 }
            if seq[ divisors ] = 0 then
                { this is the first i with that many divisors                  }
                seq[ divisors ] := i;
                found          +:= 1
            fi
        fi
    od;
    print( ( "The first ", whole( max, 0 ), " terms of the sequence are:", newline ) );
    for i to max do
        print( ( whole( seq( i ), 0 ), " " ) )
    od;
    print( ( newline ) )

end
)
