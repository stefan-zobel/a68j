{ dg-modules "genietransput" }
{ Rosetta Code, task "Jordan-P?lya numbers", ALGOL 68 solution jordan-p-lya-numbers.alg.
  https://rosettacode.org/wiki/Jordan-P%C3%B3lya_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/jordan-p-lya-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { Jordan-Pólya numbers - translation of XPL0 via EasyLang }

    [ 1 : 11 ]int f; f[ 1 ] := 1; for i from 2 to UPB f do f[ i ] := f[ i - 1 ] * i od;

    proc jpnum = ( int m )bool:
         begin
            bool result := false;
            for limite from UPB f by -1 to 1 while NOT result do
                int n := m, i := limite, fac := f[ limite ];
                while if n MOD fac = 0 then
                          n  OVERAB fac;
                          result := n = 1
                      else
                          fac OVERAB i;
                          i      -:= 1
                      fi;
                      i /= 1 AND NOT result
                do skip od
            od;
            result
         end;

    proc next = ( int n0 )int:
         begin
            int n := n0 + 2;
            while NOT jpnum( n ) do
                n +:= 2
            od;
            n
         end;

    begin
        print( ( "1" ) );
        int n := 0;
        from 2 to 50 do
           n := next( n );
           print( ( " ", whole( n, 0 ) ) )
        od;
        n := 100 000 000;
        while n > 1 AND NOT jpnum( n ) do
            n -:= 2
        od;
        print( ( newline, "The largest Jordan-Pólya number before 100 million: ", whole( n, 0 ), newline ) )
    end
end
)
