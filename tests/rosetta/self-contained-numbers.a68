{ dg-modules "genietransput" }
{ Rosetta Code, task "Self-contained numbers", ALGOL 68 solution self-contained-numbers.alg.
  https://rosettacode.org/wiki/Self-contained_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/self-contained-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find some self-contained numbers: odd numbers whose Collatz sequence }
      {      contains an even multiple of the number itself                  }

    int sc_count := 0;
    for n from 3 by 2 while sc_count < 7 do
        long int v := n;
        while v /= 1 do
            v := ( 3 * v ) + 1;
            while NOT ODD v do v OVERAB 2 od;
            if v MOD n = 0 then
                sc_count +:= 1;
                print( ( " ", whole( n, 0 ) ) );
                v := 1
            fi
        od
    od
end
)
