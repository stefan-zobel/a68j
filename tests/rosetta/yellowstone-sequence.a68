{ dg-modules "rcprelude" }
{ Rosetta Code, task "Yellowstone sequence", ALGOL 68 solution yellowstone-sequence.alg.
  https://rosettacode.org/wiki/Yellowstone_sequence#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/yellowstone-sequence.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find members of the yellowstone sequence: starting from 1, 2, 3 the   }
      { subsequent members are the lowest number coprime to the previous one  }
      { and not coprime to the one before that, that haven't appeared in the  }
      { sequence yet                                                          }
    { iterative Greatest Common Divisor routine, returns the gcd of m and n   }
    proc gcd = ( int m, n )int:
         begin
            int a := ABS m, b := ABS n;
            while b /= 0 do
                int new_a = b;
                b        := a MOD b;
                a        := new_a
            od;
            a
         end { gcd } ;
    { returns an array of the Yellowstone seuence up to n                     }
    op   YELLOWSTONE = ( int n )[]int:
         begin
            [ 1 : n ]int result;
            if n > 0 then
                result[ 1 ] := 1;
                if n > 1 then
                    result[ 2 ] := 2;
                    if n > 2 then
                        result[ 3 ] := 3;
                        { guess the maximum element will be n, if it is larger, used will be enlarged }
                        heap[ 1 : n ]bool initial_used;
                        ref[]bool used := initial_used;
                        used[ 1 ] := used[ 2 ] := used[ 3 ] := true;
                        for i from 4 to UPB used do used[ i ] := false od;
                        for i from 4 to UPB result do
                            int p1      = result[ i - 1 ];
                            int p2      = result[ i - 2 ];
                            bool found := false;
                            for j while NOT found do
                                if j > UPB used then
                                    { not enough elements in used - enlarge it }
                                    heap[ 1 : 2 * UPB used ]bool new_used;
                                    new_used[ 1 : UPB used ] := used;
                                    for k from UPB used + 1 to UPB new_used do new_used[ k ] := false od;
                                    used := new_used
                                fi;
                                if NOT used[ j ] then
                                    if found := gcd( j, p1 ) = 1 AND gcd( j, p2 ) /= 1
                                    then
                                        result[ i ] := j;
                                        used[   j ] := true
                                    fi
                                fi
                            od
                        od
                    fi
                fi
            fi;
            result
         end { YELLOWSTONE } ;
    []int ys = YELLOWSTONE 30;
    for i to UPB ys do
        print( ( " ", whole( ys[ i ], 0 ) ) )
    od;
    print( ( newline ) )
end
)
