  tools/rosetta_prep.py. }
access Genie_Transput (
{!/usr/local/bin/a68g --script }

op TYPEOF = (int skip_)string: "INT";
op TYPEOF = (char skip_)string: "CHAR";
op TYPEOF = (real skip_)string: "REAL";
op TYPEOF = (compl skip_)string: "COMPL";

printf(($g" "$,TYPEOF 1, TYPEOF "x", TYPEOF pi, TYPEOF (0 I 1 ), $l$))
)
