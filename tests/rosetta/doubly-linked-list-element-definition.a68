  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ -*- coding: utf-8 -*- }
{ REQUIRES:
  MODE OBJVALUE = ~ # Mode/type of actual obj to be queued #
END }

mode Objlink = struct(
  ref Objlink next,
  ref Objlink prev,
  OBJVALUE value { ... etc. required }
);

proc obj_link_new = ref Objlink: heap Objlink;

proc obj_link_free = (ref Objlink free)void:
   prev of free := next of free := obj_queue_empty { give the garbage collector a big hint }
)
