{ dg-modules "rcprelude" }
{ Rosetta Code, task "Cumulative standard deviation", ALGOL 68 solution cumulative-standard-deviation-3.alg.
  https://rosettacode.org/wiki/Cumulative_standard_deviation#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/cumulative-standard-deviation-3.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
long real sum, sum2;
int n;

proc sd = (long real x)long real:(
    sum  +:= x;
    sum2 +:= x*x;
    n    +:= 1;
    if n = 0 then 0 else long_sqrt(sum2/n - sum*sum/n/n) fi
);

sum := sum2 := n := 0;
[]long real values = (2,4,4,4,5,5,7,9);
for i to UPB values do
    long real value = values[i];
    printf(($2(xg(0,6))l$, value, sd(value)))
od
)
