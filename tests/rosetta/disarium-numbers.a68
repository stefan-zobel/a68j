{ dg-modules "rcprelude" }
{ Rosetta Code, task "Disarium numbers", ALGOL 68 solution disarium-numbers.alg.
  https://rosettacode.org/wiki/Disarium_numbers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/disarium-numbers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find some Disarium numbers - numbers whose digit position-power sums  }
      { are equal to the number, e.g. 135 = 1^1 + 3^2 + 5^3                   }
    { compute the nth powers of 0-9                                           }
    [ 1 : 9, 0 : 9 ]int power;
    for d from 0 to 9 do power[ 1, d ] := d od;
    for n from 2 to 9 do
        power[ n, 0 ] := 0;
        for d to 9 do
            power[ n, d ] := power[ n - 1, d ] * d
        od
    od;
    { print the first few Disarium numbers                                    }
    int max_disarium  = 19;
    int count        :=  0;
    int power_of_ten := 10;
    int length       :=  1;
    for n from 0 while count < max_disarium do
        if n = power_of_ten then
            { the number of digits just increased                             }
            power_of_ten *:= 10;
            length       +:=  1
        fi;
        { form the digit power sum                                            }
        int v   := n;
        int dps := 0;
        for p from length by -1 to 1 do
            dps +:= power[ p, v MOD 10 ];
            v OVERAB 10
        od;
        if dps = n then
            { n is Disarium                                                   }
            count +:= 1;
            print( ( " ", whole( n, 0 ) ) )
        fi
    od
end
)
