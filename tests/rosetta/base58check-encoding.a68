{ dg-modules "genietransput" }
{ Rosetta Code, task "Base58Check encoding", ALGOL 68 solution base58check-encoding.alg.
  https://rosettacode.org/wiki/Base58Check_encoding#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/base58check-encoding.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { Base58Check encoding                                              }

            { maximum number of digits - adjust to suit }

    { returns the LONG LONG INT n converted to a base 58 string           }
    proc to_base_58 = ( long long int n )string:
         begin
            string        base58 = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
            long long int v     := n;
            string        r     := "";
            while v > 0 do
                base58[ 1 + SHORTEN SHORTEN ( v MOD 58 ) ] +=: r;
                v OVERAB 58
            od;
            r
         end { to base 58 } ;

    { returns the digit sequence in v converted to base 58,               }
    {         if v begins with 0x, it is assumed to be in hex,            }
    {         otherwise it is assumed to be decimal.                      }
    {     NB: no checks that the string is valid are made                 }
    proc string_to_base_58 = ( string v )string:
         begin
            long long int n    := 0;
            int          v_min := LWB v;
            int          v_max  = UPB v;
            int          base   = if v_max - v_min <= 1              then 10
                                  elif v[ v_min : v_min + 1 ] = "0x" then 16
                                  else                                    10
                                  fi;
            if base = 16 then v_min +:= 2 fi;
            for v_pos from v_min to v_max do
                n *:= base +:= if   int c = ABS v[ v_pos ];
                                    c >= ABS "A" AND c <= ABS "F"
                               then c + 10 - ABS "A"
                               elif c >= ABS "a" AND c <= ABS "f"
                               then c + 10 - ABS "a"
                               else c      - ABS "0"
                               fi
            od;
            to_base_58( n )
         end { string to base 58 } ;

    begin
        []string hashes = ( "25420294593250030202636073700053352635053786165627414518"
                          , "0x61", "0x626262", "0x636363"
                          , "0x73696d706c792061206c6f6e6720737472696e67"
                          , "0x516b6fcd0f", "0xbf4f89001e670274dd"
                          , "0x572e4794", "0xecac89cad93923c02321"
                          , "0x10c8511e"
                          );
        for h_pos from LWB hashes to UPB hashes do
            string h     = hashes[ h_pos ];
            int    h_len = ( UPB h - LWB h ) + 1;
            string pad   = if h_len < 58 then " " * ( 58 - h_len ) else "" fi;
            print( ( pad, h, " -> ", string_to_base_58( h ), newline ) )
        od

    end

end
)
