{ dg-modules "rcprelude" }
{ Rosetta Code, task "HTTP", ALGOL 68 solution http.alg.
  https://rosettacode.org/wiki/HTTP#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/http.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
string domain="rosettacode.org";
string page="wiki/Main_Page";

string re_success="^HTTP/[0-9.]* 200";
string re_result_description="^HTTP/[0-9.]* [0-9]+ [a-zA-Z ]*";
string re_doctype ="\s\s<!DOCTYPE html PUBLIC ""[^>]+"">\s+";

proc html_page = (ref string page) bool: (
     bool out_=grep_in_string(re_success, page, nil, nil) = 0;
     if int start, end_;
        grep_in_string(re_result_description, page, start, end_) = 0
     then
        page:=page[end_+1:];
        if grep_in_string(re_doctype, page, start, end_) = 0
        then page:=page[start+2:]
        else print ("unknown format retrieving page")
        fi
     else print ("unknown error retrieving page")
     fi;
     out_
);

if string reply;
   int rc =
      http_content (reply, domain, "http://"+domain+"/"+page, 0);
   rc = 0 AND html_page (reply)
then print (reply)
else print (strerror (rc))
fi
)
