{ dg-modules "rcprelude" }
{ Rosetta Code, task "Pick random element", ALGOL 68 solution pick-random-element.alg.
  https://rosettacode.org/wiki/Pick_random_element#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/pick-random-element.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { pick a random element from an array of strings }

    op PICKRANDOM = ( []string list )string:
    begin

        int number_of_elements = ( UPB list - LWB list ) + 1;
        int random_element     =
            ENTIER ( next_random * ( number_of_elements ) );

        list[ LWB list + random_element ]
    end; { PICKRANDOM }
    { can define additional operators for other types of array }


    begin
        []string days = ( "Sunday",   "Monday", "Tuesday", "Wednesday"
                        , "Thursday", "Friday", "Saturday"
                        );

        print( ( PICKRANDOM days, newline ) )
    end
end
)
