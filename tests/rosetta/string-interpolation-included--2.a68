{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "String interpolation (included)", ALGOL 68 solution string-interpolation-included--2.alg.
  https://rosettacode.org/wiki/String_interpolation_(included)#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/string-interpolation-included--2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
begin
    File str_file;
    string mhl;
    associate( str_file, mhl );

    string extra := "little";
    to 2 do
        putf( str_file, ( gfmt ("""Mary had a ""g"" lamb."""), extra ) );
        print( ( "1 result is: {{", mhl, "}}", newline ) );
        mhl := "";
        "supposedlly-" +=: extra
    od;

    Gformat extraf := gfmt ("""little""");
    to 2 do
        putf( str_file, ( gfmtd ("""Mary had a ""f(@1)"" lamb.""", skip, (int gfindex) Gformat: case gfindex in extraf esac) ) );
        print( ( "2 result is: {{", mhl, "}}", newline ) );
        mhl := "";
        extraf := gfmt ("""medium-sized""")
    od
end
)
