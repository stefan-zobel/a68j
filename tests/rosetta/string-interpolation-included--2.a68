{ dg-modules "rcprelude" }
{ Rosetta Code, task "String interpolation (included)", ALGOL 68 solution string-interpolation-included--2.alg.
  https://rosettacode.org/wiki/String_interpolation_(included)#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/string-interpolation-included--2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin
    file str_file;
    string mhl;
    associate( str_file, mhl );

    string extra := "little";
    to 2 do
        putf( str_file, ( $"Mary had a "g" lamb."$, extra ) );
        print( ( "1 result is: {{", mhl, "}}", newline ) );
        mhl := "";
        "supposedlly-" +=: extra
    od;

    FORMAT extraf := $"little"$;
    to 2 do
        putf( str_file, ( $"Mary had a "f(extraf)" lamb."$ ) );
        print( ( "2 result is: {{", mhl, "}}", newline ) );
        mhl := "";
        extraf := $"medium-sized"$
    od
end
)
