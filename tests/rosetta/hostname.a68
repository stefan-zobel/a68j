{ dg-modules "rcprelude" }
{ Rosetta Code, task "Hostname", ALGOL 68 solution hostname.alg.
  https://rosettacode.org/wiki/Hostname#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/hostname.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
string hostname;
get(read of execve_child_pipe("/bin/hostname","hostname",""), hostname);
print(("hostname: ", hostname, new_line))
)
