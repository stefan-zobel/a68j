{ dg-modules "rcprelude" }
{ Rosetta Code, task "Partition function P", ALGOL 68 solution partition-function-p.alg.
  https://rosettacode.org/wiki/Partition_function_P#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/partition-function-p.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { calculate the partition function of some integers                    }
      { translated from the FreeBASIC sample                                 }
              { set the number of digits for LONG LONG INT }
    mode Partint = long long int;
    proc partitions_p = ( int n )Partint:
         begin
            [ 0 : n ]Partint p; for i from LWB p to UPB p do p[ i ] := 0 od;
            p[ 0 ] := 1;
            for i to n do
                int k := 0;
                while k +:= 1;
                      int j := ( k * ( 3 * k - 1 ) ) OVER 2;
                      if j > i
                      then false         { exit the loop }
                      else if ODD k then
                              p[ i ] +:= p[ i - j ]
                           else
                              p[ i ] -:= p[ i - j ]
                           fi;
                           j +:= k;
                           if j > i
                           then false    { exit the loop }
                           else if ODD k then
                                   p[ i ] +:= p[ i - j ]
                                else
                                   p[ i ] -:= p[ i - j ]
                                fi;
                                true  { continue to loop }
                           fi
                      fi
                do skip od
            od;
            p[ n ]
         end { partitions p } ;

    begin
        print( ( "P(0..12):" ) );
        for x from 0 to 12 do
            print( ( " ", whole( partitions_p( x ), 0 ) ) )
        od;
        print( ( newline, "P(127):   ", whole( partitions_p(  127 ), 0 ) ) );
        print( ( newline, "P(255):   ", whole( partitions_p(  255 ), 0 ) ) );
        print( ( newline, "P(6666):  ", whole( partitions_p( 6666 ), 0 ) ) );
        print( ( newline ) )
    end
end
)
