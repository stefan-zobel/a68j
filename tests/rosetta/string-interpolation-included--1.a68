{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "String interpolation (included)", ALGOL 68 solution string-interpolation-included--1.alg.
  https://rosettacode.org/wiki/String_interpolation_(included)#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/string-interpolation-included--1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
main:(
{ as a STRING }
  string extra = "little";
  printf((gfmt ("""Mary had a ""g"" lamb.""l"), extra));

{ as a FORMAT }
  Gformat extraf = gfmt ("""little""");
  printf(gfmtd ("""Mary had a ""f(@1)"" lamb.""l", skip, (int gfindex) Gformat: case gfindex in extraf esac));

{ or: use simply use STRING concatenation }
  print(("Mary had a "+extra+" lamb.", new_line))
)
)
