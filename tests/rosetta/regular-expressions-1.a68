{ dg-modules "rcprelude" }
{ Rosetta Code, task "Regular expressions", ALGOL 68 solution regular-expressions-1.alg.
  https://rosettacode.org/wiki/Regular_expressions#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/regular-expressions-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
int match=0, no_match=1, out_of_memory_error=2, other_error=3;

string str := "i am a string";

{ Match: }

string m := "string$";
int start, end_;
if grep_in_string(m, str, start, end_) = match then printf(($"Ends with """g""""l$, str[start:end_])) fi;

{ Replace: }

if sub_in_string(" a ", " another ",str) = match then printf(($gl$, str)) fi;
)
