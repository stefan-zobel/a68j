{ dg-modules "genietransput" }
{ Rosetta Code, task "URL encoding", ALGOL 68 solution url-encoding.alg.
  https://rosettacode.org/wiki/URL_encoding#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/url-encoding.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin
    { encodes the specified url - 0-9, A-Z and a-z are unchanged,            }
    { everything else is converted to %xx where xx are hex-digits            }
    proc encode_url = ( string url )string:
         if url = "" then "" { empty string                                  }
         else
            { non-empty string                                               }
            { ensure result will be big enough for a string of all encodable }
            { characters                                                     }
            string hex_digits = "0123456789ABCDEF";
            [ 1 : ( ( UPB url - LWB url ) + 1 ) * 3 ]char result;
            int r_pos := 0;
            for u_pos from LWB url to UPB url do
                char c = url[ u_pos ];
                if ( c >= "0" AND c <= "9" )
                OR ( c >= "A" AND c <= "Z" )
                OR ( c >= "a" AND c <= "z" )
                then
                    { no need to encode this character                       }
                    result[ r_pos +:= 1 ] := c
                else
                    { must encode                                            }
                    int c_code = ABS c;
                    result[ r_pos +:= 1 ] := "%";
                    result[ r_pos +:= 1 ] := hex_digits[ ( c_code OVER 16 ) + 1 ];
                    result[ r_pos +:= 1 ] := hex_digits[ ( c_code  MOD 16 ) + 1 ]
                fi
            od;
            result[ 1 : r_pos ]
         fi; { encode url }
    { task test case                                                         }
    print( ( encode_url( "http://foo bar/" ), newline ) )
end
)
