{ dg-modules "rcprelude" }
{ Rosetta Code, task "Sequence: smallest number greater than previous term with exactly n divisors", ALGOL 68 solution sequence:-smallest-number-greater-than-previous-term-with-exactly-n-divisors.alg.
  https://rosettacode.org/wiki/Sequence:_smallest_number_greater_than_previous_term_with_exactly_n_divisors#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sequence:-smallest-number-greater-than-previous-term-with-exactly-n-divisors.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin

    proc count_divisors = ( int n )int:
         begin
            int i2, count := 0;
            for i while ( i2 := i * i ) < n do
                if n MOD i = 0 then count +:= 2 fi
            od;
            if i2 = n then count + 1 else count fi
         end { count divisors } ;

    int max = 15;

    print( ( "The first ", whole( max, 0 ), " terms of the sequence are:" ) );
    int next := 1;
    for i while next <= max do
        if next = count_divisors( i ) then
            print( ( " ", whole( i, 0 ) ) );
            next +:= 1
        fi
    od

end
)
