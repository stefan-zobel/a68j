{ dg-modules "genietransput" }
{ Rosetta Code, task "Sum multiples of 3 and 5", ALGOL 68 solution sum-multiples-of-3-and-5.alg.
  https://rosettacode.org/wiki/Sum_multiples_of_3_and_5#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sum-multiples-of-3-and-5.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ returns the sum of the multiples of 3 and 5 below n }
proc sum_of_multiples_of_3_and_5_below = ( long long int n )long long int:
     begin
        { calculate the sum of the multiples of 3 below n }
        long long int multiples_of_3 = ( n - 1 ) OVER  3;
        long long int multiples_of_5 = ( n - 1 ) OVER  5;
        long long int multiples_of_15 = ( n - 1 ) OVER 15;
        ( { twice the sum of multiples of  3 }
          (  3 * multiples_of_3 * ( multiples_of_3 + 1 ) )
          { plus twice the sum of multiples of  5 }
        + (  5 * multiples_of_5 * ( multiples_of_5 + 1 ) )
          { less twice the sum of multiples of 15 }
        - ( 15 * multiples_of_15 * ( multiples_of_15 + 1 ) )
        ) OVER 2
    end { sum of multiples of 3 and 5 below } ;

print( ( "Sum of multiples of 3 and 5 below 1000: "
       , whole( sum_of_multiples_of_3_and_5_below( 1000 ), 0 )
       , newline
       )
     );
print( ( "Sum of multiples of 3 and 5 below 1e20: "
       , whole( sum_of_multiples_of_3_and_5_below( 100 000 000 000 000 000 000 ), 0 )
       , newline
       )
     )
)
