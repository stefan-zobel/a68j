{ dg-modules "genietransput" }
{ Rosetta Code, task "Find minimum number of coins that make a given value", ALGOL 68 solution find-minimum-number-of-coins-that-make-a-given-value.alg.
  https://rosettacode.org/wiki/Find_minimum_number_of_coins_that_make_a_given_value#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/find-minimum-number-of-coins-that-make-a-given-value.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find the minimum number of coins needed to make a given value         }
      { translated from the Wren sample                                       }

    []int denoms     = ( 200, 100, 50, 20, 10, 5, 2, 1 );
    int   coins     := 0;
    int   amount     = 988;
    int   remaining := amount;
    print( ( "The minimum number of coins needed to make a value of " ) );
    print( ( whole( amount, 0 ), " is as follows:", newline ) );
    for d_pos from LWB denoms to UPB denoms
    while int denom = denoms[ d_pos ];
          int n     = remaining OVER denom;
          if n > 0 then
              coins +:= n;
              print( ("  ", whole( denom, -3 ), " x ", whole( n, 0 ), newline ) );
              remaining MODAB denom
          fi;
          remaining > 0
    do skip od;
    print( ( newline, "A total of ", whole( coins, 0 ), " coins in all.", newline ) )
end
)
