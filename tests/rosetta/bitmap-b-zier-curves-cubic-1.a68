{ dg-modules "genietransput" }
{ Rosetta Code, task "Bitmap/B?zier curves/Cubic", ALGOL 68 solution bitmap-b-zier-curves-cubic-1.alg.
  https://rosettacode.org/wiki/Bitmap/B%C3%A9zier_curves/Cubic#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/bitmap-b-zier-curves-cubic-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ -*- coding: utf-8 -*- }

cubic_bezier of class_image :=
          (  ref IMAGE picture,
             POINT p1, p2, p3, p4,
             PIXEL color,
             union(int, void) in_n
          )void:
begin
   int n = (in_n|(int n):n|20); { default 20 }
   [0:n]POINT points;
   for i from LWB points to UPB points do
         real t = i / n,
              a = (1 - t)**3,
              b = 3 * t * (1 - t)**2,
              c = 3 * t**2 * (1 - t),
              d = t**3;
         x of points [i] := ENTIER (0.5 + a * x of p1 + b * x of p2 + c * x of p3 + d * x of p4);
         y of points [i] := ENTIER (0.5 + a * y of p1 + b * y of p2 + c * y of p3 + d * y of p4)
   od;
   for i from LWB points to UPB points - 1 do
      (line of class_image)(picture, points (i), points (i + 1), color)
   od
end { cubic bezier };

skip
)
