{ dg-modules "genietransput" }
{ Rosetta Code, task "Largest palindrome product", ALGOL 68 solution largest-palindrome-product-1.alg.
  https://rosettacode.org/wiki/Largest_palindrome_product#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/largest-palindrome-product-1.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { find the highest palindromic multiple of various sizes of numbers }
    { returns n with the digits reversed }
    proc reverse = ( long int v )long int:
         begin
            long int r := 0 ;
            long int n := v;
            while n > 0 do
                r *:= 10; r +:= n MOD 10;
                n OVERAB 10
            od;
            r
         end { reverse } ;

    long int pow := 10;
    for n from 2 to 7 do
        long int low := pow * 9;
        pow *:= 10;
        long int high := pow - 1;
        print( ( "Largest palindromic product of two ", whole( n, 0 ), "-digit integers: " ) );
        bool next_n := false;
        long int i := high + 1;
        while i -:= 1;
              i >= low AND NOT next_n
        do
            long int j = reverse( i );
            long int p = ( i * pow ) + j;
            { k can't be even nor end in 5 to produce a product ending in 9 }
            long int k := high + 2;
            while k -:= 2;
                  if   k < low
                  then false
                  elif k MOD 10 = 5
                  then true
                  elif long int l = p OVER k;
                                l > high
                  then false
                  elif p MOD k = 0 then
                       print( ( whole( k, 0 ), " x ", whole( l, 0 ), " = ", whole( p, 0 ), newline ) );
                       next_n := true;
                       false
                  else true
                  fi
            do skip od
        od
    od
end
)
