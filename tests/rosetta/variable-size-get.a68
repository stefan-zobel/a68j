{ dg-modules "rcprelude" }
{ Rosetta Code, task "Variable size/Get", ALGOL 68 solution variable-size-get.alg.
  https://rosettacode.org/wiki/Variable_size/Get#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/variable-size-get.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
int i; bytes b; { typically INT and BYTES are the same size }
string s:="DCLXVI", [666]char c;
print((
  "sizeof INT i =",bytes_width, new_line,
  "UPB STRING s =",UPB s, new_line,
  "UPB []CHAR c =",UPB c, new_line
))
)
