{ dg-modules "genietransput genieformats" }
{ Rosetta Code, task "Probabilistic choice", ALGOL 68 solution probabilistic-choice.alg.
  https://rosettacode.org/wiki/Probabilistic_choice#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/probabilistic-choice.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput, Genie_Formats (
int trials = 1 000 000;

mode Lreal = long real;

mode Item = struct(
  string name,
  int prob_count,
  Lreal expect,
        mapping
);
int col_width = 9;
Gformat real_repr = gfmtd ("g(@1,6)", (int gfindex) int: case gfindex in -col_width+1 esac, skip),
       item_repr = gfmtd ("""Name: ""g"", Prob count: ""g(0)"", Expect: ""f(@1)"", Mapping: "", f(@2)l", skip, (int gfindex) Gformat: case gfindex in real_repr, real_repr esac);

[8]Item items := (
  ( "aleph",  0, ~, ~ ),
  ( "beth",   0, ~, ~ ),
  ( "gimel",  0, ~, ~ ),
  ( "daleth", 0, ~, ~ ),
  ( "he",     0, ~, ~ ),
  ( "waw",    0, ~, ~ ),
  ( "zayin",  0, ~, ~ ),
  ( "heth",   0, ~, ~ )
);

main:
(
  Lreal offset = 5; { const }

{ initialise items }
  Lreal total_sum := 0;
  for i from LWB items to UPB items - 1 do
    expect of items[i] := 1/(i-1+offset);
    total_sum +:= expect of items[i]
  od;
  expect of items[UPB items] := 1 - total_sum;

  mapping of items[LWB items] := expect of items[LWB items];
  for i from LWB items + 1 to UPB items do
    mapping of items[i] := mapping of items[i-1] + expect of items[i]
  od;

  { printf((item repr, items)) }

{ perform the sampling }
  proc sample = (ref[]Lreal mapping)int:(
    int out_;
    Lreal rand_real = random;
    for j from LWB items to UPB items do
      if rand_real < mapping[j] then
        out_ := j;
	done
      fi
    od;
    done: out_
  );

  for i to trials do
      prob_count of items[sample(mapping of items)] +:= 1
  od;

  Gformat indent = gfmt ("17k");

{ print the results }
  printf((gfmt ("""Trials: ""g(0)l"), trials));
  printf((gfmt ("""Items:"""),indent));
  for i from LWB items to UPB items do printf((gfmtd ("gn(@1)k"" """, (int gfindex) int: case gfindex in col_width esac, skip), name of items[i])) od;
  printf((gfmt ("l""Target prob.:"""), indent, gfmtd ("f(@1)"" """, skip, (int gfindex) Gformat: case gfindex in real_repr esac), expect of items));
  printf((gfmt ("l""Attained prob.:"""), indent));
  for i from LWB items to UPB items do printf((gfmtd ("f(@1)"" """, skip, (int gfindex) Gformat: case gfindex in real_repr esac), prob_count of items[i]/trials)) od;
  printf(gfmt ("l"))
)
)
