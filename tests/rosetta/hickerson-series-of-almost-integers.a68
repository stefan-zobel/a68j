{ dg-modules "genietransput" }
{ Rosetta Code, task "Hickerson series of almost integers", ALGOL 68 solution hickerson-series-of-almost-integers.alg.
  https://rosettacode.org/wiki/Hickerson_series_of_almost_integers#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/hickerson-series-of-almost-integers.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ determine whether the first few Hickerson numbers really are "near integers" }
{ The Hickerson number n is defined by: h(n) = n! / ( 2 * ( (ln 2)^(n+1) ) )   }
{                                   so: h(1) = 1 / ( 2 * ( ( ln 2 ) ^ 2 )      }
{                                  and: h(n) = ( n / ln 2 ) * h(n-1)           }

{ set the precision of LONG LONG numbers                                       }
 

{ calculate the Hickerson numbers                                              }
long long real ln2 = long_long_ln( 2 );
[ 1 : 18 ]long long real h;

h[ 1 ] := 0.5 / ( ln2 * ln2 );
for n from 2 to UPB h
do
    h[ n ] := ( n * h[ n - 1 ] ) / ln2
od;

{ determine the first digit after the point in each h(n) - if it is 0 or 9     }
{ the number is a "near integer"                                               }

for n to UPB h
do
    int first_decimal = SHORTEN SHORTEN ( ( ENTIER ( h[ n ] * 10 ) ) MOD 10 );
    print( ( whole( n, -4 )
           , " "
           , fixed( h[ n ], 40, 4 )
           , if first_decimal = 0 OR first_decimal = 9
             then
                 "     a near integer"
             else
                 " NOT a near integer"
             fi
           , newline
           )
        )
od
)
