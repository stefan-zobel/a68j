  tools/rosetta_prep.py. }
access Genie_Transput (
{include <stdio.h>
}include <errno.h>
static_void_w( char_ * line, file * tf )
{fputs( line, tf );
 if( errno != 0 ){ perror( "temp" );exit( 2 ); }
}
int_main( int_argc, char_ ** argv )
{FILE * tf = fopen( "/tmp/t", "w" );
 if( tf == NULL ){ perror( "temp" );exit( 1 ); }
 w( "print( ( \"Hello, World!\", newline ) )\n", tf );
 fclose( tf );
 system( "a68g /tmp/t" );
 remove( "/tmp/t" );
}
)
