{ dg-modules "rcprelude" }
{ Rosetta Code, task "Numbers divisible by their individual digits, but not by the product of their digits", ALGOL 68 solution numbers-divisible-by-their-individual-digits-but-not-by-the-product-of-their-digits.alg.
  https://rosettacode.org/wiki/Numbers_divisible_by_their_individual_digits,_but_not_by_the_product_of_their_digits#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/numbers-divisible-by-their-individual-digits-but-not-by-the-product-of-their-digits.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { find numbers divisible by their digits but not the product of their digits }
    int max_number    = 999;
    int number_count := 0;
    for n to max_number do
        int digit_product        := 1;
        int v                    := n;
        bool divisible_by_digits := n /= 0;
        while v > 0 AND divisible_by_digits do
            int digit = v MOD 10;
            divisible_by_digits := if digit = 0
                                   then false
                                   else n MOD digit = 0
                                   fi;
            digit_product *:= digit;
            v OVERAB 10
        od;
        if divisible_by_digits then
            if n MOD digit_product /= 0 then
                { have a number divisible by its digits but not the product of the digits }
                print( ( " ", whole( n, -3 ) ) );
                if ( number_count +:= 1 ) MOD 15 = 0 then print( ( newline ) ) fi
            fi
        fi
    od
end
)
