{ dg-modules "genietransput" }
{ Rosetta Code, task "Pandigital prime", ALGOL 68 solution pandigital-prime-2.alg.
  https://rosettacode.org/wiki/Pandigital_prime#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/pandigital-prime-2.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
for sp from 0 to 1 do
      bool done := false;
      for x from if sp = 1 then 7654321 else 76543211 fi by -2 to 0 while NOT done do
          if x MOD 3 /= 0 then
              string s = whole( x, 0 );
              for ch from sp to 7 while done := char_in_string( REPR ( ch + ABS "0" ), nil, s ) do skip od;
              if done then
                  int i := 1;
                  while i * i < x AND done do
                      if done :=            ( x MOD ( i + 4 ) /= 0 )   then i +:= 4 fi;
                      if done := ( done AND ( x MOD ( i + 2 ) /= 0 ) ) then i +:= 2 fi
                  od
              fi;
              if done then print( ( whole( sp, 0 ), "..7: ", whole( x, 0 ), newline ) ) fi
          fi
      od
od
)
