{ dg-modules "genietransput" }
{ Rosetta Code, task "Most frequent k chars distance", ALGOL 68 solution most-frequent-k-chars-distance.alg.
  https://rosettacode.org/wiki/Most_frequent_k_chars_distance#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/most-frequent-k-chars-distance.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { "Most frequent k chars distance": translation of the FreeBASIC sample,   }
      { but retains the original order of the characters with the same frequency }

    mode Occurance = struct( char ch, int count, int pos );

    proc most_freq_k_hashing = ( string input_string, int k )[]Occurance:
         begin
            [ ABS "A" : ABS "Z" ]int dict, orig_pos;
            for n from LWB dict to UPB dict do dict[ n ] := orig_pos[ n ] := 0 od;
            for n from LWB input_string to UPB input_string do
                int c = if   char ch = input_string[ n ];
                             ch >= "A" AND ch <= "Z"
                        then ABS ch
                        elif ch >= "a" AND ch <= "z"
                        then ABS "A" + ( ABS ch - ABS "a" )
                        else 0
                        fi;
                if c > 0 then
                    dict[ c ] +:= 1;
                    if orig_pos[ c ] = 0 then orig_pos[ c ] := n fi
                fi
            od;
            int count := 0;
            for n from LWB dict to UPB dict do
                if dict[ n ] > 0 then count +:= 1 fi
            od;
            [ 1 : count ]Occurance result;
            int r_pos := 0;
            for n from LWB dict to UPB dict do
                if dict[ n ] > 0 then
                    result[ r_pos +:= 1 ] := ( REPR n, dict[ n ], orig_pos[ n ] )
                fi
            od;
            { Sort the output dict on descending count and ascending original position }
            for n from LWB result to UPB result - 1 do
                for j from n + 1 to UPB result do
                    if     count of result[ j ] > count of result[ n ]
                    OR (   count of result[ j ] = count of result[ n ]
                       AND   pos of result[ j ] <   pos of result[ n ]
                       )
                    then Occurance t  = result[ j ];
                         result[ j ] := result[ n ];
                         result[ n ] := t
                    fi
                od
            od;
            { Keep only the top K elements }
            if UPB result > k then result[ 1 : k ] else result fi
         end { most freq k hashing } ;

     proc most_freq_k_similarity = ( []Occurance input_str1, input_str2 )int:
          begin
             int similarity := 0;
             for n from LWB input_str1 to UPB input_str1 do
                 for j from LWB input_str2 to UPB input_str2 do
                     if ch of input_str1[ n ] = ch of input_str2[ j ] then
                         similarity +:= count of input_str1[ n ] + count of input_str2[ j ]
                     fi
                 od
             od;
             similarity
          end { most freq k similarity } ;

    proc most_freq_ksdf = ( string input_str1, input_str2, int k, max_distance )int:
         max_distance - most_freq_k_similarity( most_freq_k_hashing( input_str1, k )
                                              , most_freq_k_hashing( input_str2, k )
                                              );

    op   SHOW = ( []Occurance dict )void:
         for j from LWB dict to UPB dict do
             print( ( ch of dict[ j ], whole( count of dict[ j ], 0 ) ) )
         od { SHOW } ;

    proc test_ksdf = ( string str1, str2, int k, max_distance )void:
         begin
            []Occurance dict1 = most_freq_k_hashing( str1, k );
            []Occurance dict2 = most_freq_k_hashing( str2, k );
            print( ( "dict1: " ) ); SHOW dict1; print( ( " from: ", str1, newline ) );
            print( ( "dict2: " ) ); SHOW dict2; print( ( " from: ", str2, newline ) );
            print( ( "MostFreqKSDF: " ) );
            print( ( whole( most_freq_ksdf( str1, str2, k, max_distance ), 0 ) ) );
            print( ( newline, newline ) )
         end { test ksdf } ;

    { test cases }
    test_ksdf( "night",       "nacht",        2, 10 );
    test_ksdf( "my",          "a",            2, 10 );
    test_ksdf( "research",    "research",     2, 10 );
    test_ksdf( "significant", "capabilities", 2, 10 );
    test_ksdf( "LCLYTHIGRNIYYGSYLYSETWNTGIMLLLITMATAFMGYVLPWGQMSFWGATVITNLFSAIPYIGTNLV"
             , "EWIWGGFSVDKATLNRFFAFHFILPFTMVALAGVHLTFLHETGSNNPLGLTSDSDKIPFHPYYTIKDFLG"
             , 2, 100
             )
end
)
