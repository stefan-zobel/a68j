{ dg-modules "genietransput" }
{ Rosetta Code, task "List comprehensions", ALGOL 68 solution list-comprehensions.alg.
  https://rosettacode.org/wiki/List_comprehensions#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/list-comprehensions.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
mode Xyz = struct(int x,y,z);

op +:= = (ref flex[]Xyz lhs, Xyz rhs)flex[]Xyz: (
  [UPB lhs+1]Xyz out_;
  out_[:UPB lhs] := lhs;
  out_[UPB out_] := rhs;
  lhs := out_
);

int n = 20;
print (([]Xyz(
  flex[0]Xyz xyz;
  for x to n do for y from x+1 to n do for z from y+1 to n do if x*x + y*y = z*z then xyz +:= Xyz(x,y,z) fi od od od;
  xyz), new_line
))
)
