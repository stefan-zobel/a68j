{ dg-modules "genietransput" }
{ Rosetta Code, task "Show ASCII table", ALGOL 68 solution show-ascii-table.alg.
  https://rosettacode.org/wiki/Show_ASCII_table#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/show-ascii-table.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
{ generate an ascii table for characters 32 - 127 }
for c from 32 to 32 + 15 do
    for ach from c by 16 to c + ( 16 * 5 ) do
        print( ( whole( ach, -4 )
               , ": "
               , if   ach =  32 then "SPC"
                 elif ach = 127 then "DEL"
                 else " " + REPR ach + " "
                 fi
               )
             )
    od;
    print( ( newline ) )
od
)
