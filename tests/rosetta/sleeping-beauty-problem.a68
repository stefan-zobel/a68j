{ dg-modules "genietransput" }
{ Rosetta Code, task "Sleeping Beauty problem", ALGOL 68 solution sleeping-beauty-problem.alg.
  https://rosettacode.org/wiki/Sleeping_Beauty_problem#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sleeping-beauty-problem.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Genie_Transput (
begin { sleeping beauty problem - translated from the Wren sample }
    proc sleeping_beauty = ( int reps )real:
         begin
            int wakings := 0, heads := 0;
            to reps do
                wakings +:= 1;
                if next_random < 0.5 then { [0..0.5) = heads, [0.5..1.0) = tails say }
                    heads +:= 1
                else
                    wakings +:= 1
                fi
            od;
            print( ( "Wakings over ", whole( reps, 0 ), " repetitions = ", whole( wakings, 0 ), newline ) );
            ( heads / wakings ) * 100
         end; { sleeping beauty }

    real pc = sleeping_beauty( 1 000 000 );
    print( ( "Percentage probability of heads on waking = ", fixed( pc, -10, 6 ), "%", newline ) )
end
)
