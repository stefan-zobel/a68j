{ dg-modules "rcprelude" }
{ Rosetta Code, task "Sorting algorithms/Bead sort", ALGOL 68 solution sorting-algorithms-bead-sort.alg.
  https://rosettacode.org/wiki/Sorting_algorithms/Bead_sort#ALGOL_68
  The text of Rosetta Code is available under the GNU Free Documentation
  License 1.3 (see README.md).  The solution is unchanged in orig/sorting-algorithms-bead-sort.a68;
  this copy was prepared for ga68 and converted to SUPPER stropping by
  tools/rosetta_prep.py. }
access Rc_Prelude (
begin { bead sort - translation of the Java code in the Wikipedia article     }

    proc bead_sort = ( ref[]int a )void:
         begin
            { Find the maximum element                                        }
            int max := a[ LWB a ];
            for i from LWB a + 1 to UPB a do
                if a[ i ] > max then max := a[ i ] fi
            od;

            { allocating memory                                               }
            [ LWB a : UPB a, 0 : max - 1 ]int beads;

            { mark the beads                                                  }
            for i from LWB a to UPB a do
                for j from 0 to a[ i ] - 1 do
                    beads[ i, j ] := 1
                od;
                for j from a[ i ] to max - 1 do
                    beads[ i, j ] := 0
                od
            od;

            { move down the beads                                             }
            for j from 0 to max - 1 do
                int sum := 0;
                for i from LWB a to UPB a do
                    sum          +:= beads[ i, j ];
                    beads[ i, j ] := 0
                od;

                for i from UPB a by -1 while i >= UPB a + 1 - sum do
                    a[ i ] := j + 1
                od
            od
         end { bead sort } ;

    begin
        [ 1 : 10 ]int data := ( 909, 8, 7, 6, 1, 3, 5, 12346, 4, 2 );
        bead_sort( data );
        for i from LWB data to UPB data do print( ( " ", whole( data[ i ], 0 ) ) ) od;
        print( ( newline ) )
    end

end
)
