{ a68j-options: -I tests/java/lib -fjava-classpath=tests/java/classes }
{ Public formal holes of a module (tests/java/modules/jholes.a68), called
  through their typed entries: numbers, strings, characters, a name of a
  row stored back, a procedure as a functional interface, a discarded long
  result, a constructor, fields and an instance method, operators, and the
  procedure value of a hole. The program needs no -fnest-java. }
access Jholes (
   puts ("start'n");
   puts (whole (j_abs (-5), 0) + " " + whole (j_max (long 3, long 9), 0) + "'n");
   puts (whole (j_parse ("123"), 0) + " " + j_hex (255) + "'n");
   puts (fixed (j_sqrt (2.0), 0, 6) + (j_digit ("7") | " digit" | " other")
         + (j_digit ("x") | " digit" | " other") + "'n");

   [5] int a := (5, 3, 1, 4, 2);
   j_sort (a);
   for i to UPB a do puts (whole (a[i], 0)) od;
   puts ("'n");
   int k := 10;
   j_set_all (a, (int i) int: i * k);
   for i to UPB a do puts (" " + whole (a[i], 0)) od;
   puts ("'n");
   j_discard (long 7);

   Point p = new_point (3, 4);
   set_x (p, x_of (p) + 10);
   puts (whole (x_of (p), 0) + " " + point_string (p) + "'n");

   puts (whole (ABSJ -7, 0) + " " + whole (-7 MODJ 3, 0) + "'n");

   { The procedure value of a hole, and a call through it. }
   proc (string) int parse = j_parse;
   [] proc (int) int ps = (j_abs, (int i) int: ABSJ i);
   puts (whole (parse ("42"), 0) + " " + whole (ps[1] (-1) + ps[2] (-2), 0) + "'n")
)
