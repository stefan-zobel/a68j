{ The module Lists of a68j: Intlist and the operators of all lists. }
access Lists (
   Intlist l = new_intlist;
   for i to 20 do l +:= i * i od;
   puts ("UPB " + whole (UPB l, 0) + ", LWB " + whole (LWB l, 0) + "'n");
   puts ("5 ELEM l = " + whole (5 ELEM l, 0) + "'n");
   5 AT l := -1;
   6 AT l +:= 1000;
   puts ("after AT: " + whole (5 ELEM l, 0) + " " + whole (6 ELEM l, 0) + "'n");
   puts ("POP: " + whole (POP l, 0) + ", UPB " + whole (UPB l, 0) + "'n");
   l +:= [] int (7, 3, 5);
   [] int r = TOROW SORT l;
   string s := "";
   for i from LWB r to UPB r do s +:= " " + whole (r[i], 0) od;
   puts ("sorted:" + s + "'n");
   puts ("l INDEX 49: " + whole (l INDEX 49, 0) + ", l INDEX 2: " + whole (l INDEX 2, 0) + "'n");
   Intlist m = intlist_of ((10, 20, 30));
   puts ("m: " + whole (UPB m, 0) + " " + whole (2 ELEM m, 0) + "'n");
   puts ("l is l: " + (l is l | "yes" | "no") + ", l is m: " + (l is m | "yes" | "no") + "'n");
   puts ("1 AT m is 1 AT m: " + (1 AT m is 1 AT m | "yes" | "no") + "'n");
   Intlist n = nil;
   puts ("n is nil: " + (n is nil | "yes" | "no") + "'n");
   puts ("after CLEAR: " + whole (UPB CLEAR l, 0) + "'n")
)
