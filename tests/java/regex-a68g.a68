{ The module Regex against Algol 68 Genie: the patterns of this program
  were run with a68g 3.1.2 (written in UPPER stropping and converted with
  tools/a68supper.py), and the output is the same except for these lines,
  where Java differs as docs/regex.md describes:
    [\d] on [5]          a68g: 1 (no match), a68j: 0 1 1 (\d is a digit in Java)
    [a**] on [aa]        a68g: 0 1 2, a68j: 2 (a quantifier after a quantifier)
    [a|ab] on [xabc]     a68g: 0 2 3 (longest), a68j: 0 2 2 (first alternative)
    [(a)(b)\2] on [abb]  a68g: 1 (no match), a68j: 0 1 3
  and the widths of the integers printed by print. }
access Genie_Transput, Regex (
proc t = (string p, s) void:
  begin int a := -9, e := -9;
        int r = grep_in_string (p, s, a, e);
        print (("[", p, "] on [", s, "]: ", whole (r, 0), " ", whole (a, 0), " ", whole (e, 0), newline))
  end;
t ("a+", "caab"); t ("a\{2\}", "caab"); t ("a{2}", "caab"); t ("(a)b", "cab"); t ("a|b", "cb");
t ("x*", "abc"); t ("b*", "abc"); t ("", "abc"); t ("$", "abc"); t ("^", "abc");
t ("[]a]", "x]"); t ("[\d]", "\"); t ("[\d]", "d"); t ("\d", "5"); t ("\w+", "  ab_1 ");
t ("\s", "a b"); t ("\bb", "a b"); t ("\<b", "a b");
t ("^b", "a" + REPR 10 + "b"); t ("a.b", "a" + REPR 10 + "b"); t ("a$", "a" + REPR 10 + "b");
t ("A", "a"); t ("a{,2}", "aaa"); t ("(", "a"); t ("a**", "aa"); t ("a{2,1}", "a");
t ("[[:alpha:]]+", "1ab:c"); t ("[[:upper:][:digit:]]+", "xA1b"); t ("[[=a=]]", "a"); t ("[[.a.]]", "a"); t ("[[:foo:]]", "a");
t ("\(a\)", "(a)"); t ("a\|b", "b"); t ("\.", "a.b"); t ("[a-]", "-"); t ("a?", "b");
t ("(a|ab)(c|bcd)", "abcd"); t ("\1", "a"); t ("(a)\1", "aa");

proc ts = (string p, r, s0) void:
  begin string s := s0;
        int c = sub_in_string (p, r, s);
        print (("sub [", p, "] [", r, "] on [", s0, "]: ", whole (c, 0), " [", s, "] ", whole (LWB s, 0), newline))
  end;
ts ("b+", "X", "abbcb"); ts ("x*", "Z", "abc"); ts ("$", "Z", "abc"); ts ("q", "Z", "abc"); ts ("(", "Z", "abc");
ts ("b", "", "abc"); ts ("", "Z", "");
string u := "abc"[@5]; int cc = sub_in_string ("b", "XY", u); print ((whole (cc, 0), " ", u, " ", whole (LWB u, 0), " ", whole (UPB u, 0), newline));
proc gs = (string p, s) void:
  begin int a := -9, e := -9;
        int r = grep_in_substring (p, s, a, e);
        print (("sub-grep [", p, "] on [", s, "]: ", whole (r, 0), " ", whole (a, 0), " ", whole (e, 0), newline))
  end;
gs ("^a", "abc"); gs ("^b", "a" + REPR 10 + "b"); gs ("c$", "abc"); gs ("\<a", "abc"); gs ("\ba", "abc"); gs ("^", "abc"); gs ("x*", "abc");
string v = "xyz"[@3]; int aa := 0, ee := 0; print ((grep_in_string ("y", v, aa, ee), aa, ee, newline));
print ((grep_in_string ("y", "xyz", nil, nil), newline))
;
t ("a|ab", "xabc"); t ("[^a]", "a" + REPR 10 + "b"); t ("a\>", "ab a"); t ("[a", "a"); t ("a\", "a"); t ("[[=ab=]]", "a");
t ("[[.-.]]", "-"); t ("[]]", "]"); t ("[^]]", "]a"); t ("[\]", "\"); t ("[a&&b]", "&"); t ("[[]", "["); t ("x{,1}y", "xy");
t ("[[:space:]]+", "a " + REPR 9 + "b"); t ("[[:punct:]]", "a,b"); t ("[[:xdigit:]]+", "xFf9g"); t ("(a)(b)\2", "abb");
t ("a.c", "abc"); t ("^$", ""); t ("b$", "ab" + REPR 10); t ("(ab|a)c", "abc");
int n := 0;
for i to 100 do int a, e; if grep_in_string (whole (i, 0), "x" + whole (i, 0), a, e) = 0 AND a = 2 then n +:= 1 fi od;
for i to 100 do int a, e; if grep_in_string (whole (i, 0), "x" + whole (i, 0), a, e) = 0 AND a = 2 then n +:= 1 fi od;
print ((n, newline))
)
