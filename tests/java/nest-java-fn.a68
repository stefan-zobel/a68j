{ a68j-options: -fnest-java -fjava-classpath=tests/java/classes }
{ Algol 68 procedures as objects of Java functional interfaces and back
  (tests/java/demo/Fns.java and the JDK), names of rows as Java arrays,
  Java objects such as Integer and Double for plain modes. }
begin
   { Procedures as parameters: routine texts, declared procedures, nested. }
   proc (proc (int) int, int) int apply = nest Java "demo.Fns.apply";
   proc (proc (long real) long real, long real, long real, int) long real integrate
      = nest Java "demo.Fns.integrate";
   proc square = (int x) int: x * x;
   int calls := 0;
   puts (whole (apply (square, 7), 0) + " " + whole (apply ((int x) int: (calls +:= 1; x - 1), 1), 0) + "'n");
   puts (fixed (integrate ((long real x) long real: x * x, long 0, long 3, 10), 0, 6) + "'n");
   puts (fixed (integrate (long_sin, long 0, long_pi, 100), 0, 6) + "'n");

   { Results that are Java objects of functional interfaces: Algol 68 procedures. }
   proc (int) proc (int) int adder = nest Java "demo.Fns.adder";
   proc (proc (int) int, proc (int) int) proc (int) int compose = nest Java "demo.Fns.compose";
   proc (int) int add10 = adder (10);
   proc (int) int f = compose (add10, (int x) int: x * 2);
   puts (whole (add10 (5), 0) + " " + whole (f (1), 0) + " " + whole (apply (f, 4), 0) + "'n");
   proc (string) proc string constant = nest Java "demo.Fns.constant";
   proc string hello = constant ("hello");
   puts (hello + " " + hello + "'n");
   proc proc (long int, long real) string describe = nest Java "demo.Fns.describe";
   puts (describe (long 7, long 2.5) + "'n");

   { Generic methods: T is Object, here STRING. }
   proc (proc (string) string, string) string twice = nest Java "demo.Fns.twice";
   puts (twice ((string s) string: s + "!", "hi") + "'n");

   { VOID results, a functional interface of the user, side effects. }
   proc (int, proc (int) void) void each = nest Java "demo.Fns.each";
   int sum := 0;
   each (100, (int i) void: sum +:= i);
   puts (whole (sum, 0) + " " + whole (calls, 0) + "'n");
   proc (proc (int, string) void) void walk = nest Java "demo.Fns.walk";
   walk ((int depth, string name) void: puts (depth * "  " + name + "'n"));

   { Other modes: BOOL, LONG INT, CHAR, REAL (32 bits, as Float). }
   proc (proc (string) bool, [] string) int count = nest Java "demo.Fns.count";
   puts (whole (count ((string w) bool: UPB w > 3, ("a", "algol", "java", "jvm")), 0) + "'n");
   proc ([] long int, long int, proc (long int, long int) long int) long int fold = nest Java "demo.Fns.fold";
   puts (whole (fold ((long 1, long 2, long 3, long 4), long 1, (long int a, b) long int: a * b), 0) + "'n");
   proc ([] bool, proc (bool) bool) bool any = nest Java "demo.Fns.any";
   puts ((any ((false, true), (bool b) bool: b) | "any" | "none") + "'n");
   proc (string, proc (char) char) string chars = nest Java "demo.Fns.chars";
   puts (chars ("algol", (char c) char: REPR (ABS c - 32)) + "'n");
   proc (proc (real) real) real half = nest Java "demo.Fns.half";
   puts (fixed (half ((real x) real: x / 2), 0, 2) + "'n");

   { The JDK: names of rows are copied to a Java array and back. }
   proc (ref [] string, proc (string, string) int) void sort_strings = nest Java "java.util.Arrays.sort";
   proc (ref [] int) void sort = nest Java "java.util.Arrays.sort";
   proc (ref [] int, proc (int) int) void set_all = nest Java "java.util.Arrays.setAll";
   proc (ref [] int, proc (int, int) int) void prefix = nest Java "java.util.Arrays.parallelPrefix";
   [5] string names := ("Wirth", "van Wijngaarden", "Lindsey", "Koster", "Mailloux");
   sort_strings (names, (string a, b) int: UPB a - UPB b);
   for i to UPB names do puts (names[i] + " ") od; puts ("'n");
   sort_strings (names, (string a, b) int: (a < b | -1 |: a > b | 1 | 0));
   for i to UPB names do puts (names[i] + " ") od; puts ("'n");
   [1:8] int a := (5, 3, 8, 1, 9, 2, 7, 4);
   sort (a[3:6]);
   for i to UPB a do puts (whole (a[i], 0) + " ") od; puts ("'n");
   sort (a);
   for i to UPB a do puts (whole (a[i], 0) + " ") od; puts ("'n");
   set_all (a, (int i) int: i * i);
   prefix (a, (int x, y) int: x + y);
   for i to UPB a do puts (whole (a[i], 0) + " ") od; puts ("'n");

   { Plain modes as Java objects: Integer, Double, Object. }
   proc (string) int parse = nest Java "java.lang.Integer.valueOf";
   proc (real) string str = nest Java "java.util.Objects.toString";
   proc (int, int) int max = nest Java "java.lang.Math.max";
   puts (whole (parse ("1234") + 1, 0) + " " + str (2.5) + " " + whole (max (3, 4), 0) + "'n")
end
