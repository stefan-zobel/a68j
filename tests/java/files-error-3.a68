{ The module Files: listing a file as a directory is a runtime error;
  get_directory of Algol 68 Genie gives no names instead. }
access Files (
   puts (whole (UPB get_directory ("tests/java/files-error-3.a68"), 0) + "'n");
   [] string names = list_directory ("tests/java/files-error-3.a68");
   puts (whole (UPB names, 0) + "'n")
)
