{ Rows and names of primitive modes that a68j keeps unboxed (int[] ...,
  IntCell ...), mixed with the boxed forms of the same modes: row displays,
  rows of structure fields, names of elements and fields passed around,
  directly called procedures and operators with and without frames. }
begin
    proc show = (string s) void: puts (s + "'n");
    proc w = (int i) string: whole (i, 0);

    { Generated rows (unboxed) and row displays (boxed) of the same mode. }
    [5] int a;
    for i to UPB a do a[i] := i * i od;
    [] int d = (10, 20, 30, 40, 50);
    [5] int c := d;
    a[2] +:= c[3];
    c[1] := a[2] + d[5];
    show (w (a[2]) + " " + w (c[1]) + " " + w (c[5]));

    { Names of elements: through a REF INT parameter, an identity, :=: }
    proc incr = (ref int x, int k) void: x +:= k;
    incr (a[1], 100);
    incr (c[2], 7);
    ref int e = a[3];
    e := e * 2;
    show (w (a[1]) + " " + w (c[2]) + " " + w (a[3]) + " "
          + (a[3] :=: e | "same" | "other") + " " + (a[4] :=: e | "same" | "other"));

    { Rows of REAL, BOOL, CHAR, LONG INT, BITS. }
    [3] real r; r[1] := 1.5; r[2] := r[1] * 2.0; r[3] +:= r[2];
    [4] bool b; b[2] := true; b[4] := NOT b[2];
    [3] char ch; ch[2] := "x";
    [2] long int l; l[1] := long_max_int; l[2] := l[1] OVER LENG 1000;
    [2] bits m; m[1] := 16r0f; m[2] := m[1] SHL 4;
    show (fixed (r[3], 0, 1) + " " + (b[2] | "T" | "F") + (b[4] | "T" | "F") + (b[1] | "T" | "F")
          + " [" + ch + "] " + whole (l[2], 0) + " " + w (ABS m[2]));

    { Slices, trims and copies keep the values. }
    [] int t = a[2:4];
    [3] int u := t;
    u[1] := -1;
    show (w (t[1]) + " " + w (u[1]) + " " + w (UPB t) + " " + w (a[2]));

    { Two-dimensional rows. }
    [3, 4] int g;
    for i to 3 do for j to 4 do g[i, j] := 10 * i + j od od;
    g[2, 3] +:= 1000;
    [] int row2 = g[2, ];
    show (w (g[2, 3]) + " " + w (row2[3]) + " " + w (g[3, 4]));

    { Structures: fields through names, rows of fields (boxed). }
    mode Point = struct (int x, real y, bool z);
    Point p := (1, 2.5, false);
    x of p := x of p + 41;
    y of p +:= 0.5;
    z of p := NOT z of p;
    ref int px = x of p;
    px +:= 1;
    [3] Point ps := ((1, 1.0, true), (2, 2.0, false), (3, 3.0, true));
    [] int xs = x of ps;
    x of ps[2] := 20;
    show (w (x of p) + " " + fixed (y of p, 0, 1) + " " + (z of p | "T" | "F") + " "
          + w (xs[2]) + " " + w ((x of ps)[2]));

    { Variables used by procedures (captured), changed by them. }
    int count := 0;
    real sum := 0.0;
    proc tally = (int k) void: (count +:= 1; sum +:= k);
    for k to 10 do tally (k) od;
    show (w (count) + " " + fixed (sum, 0, 1));

    { Directly called procedures and operators: recursion, frames, closures. }
    proc fib = (int n) int: (n < 2 | n | fib (n - 1) + fib (n - 2));
    op FACT = (int n) long int: (n < 2 | LENG 1 | LENG n * FACT (n - 1));
    int five = 5;
    proc (int) int add5 = (int j) int: j + five;
    proc twice = (proc (int) int f, int x) int: f (f (x));
    show (w (fib (20)) + " " + whole (FACT 20, 0) + " " + w (add5 (1)) + " " + w (twice (add5, 1))
          + " " + w (twice (fib, 6)));

    { A jump out of a procedure called directly. }
    proc check = (int v) int: (v > 3 | goto too_big | v * 10);
    int got := 0;
    for i to 10 do got := check (i) od;
too_big:
    show ("jumped at " + w (got));

    { Procedures as values called through a variable, and the same one directly. }
    begin
        proc (int) int f := fib;
        show (w (f (10)) + " " + w (fib (10)))
    end
end
