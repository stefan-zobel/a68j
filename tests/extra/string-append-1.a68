{ STRING +:= with spare room (a68j appends in place, Std.append_s_s): the
  old values, copies, slices and rows of strings keep their values, the
  bounds of the result are [1 : n], and s +:= s and s +:= s[i:j] read the
  string while it grows. }
begin
   string s := "";
   for i to 5000 do s +:= REPR (ABS "a" + i MOD 26) od;
   string t := "";
   for i to 3000 do t +:= whole (i MOD 10, 0) + "," od;
   string u := "ab";
   string old := u;
   [] char frozen = u;
   u +:= "c"; u +:= u; u +:= u[2:3];
   string v := u;
   u +:= "Z";
   v +:= "Y";
   u[1] := "q";
   puts (whole (UPB s, 0) + " " + s[4990:] + " " + whole (UPB t, 0) + " " + t[1:10] + "'n");
   puts (old + " " + frozen + " " + u + " " + v + "'n");
   [3] string names := ("a", "b", "c");
   for i to 3 do for j to i do names[i] +:= "+" od od;
   puts (names[1] + names[2] + names[3] + "'n");
   string w := "123456";
   string w2 := w[2:4];
   w2 +:= "x";
   puts (w2 + " " + w + " " + whole (LWB w2, 0) + "'n");
   string p := "ab";
   p +:= "";
   puts (p + whole (UPB p, 0) + "'n");
   flex [1:0] char f := "q";
   f +:= "r";
   f[1] := "Q";
   puts (f + "'n");
   string q := "xy";
   [1:3] char r := "abc";
   q +:= r; r[1] := "!"; q +:= r[1];
   puts (q + " " + r + "'n");
   proc grow = (ref string x, int n) void: for i to n do x +:= "-" od;
   string g := "g"; grow (g, 10); string g2 := g; grow (g, 2); grow (g2, 1);
   puts (g + " " + g2 + "'n");
   string z := "z";
   string z1 = z + "1";
   z +:= "2";
   puts (z1 + " " + z + "'n")
end
