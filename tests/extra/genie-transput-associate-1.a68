{ dg-modules "genietransput" }
{ associate in the bundled module Genie_Transput (backend/lib/genietransput.a68):
  get and put on a string instead of a file.  Measured against Algol 68
  Genie 3.1.2, which gives the same output except for the widths of the
  numbers (ga68 has 32-bit ints and reals) and the text of the last error
  (Algol 68 Genie adds its position).  The first put empties the string,
  later puts append to the string it holds then; reading keeps its
  position when the string is changed; at the end of the string the
  first char read is REPR 0 without an event.  The last statement ends
  the program with a transput error, so the exit status is 1. }
access Genie_Transput (
begin
  proc show = (string label, string s) void:
     begin print ((label, " ["));
           for k to UPB s
           do char c = s[k];
              if c = REPR 10 then print ("\n") elif c = REPR 12 then print ("\f") else print (c) fi
           od;
           print (("]", newline))
     end;
  { 1: numbers from a string, then written back after reset }
  string s := "12345 678"; File f; int i, j;
  associate (f, s); get (f, (i, j));
  print (("1 ", whole (i, 0), " ", whole (j, 0), newline));
  s := ""; reset (f); put (f, (whole (i + 1, 0), " x", true, "c"));
  show ("1", s);
  put (f, (newline, "after", newpage, "end"));
  show ("1", s);
  { 2: the first put empties the string, later puts append to it }
  string t := "abc"; File g; associate (g, t); put (g, "X"); show ("2", t);
  t := "Q"; put (g, "Z"); show ("2", t);
  reset (g); put (g, "Y"); show ("2", t);
  reset (g); string r; get (g, r); show ("2", r);
  { 3: lines }
  string v := "a" + REPR 10 + "bc" + REPR 10 + "d"; File k; associate (k, v);
  char c1, c2, c3; get (k, (c1, c2, c3)); print (("3 ", c1, c2, c3, newline));
  string w; reset (k); get (k, w); show ("3", w);
  get (k, (newline, w)); show ("3", w);
  print (("3 eoln ", eoln (k), " eof ", eof (k), newline));
  get (k, (newline, w)); show ("3", w);
  bool e3 = eof (k); bool l3 = eoln (k); print (("3 eof ", e3, " eoln ", l3, newline));
  { 4: the terminator }
  string y := "12,34;56"; File m; associate (m, y); make_term (m, ",;");
  string p, q; char sep; get (m, (p, sep, q));
  show ("4", p); print (("4 ", sep, newline)); show ("4", q);
  { 5: the position stays when the string is changed }
  string u := "12 34"; File n; associate (n, u); get (n, i); u := "99 77 55"; get (n, j);
  print (("5 ", whole (i, 0), " ", whole (j, 0), newline));
  { 6: reals and booleans }
  string z := "  -7.25e1T"; File o; associate (o, z); real x; bool b; get (o, (x, b));
  print (("6 ", fixed (x, 0, 2), " ", b, newline));
  { 7: events }
  string e := "5 x"; File h; associate (h, e); int n7 := -1;
  on_value_error (h, (ref File ff) bool: (print (("7 value error", newline)); true));
  on_logical_file_end (h, (ref File ff) bool: (print (("7 file end", newline)); true));
  get (h, n7); print (("7 ", whole (n7, 0), newline));
  get (h, n7); print (("7 ", whole (n7, 0), newline));
  string rest := "rest"; get (h, rest); show ("7", rest);
  string e2 := ""; File h2; associate (h2, e2);
  on_logical_file_end (h2, (ref File ff) bool: (print (("7 file end", newline)); true));
  get (h2, n7); print (("7 ", whole (n7, 0), newline));
  string e4 := ""; File h3; associate (h3, e4);
  on_logical_file_end (h3, (ref File ff) bool: (print (("7 file end", newline)); true));
  char c7 := "q"; get (h3, c7); print (("7 char ", whole (ABS c7, 0), newline));
  string s7 := "s"; reset (h3); get (h3, s7); show ("7", s7);
  { 8: put in read mood }
  string a := "abc"; File d; associate (d, a); char c; get (d, c); print (("8 ", c, newline));
  put (d, "Z")
end
)
