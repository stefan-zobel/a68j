{ OVER, MOD, % and %* and the assigning operators %:=, %*:=, OVERAB and
  MODAB with a positive constant divisor, which a68j compiles without the
  checks for 0 and -1 (Intrinsics#constantDivision): the same results as
  with ga68 for negative operands, the most negative INT, a divisor of
  max int, LONG INT, SHORT INT, elements of rows and direct variables. }
begin
  proc p = (int x) void: puts (whole (x, 0) + " ");
  proc pl = (long int x) void: puts (whole (x, 0) + " ");
  [] int xs = (-2147483647 - 1, -2147483647, -1000, -7, -6, -1, 0, 1, 6, 7, 1000, 2147483647);
  for i to UPB xs do
    int a = xs[i];
    p (a OVER 1); p (a MOD 1); p (a OVER 7); p (a MOD 7); p (a % 3); p (a %* 3);
    p (a OVER 2147483647); p (a MOD 2147483647); p (a MOD 1000003);
    int b := a; b %:= 7; p (b); b := a; b %*:= 7; p (b);
    b := a; b OVERAB 5; p (b); b := a; b MODAB 5; p (b);
    [3] int r := (a, a, a); r[2] %*:= 7; p (r[2]); r[3] %:= 7; p (r[3]);
    long int la = LENG a * long 3;
    pl (la OVER long 7); pl (la MOD long 7); pl (la MOD long 9223372036854775807);
    long int lb := la; lb %*:= long 7; pl (lb); lb := la; lb %:= long 7; pl (lb);
    short int sa = SHORTEN (a MOD 30000); p (LENG (sa % short 7)); p (LENG (sa MOD short 7));
    puts ("'n")
  od
end
