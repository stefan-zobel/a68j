{ Copy of book/examples/appG/power.a68, an example of partial
  parametrization in appendix G of the book "Algol 68 in Modern Terms". }
access Genie_Transput
begin
   mode Fn = proc (real) real;
   proc iterate = (Fn f, int n, real x) real:
   begin
      real y := x;
      to n do y := f (y) od;
      y
   end;
   prio ^ = 8;
   op ^ = (Fn f, int n) Fn: iterate (f, n, );
   proc half = (real x) real: x / 2;
   print ((fixed ((half ^ 3) (1), 0, 3), " ", fixed ((cos ^ 20) (1), 0, 6), newline))
end
