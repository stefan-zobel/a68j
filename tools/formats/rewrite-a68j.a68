# rewrite-a68j.a68 - the format rewrite tool on a68j and ga68 (UPPER
  stropping):

      java -jar a68j-backend.jar -fstropping=upper -I tools/formats \
           -run tools/formats/rewrite-a68j.a68 [--upper | --supper] [--ga68] [--no-wrap] < in > out

  The tool itself is the included file rewrite.a68; this prologue provides
  its input, options and error handling through the module Genie_Transput,
  and writes the result. #
ACCESS GENIE_TRANSPUT
BEGIN
   PROC next line = (REF STRING line) BOOL:
      IF eof (stand in)
      THEN FALSE
      ELSE line := "";
           IF NOT eoln (stand in) THEN read (line) FI;
           IF NOT eof (stand in) THEN read (newline) FI;
           TRUE
      FI;

   [] STRING options =
      BEGIN
         [argc - 1] STRING o;
         FOR i FROM 2 TO argc DO o[i - 1] := argv (i) OD;
         o
      END;

   PROC fail = (INT line, STRING msg) VOID:
      BEGIN
         put (stand error, ("rewrite: ", IF line > 0 THEN "line " + whole (line, 0) + ": " ELSE "" FI,
                            msg, newline));
         posix exit (1)
      END;

   PR include "rewrite.a68" PR;

   INT line start := 1;
   FOR k FROM 1 TO UPB rewritten
   DO IF rewritten[k] = REPR 10
      THEN STRING line = rewritten[line start : k - 1];
           print ((line, newline));
           line start := k + 1
      FI
   OD;
   IF line start <= UPB rewritten
   THEN STRING line = rewritten[line start : UPB rewritten];
        print (line)
   FI
END
