{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Algol 68 (SUPPER)",
  "scopeName": "source.algol68",
  "fileTypes": [
    "a68"
  ],
  "comment": "Generated by a68j/tools/gen_tmlanguage.py - do not edit by hand. GNU Algol 68 (ga68) in SUPPER stropping.",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#pragmat"
    },
    {
      "include": "#string"
    },
    {
      "include": "#format"
    },
    {
      "include": "#number"
    },
    {
      "include": "#module"
    },
    {
      "include": "#mixed"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#label"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#standard"
    },
    {
      "include": "#bold"
    },
    {
      "include": "#identifier"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "comment": "{ ... } is the only comment in SUPPER; nestable, a \"...\" inside it is skipped (Scanner.pragment).",
      "name": "comment.block.algol68",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.algol68"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.algol68"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "comment": "a string in a comment: a } inside it does not count",
          "begin": "\"",
          "end": "\"",
          "name": "comment.block.string.algol68"
        },
        {
          "match": "\\b(?:TODO|FIXME|XXX)\\b",
          "name": "keyword.other.todo.algol68"
        }
      ]
    },
    "pragmat": {
      "comment": "[[ ... ]] is the only pragmat in SUPPER (GNU).",
      "name": "meta.preprocessor.pragmat.algol68",
      "begin": "\\[\\[",
      "end": "\\]\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.pragmat.begin.algol68"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.pragmat.end.algol68"
        }
      },
      "patterns": [
        {
          "match": "\\b(?:include|access|in)\\b",
          "name": "keyword.control.directive.algol68"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.algol68"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.algol68"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.algol68",
      "begin": "\"",
      "end": "\"(?!\")",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.algol68"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.algol68"
        }
      },
      "patterns": [
        {
          "match": "\"\"",
          "name": "constant.character.escape.quote.algol68"
        },
        {
          "match": "'[nfrt']",
          "name": "constant.character.escape.algol68"
        },
        {
          "comment": "characters by their code: '(u00e4, U0001F600)",
          "match": "'\\(\\s*[uU][0-9A-Fa-f]+(?:\\s*,\\s*[uU][0-9A-Fa-f]+)*\\s*\\)",
          "name": "constant.character.escape.unicode.algol68"
        },
        {
          "match": "'.?",
          "name": "invalid.illegal.escape.algol68"
        }
      ]
    },
    "format": {
      "comment": "format text $...$ (split by ga68, but not compiled)",
      "name": "meta.format.algol68",
      "begin": "\\$",
      "end": "\\$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.format.begin.algol68"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.format.end.algol68"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "match": "\\d+",
          "name": "constant.numeric.format.algol68"
        },
        {
          "match": "[A-Za-z]",
          "name": "constant.other.format-item.algol68"
        },
        {
          "match": "[(),]",
          "name": "punctuation.format.algol68"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "comment": "bits denotation: radix 2, 4, 8, 10 (GNU) or 16",
          "match": "\\b(?:2[ \\t]*r[ \\t]*[01](?:[ \\t]*[01])*|4[ \\t]*r[ \\t]*[0-3](?:[ \\t]*[0-3])*|8[ \\t]*r[ \\t]*[0-7](?:[ \\t]*[0-7])*|10[ \\t]*r[ \\t]*[0-9](?:[ \\t]*[0-9])*|16[ \\t]*r[ \\t]*[0-9a-f]+)(?![0-9A-Za-z_])",
          "name": "constant.numeric.bits.algol68"
        },
        {
          "comment": "a wrong digit for the radix (2r03, 16rfg) or a wrong radix",
          "match": "\\b\\d+[ \\t]*r[ \\t]*[0-9A-Za-z_]+",
          "name": "invalid.illegal.bits.algol68"
        },
        {
          "comment": "1.5, 1 .5, .5, 1e3, 1.e3, 1.5e-3 (also with spaces)",
          "match": "(?<![\\w.])(?:\\d(?:[ \\t]*\\d)*[ \\t]*\\.[ \\t]*\\d(?:[ \\t]*\\d)*(?:[ \\t]*[eE][ \\t]*[+-]?[ \\t]*\\d(?:[ \\t]*\\d)*)?|\\d(?:[ \\t]*\\d)*(?:[ \\t]*\\.)?[ \\t]*[eE][ \\t]*[+-]?[ \\t]*\\d(?:[ \\t]*\\d)*|\\.[ \\t]*\\d(?:[ \\t]*\\d)*(?:[ \\t]*[eE][ \\t]*[+-]?[ \\t]*\\d(?:[ \\t]*\\d)*)?)",
          "name": "constant.numeric.real.algol68"
        },
        {
          "match": "\\b\\d(?:[ \\t]*\\d)*\\b",
          "name": "constant.numeric.integer.algol68"
        }
      ]
    },
    "module": {
      "patterns": [
        {
          "comment": "module Name = ...",
          "match": "\\b(module)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.module.algol68"
            },
            "2": {
              "name": "entity.name.namespace.algol68"
            }
          }
        },
        {
          "comment": "access [pub] A, [pub] B",
          "match": "\\b(access)\\s+((?:pub\\s+)?[A-Z][A-Za-z0-9_]*(?:\\s*,\\s*(?:pub\\s+)?[A-Z][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.algol68"
            },
            "2": {
              "patterns": [
                {
                  "match": "\\bpub\\b",
                  "name": "storage.modifier.pub.algol68"
                },
                {
                  "match": "[A-Z][A-Za-z0-9_]*",
                  "name": "entity.name.namespace.algol68"
                },
                {
                  "match": ",",
                  "name": "punctuation.separator.comma.algol68"
                }
              ]
            }
          }
        },
        {
          "match": "\\baccess\\b",
          "name": "keyword.control.import.algol68"
        },
        {
          "match": "\\bpub\\b",
          "name": "storage.modifier.pub.algol68"
        },
        {
          "comment": "formal hole: nest C \"name\", nest Java \"Class.method\"",
          "match": "\\b(nest)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.nest.algol68"
            },
            "2": {
              "name": "support.constant.formal-hole.language.algol68"
            }
          }
        },
        {
          "match": "\\bnest\\b",
          "name": "keyword.other.nest.algol68"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "comment": "mode Name = ...",
          "match": "\\b(mode)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "storage.type.mode.algol68"
            },
            "2": {
              "name": "entity.name.type.algol68"
            }
          }
        },
        {
          "comment": "op NAME = ..., op + = ..., op +:= = ...",
          "match": "\\b(op)\\s+([A-Z][A-Za-z0-9_]*|[-+*/%^&~<>=!?]+(?::=|=:)?)(?=\\s*:?=)",
          "captures": {
            "1": {
              "name": "storage.type.op.algol68"
            },
            "2": {
              "name": "entity.name.function.operator.algol68"
            }
          }
        },
        {
          "comment": "proc name = ... and proc name := ...",
          "match": "\\b(proc)\\s+((?!\\b(?:postlude|channel|access|assert|module|string|struct|andth|begin|bytes|compl|empty|false|short|union|while|bits|bool|case|char|elif|else|esac|exit|file|flex|from|goto|heap|isnt|long|mode|nest|orel|ouse|prio|proc|real|sema|skip|then|true|void|word|def|egg|end|fed|for|int|loc|nil|out|par|pub|ref|at|by|do|fi|go|if|in|is|od|of|op|to)\\b)[a-z][a-z0-9_]*)(?=\\s*:?=)",
          "captures": {
            "1": {
              "name": "storage.type.proc.algol68"
            },
            "2": {
              "name": "entity.name.function.algol68"
            }
          }
        },
        {
          "comment": "name = (int a) int: ... (a routine text, e.g. after proc (int) int)",
          "match": "\\b((?!\\b(?:postlude|channel|access|assert|module|string|struct|andth|begin|bytes|compl|empty|false|short|union|while|bits|bool|case|char|elif|else|esac|exit|file|flex|from|goto|heap|isnt|long|mode|nest|orel|ouse|prio|proc|real|sema|skip|then|true|void|word|def|egg|end|fed|for|int|loc|nil|out|par|pub|ref|at|by|do|fi|go|if|in|is|od|of|op|to)\\b)[a-z][a-z0-9_]*)(?=\\s*=(?!=)\\s*(?>\\s*\\([^()]*+\\))?(?>\\s*+(?:(?:int|real|bool|char|string|void|bits|bytes|compl|sema|file|channel|ref|flex|heap|loc|long|short|struct|union|proc)\\b|\\[[^\\]]*+\\]|[A-Z][A-Za-z0-9_]*+))*+\\s*:(?!=))",
          "captures": {
            "1": {
              "name": "entity.name.function.algol68"
            }
          }
        }
      ]
    },
    "label": {
      "patterns": [
        {
          "comment": "a label at the start of a line or after ';': stop: skip",
          "match": "(?:^|(?<=;))\\s*((?!\\b(?:postlude|channel|access|assert|module|string|struct|andth|begin|bytes|compl|empty|false|short|union|while|bits|bool|case|char|elif|else|esac|exit|file|flex|from|goto|heap|isnt|long|mode|nest|orel|ouse|prio|proc|real|sema|skip|then|true|void|word|def|egg|end|fed|for|int|loc|nil|out|par|pub|ref|at|by|do|fi|go|if|in|is|od|of|op|to)\\b)[a-z][a-z0-9_]*)\\s*(:)(?![=/])",
          "captures": {
            "1": {
              "name": "entity.name.label.algol68"
            },
            "2": {
              "name": "punctuation.separator.label.algol68"
            }
          }
        },
        {
          "match": "\\b(goto|go\\s+to)\\s+((?!\\b(?:postlude|channel|access|assert|module|string|struct|andth|begin|bytes|compl|empty|false|short|union|while|bits|bool|case|char|elif|else|esac|exit|file|flex|from|goto|heap|isnt|long|mode|nest|orel|ouse|prio|proc|real|sema|skip|then|true|void|word|def|egg|end|fed|for|int|loc|nil|out|par|pub|ref|at|by|do|fi|go|if|in|is|od|of|op|to)\\b)[a-z][a-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.goto.algol68"
            },
            "2": {
              "name": "entity.name.label.algol68"
            }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(?:assert|begin|while|case|elif|else|esac|exit|from|goto|ouse|then|end|for|out|par|by|do|fi|go|if|in|od|to)\\b",
          "name": "keyword.control.algol68"
        },
        {
          "match": "\\b(?:postlude|module|def|egg|fed)\\b",
          "name": "keyword.other.module.algol68"
        },
        {
          "match": "\\b(?:mode|prio|proc|op)\\b",
          "name": "storage.type.declaration.algol68"
        },
        {
          "match": "\\b(?:channel|string|bytes|compl|bits|bool|char|file|real|sema|void|int)\\b",
          "name": "storage.type.primitive.algol68"
        },
        {
          "match": "\\b(?:struct|short|union|flex|heap|long|word|loc|ref)\\b",
          "name": "storage.modifier.algol68"
        },
        {
          "match": "\\b(?:empty|false|skip|true|nil)\\b",
          "name": "constant.language.algol68"
        },
        {
          "match": "\\b(?:andth|isnt|orel|at|is|of)\\b",
          "name": "keyword.operator.wordlike.algol68"
        }
      ]
    },
    "standard": {
      "patterns": [
        {
          "match": "\\b(?:(?:long|short|word)_?)*(?:minus_?infinity|bytes_?width|bits_?width|real_?width|small_?real|exp_?width|int_?width|infinity|max_?bits|max_?real|min_?real|max_?int|min_?int|pi)\\b",
          "name": "support.constant.algol68"
        },
        {
          "match": "\\b(?:(?:long|short|word)_?)*(?:string_?to_?real|next_?random|bytes_?pack|bits_?pack|arccos|arcsin|arctan|random|sqrt|cos|exp|log|sin|tan|ln)\\b",
          "name": "support.function.algol68"
        },
        {
          "match": "\\b(?:replacement_?char|file_?o_?default|null_?character|bytes_?lengths|bytes_?shorths|compl_?lengths|compl_?shorths|file_?o_?rdonly|file_?o_?wronly|bits_?lengths|bits_?shorths|file_?o_?trunc|max_?abs_?char|real_?lengths|real_?shorths|file_?o_?rdwr|int_?lengths|int_?shorths|error_?char|eof_?char|seek_?cur|seek_?end|seek_?set|stderr|stdout|blank|stdin|flip|flop)\\b",
          "name": "support.constant.algol68"
        },
        {
          "match": "\\b(?:char_?in_?string|first_?random|posix_?exit|fconnect|strerror|fcreate|getchar|putchar|fclose|getenv|perror|errno|fgetc|fgets|fixed|float|fopen|fputc|fputs|fsize|lseek|print|whole|argc|argv|gets|puts|read|get|put|rnd)\\b",
          "name": "support.function.algol68"
        }
      ]
    },
    "bold": {
      "patterns": [
        {
          "match": "\\b(?:MINUSAB|SHORTEN|TIMESAB|ENTIER|OVERAB|PLUSAB|PLUSTO|CLEAR|DIVAB|ELEMS|FLOOR|LEVEL|MODAB|ROUND|CONJ|DOWN|ELEM|LENG|OVER|REPR|SIGN|TEST|ABS|AND|ARG|BIN|LWB|MOD|NOT|ODD|SET|SHL|SHR|UPB|XOR|EQ|GE|GT|IM|LE|LT|NE|OR|RE|UP|I)\\b",
          "name": "support.function.operator.algol68"
        },
        {
          "comment": "capitals, digits and _ only (at least two characters): operator",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b",
          "name": "entity.name.function.operator.algol68"
        },
        {
          "comment": "otherwise: mode indicant (Int_list, Node, F)",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name": "entity.name.type.algol68"
        }
      ]
    },
    "mixed": {
      "comment": "an identifier that runs into a bold word (foo_Bar, fooBar): in SUPPER two tokens and almost always a mistake",
      "match": "\\b[a-z][a-z0-9_]*[A-Z][A-Za-z0-9_]*\\b",
      "name": "invalid.illegal.mixed-tag.algol68"
    },
    "identifier": {
      "comment": "Ordinary identifiers stay without color, but are consumed as a whole, so that no part of them counts as a number or the like.",
      "match": "\\b[a-z][a-z0-9_]*\\b",
      "name": "variable.other.algol68"
    },
    "operator": {
      "patterns": [
        {
          "match": ":/=:|:=:",
          "name": "keyword.operator.identity.algol68"
        },
        {
          "comment": "+:=, -:=, *:=, /:=, %:=, %*:= and +=: (PLUSTO)",
          "match": "[-+*/%^&~<>=!?]+(?::=|=:)",
          "name": "keyword.operator.assignment.compound.algol68"
        },
        {
          "match": ":=",
          "name": "keyword.operator.assignment.algol68"
        },
        {
          "match": "=:",
          "name": "keyword.operator.assignment.algol68"
        },
        {
          "match": "[-+*/%^&~<>=!?]+",
          "name": "keyword.operator.algol68"
        },
        {
          "match": "@",
          "name": "keyword.operator.at.algol68"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "comment": "characters that ga68 rejects outside strings and comments (unworthy character), e.g. ×, ¬, ≠, \\ and `",
          "match": "[^\\x00-\\x7F]|[\\\\`]",
          "name": "invalid.illegal.unworthy.algol68"
        },
        {
          "match": "\\|:|\\|",
          "name": "keyword.control.brief.algol68"
        },
        {
          "match": ";",
          "name": "punctuation.separator.semicolon.algol68"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.algol68"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.algol68"
        },
        {
          "match": "[()]",
          "name": "punctuation.parenthesis.algol68"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.brackets.algol68"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.algol68"
        }
      ]
    }
  }
}
