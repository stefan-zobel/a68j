{
  "comments": {
    "blockComment": ["{", "}"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["begin", "end"],
    ["if", "fi"],
    ["case", "esac"],
    ["do", "od"],
    ["def", "fed"]
  ],
  "colorizedBracketPairs": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z][A-Za-z0-9_]*|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\b(begin|then|else|elif|do|in|out|ouse|def)\\b(?!.*\\b(end|fi|od|esac|fed)\\b)[^{}]*$",
    "decreaseIndentPattern": "^\\s*(end|fi|od|esac|fed|else|elif|then|in|out|ouse)\\b"
  }
}
